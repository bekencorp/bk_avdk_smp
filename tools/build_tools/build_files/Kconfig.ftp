# Shared by ap/components/app/Kconfig and cp/components/app/Kconfig.
# Both FTP daemons read CONFIG_FTP_USER / CONFIG_FTP_PASSWORD.
# Defaults stay empty so a build that enables FTP still fails closed.

config FTP_USER
	string "FTP username"
	depends on FTP_SERVER || FTPD_UPGRADE
	default ""
	help
		Login name required by the FTP server. An empty value rejects
		every USER command with 530. Set this explicitly when enabling
		the server; there is no built-in account.

config FTP_PASSWORD
	string "FTP password"
	depends on FTP_SERVER || FTPD_UPGRADE
	default ""
	help
		Password required by the FTP server. An empty value rejects
		every PASS command with 530. Do not rely on a default password.
