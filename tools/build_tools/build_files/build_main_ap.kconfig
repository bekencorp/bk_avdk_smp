#TODO add full ARMINO Kconfig

mainmenu "Armino SDK $(ARMINO_SOC) Configuration"

	menu "Build & Target"
		# Don't modify the default value directly!
		# modify middleware/soc/bkxxx/bkxxx.defconfig,
		# or modify it in per-project bkxxx.config
		# config TOOLCHAIN_PATH
		# string "Toolchain absolute path"
		# default "/opt/gcc-arm-none-eabi-10.3-2021.10/bin"

		# config TOOLCHAIN_PREFIX
		# string "Toolchain prefix"
		# default "arm-none-eabi-"

		config OBJDUMP
			bool "whether Objdump -d elf to lst or not"
			default y

		choice BUILD_VERSION
			prompt "Select Build version"
			default BUILD_DEFAULT_VERSION

			config BUILD_DEFAULT_VERSION
				bool "Use default build version"
				help
					build version depend on sdk, it's DEBUG in developer environment, RELEASE in customer environment.

			config DEBUG_VERSION
				bool "Use debug build version"
				help
					set debug build version

			config RELEASE_VERSION
				bool "Use release build version"
				help
					set release build version
		endchoice

		config ALL_CODE_IN_PSRAM
			bool "Place all code in PSRAM"
			default n
			depends on PSRAM
			help
				Place normal text and read-only data sections in PSRAM.

		choice STACK_CHECK_MODE
			prompt "Compile stack check mode"
			default COMPILER_STACK_CHECK_MODE_NORM

			config COMPILER_STACK_CHECK_MODE_NORM
				bool "Add compile option: -fstack-protector"

			config COMPILER_STACK_CHECK_MODE_STRONG
				bool "Add compile option: -fstack-protector-strong"

			config COMPILER_STACK_CHECK_MODE_ALL
				bool "Add compile option: -fstack-protector-all"

		endchoice
	endmenu

	menu "Board & SoC"
		menu "SoC Configuration"
			source "${ARMINO_PATH}/middleware/soc/Kconfig"
			source "${ARMINO_PATH}/middleware/soc/${ARMINO_SOC}/Kconfig"
		endmenu

		menu "Architecture"
			source "${ARMINO_PATH}/middleware/arch/core/Kconfig"
			source "${ARMINO_PATH}/middleware/arch/cortex-m/Kconfig"
			source "${ARMINO_PATH}/middleware/arch/mpu/Kconfig"
			source "$BOARD_SOC_KCONFIGS_SOURCE_FILE"
		endmenu
	endmenu

	menu "RTOS & Kernel"
		source "$OPERATING_SYSTEM_KCONFIGS_SOURCE_FILE"
	endmenu

	menu "System Services"
		source "$SYSTEM_SERVICES_KCONFIGS_SOURCE_FILE"
		source "${ARMINO_PATH}/middleware/compal/Kconfig"
	endmenu

	menu "Device Drivers"
		source "${ARMINO_PATH}/middleware/driver/Kconfig"
		source "$DEVICE_DRIVERS_KCONFIGS_SOURCE_FILE"
	endmenu

	menu "Wireless Connectivity"
		config WIFI_SENSOR
			bool "Enable WiFi sensor"
			default n

		config BLUETOOTH
			bool "Enable Bluetooth"
			default y

		source "$WIRELESS_CONNECTIVITY_KCONFIGS_SOURCE_FILE"
	endmenu

	menu "Network Services"
		config LWIP
			depends on WIFI_ENABLE
			bool "Enable LWIP"
			default y

		choice LWIP
			depends on LWIP
			prompt "LWIP Version"
			default LWIP_V2_1

			config LWIP_V2_0
				depends on LWIP
				bool "LWIP 2.0.2"
			config LWIP_V2_1
				depends on LWIP
				bool "LWIP 2.1.2"
		endchoice

		choice HOST
			prompt "Hosted Mode"
			default NO_HOSTED

			config NO_HOSTED
				bool "Disable Hosted"
			config SEMI_HOSTED
				bool "Semi Hosted"
			config FULLY_HOSTED
				bool "Fully Hosted"
		endchoice

		source "$NETWORK_SERVICES_KCONFIGS_SOURCE_FILE"
	endmenu


	# Auto-generated functional component groups. This gives users direct
	# feature-oriented entries such as Network, Multimedia, Storage, and Debug.
	source "$GROUP_KCONFIGS_INDEX_FILE"

	menu "Debug"
		choice ASSERT
			prompt "Assert options"
			default ASSERT_REBOOT

			config ASSERT_IGNORE
				bool "Ignore Assert"
			config ASSERT_HALT
				bool "Assert halts the system"
			config ASSERT_REBOOT
				bool "Assert reboots the system"
		endchoice

		config JTAG
			bool "Enable JTAG"
			default n

		config SWD_DEBUG_MODE
			bool "Enable SWD Debug Mode"
			default n
			help
				Enable SWD Debug Modules

		config SWD_DEBUG_MODE_PIN_CLK
			int "SWD SWCLK GPIO id"
			depends on SWD_DEBUG_MODE
			default 20
			help
				GPIO id routed to SWCLK when SWD debug mode is entered.
				Customer overridable; defaults to the hardware default GPIO20.

		config SWD_DEBUG_MODE_PIN_DIO
			int "SWD SWDIO GPIO id"
			depends on SWD_DEBUG_MODE
			default 21
			help
				GPIO id routed to SWDIO when SWD debug mode is entered.
				Customer overridable; defaults to the hardware default GPIO21.

		source "$DEBUG_KCONFIGS_SOURCE_FILE"
	endmenu

	menu "Demos"
		source "$DEMOS_KCONFIGS_SOURCE_FILE"
	endmenu

	menu "Third Party"
		source "$THIRD_PARTY_KCONFIGS_SOURCE_FILE"
	endmenu

	# Keep raw fallback sources parsed for defconfig compatibility, without
	# exposing a separate "Advanced Raw Configuration" top-level menu.
	source "$COMPONENTS_KCONFIGS_SOURCE_FILE"
	source "$PROJECTS_KCONFIGS_SOURCE_FILE"
	source "$PROPERTIES_KCONFIGS_SOURCE_FILE"
	source "$EXTRA_KCONFIGS_SOURCE_FILE"

	source "$COMPONENT_KCONFIGS_PROJBUILD_SOURCE_FILE"
