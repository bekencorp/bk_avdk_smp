menu "QSPI"
	config QSPI
		bool "Enable QSPI"
		default n

	config QSPI_STATIS
		bool "Enable QSPI Statis"
		default y

	config QSPI_FLASH
		bool "Enable QSPI Flash"
		depends on QSPI
		default n

	config QSPI_FLASH_GD
		bool "Enable GD Flash"
		default n

	config QSPI_TEST
		depends on QSPI && DRIVER_TEST
		bool "Enable qspi test"
		default n
endmenu

