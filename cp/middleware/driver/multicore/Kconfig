menu "multicore"
	config SUPPORT_MULTICORE
		bool "Enable multicore"
		default n

	config MULTICORE_TEST
		depends on SUPPORT_MULTICORE && DRIVER_TEST
		bool "Enable multicore test"
		default n

	config CPU_HOTPLUG
		depends on SUPPORT_MULTICORE && SOC_SMP
		bool "Enable CPU Hotplug"
		default y

	config CPU_HOTPLUG_BOOT_OFFLINE
		depends on CPU_HOTPLUG
		bool "Keep secondary hotplug CPU offline at power-on (online via cpu online <id>)"
		default y

endmenu
