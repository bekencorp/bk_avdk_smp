#!/usr/bin/env python3
#
# Secure firmware packer for bk7258: signs (EC-P256) and XTS-AES encrypts the
# merged primary_all (CP + AP) image plus the BL2 manifest, then assembles the
# flash images through beken_utils. No TF-M secure runtime is involved: BL2 is
# the only bootloader component and there is no tfm_s image.

import os
import subprocess
import sys
import logging
import shutil

import click

armino_path = os.getenv("ARMINO_PATH")
project_dir = os.getenv("PROJECT_DIR")
project_name = os.getenv("PROJECT")
armino_soc = os.getenv("ARMINO_SOC")
build_path = os.path.realpath('.')
armino_avdk_path = os.getenv("ARMINO_AVDK_DIR") or armino_path


def resolve_project_dir():
    candidates = []
    if project_dir:
        candidates.append(project_dir)
        candidates.append(os.path.join(armino_path, project_dir))
        candidates.append(os.path.join(os.path.dirname(armino_path), project_dir))
    for c in candidates:
        if c and os.path.isdir(c):
            return os.path.realpath(c)
    return os.path.realpath(project_dir) if project_dir else None


project_abs_dir = resolve_project_dir()


def run_cmd(cmd):
    p = subprocess.Popen(cmd, shell=True)
    ret = p.wait()
    if ret:
        logging.error(f'failed to run "{cmd}"')
        exit(1)


def copy_files(postfix, src_dir, dst_dir):
    if not os.path.exists(src_dir):
        return
    for f in os.listdir(src_dir):
        if f.endswith(postfix):
            shutil.copy(f'{src_dir}/{f}', f'{dst_dir}/{f}')


def install_configs(cfg_dir, install_dir):
    if not os.path.exists(cfg_dir):
        return
    copy_files('.bin', cfg_dir, install_dir)
    copy_files('.json', cfg_dir, install_dir)
    copy_files('.pem', cfg_dir, install_dir)
    copy_files('.csv', cfg_dir, install_dir)
    if os.path.exists(f'{cfg_dir}/key'):
        copy_files('.pem', f'{cfg_dir}/key', install_dir)
    if os.path.exists(f'{cfg_dir}/csv'):
        copy_files('.csv', f'{cfg_dir}/csv', install_dir)
    if os.path.exists(f'{cfg_dir}/regs'):
        copy_files('.csv', f'{cfg_dir}/regs', install_dir)


def copy_file(src, dst):
    if os.path.exists(src):
        shutil.copy(src, dst)


def move_file(bin_name, src_dir, dst_dir):
    src = f'{src_dir}/{bin_name}'
    if os.path.exists(src):
        if os.path.exists(dst_dir):
            shutil.copy2(src, dst_dir)
        else:
            shutil.move(src, dst_dir)


def pack(prebuild):
    soc = armino_soc
    tools_dir = f'{armino_avdk_path}/tools/env_tools'
    bin_dir = build_path
    base_cfg_dir = f'{armino_path}/middleware/boards/{soc}'
    prefered_cfg_dir = os.path.join(project_abs_dir, 'config')
    project_partitions_cfg_dir = os.path.join(project_abs_dir, 'partitions', soc)

    logging.basicConfig()
    logging.getLogger().setLevel(logging.DEBUG)

    BK_UTILS_TOOL = f'{tools_dir}/beken_utils/main.py'

    CMAKE_BIN_DIR = bin_dir
    CMAKE_INSTALL_DIR = f'{CMAKE_BIN_DIR}/install'
    _BUILD_DIR = f'{bin_dir}/_build'

    os.makedirs(_BUILD_DIR, exist_ok=True)
    saved_cur_dir = os.getcwd()
    os.chdir(_BUILD_DIR)

    install_configs(base_cfg_dir, _BUILD_DIR)
    install_configs(prefered_cfg_dir, _BUILD_DIR)
    install_configs(f'{prefered_cfg_dir}/key', _BUILD_DIR)
    install_configs(project_partitions_cfg_dir, _BUILD_DIR)
    # security.csv / ota.csv / pack.json define the signing + encryption policy;
    # copy them last so prebuild and final packing use the same configuration.
    copy_file(f'{project_partitions_cfg_dir}/security.csv', f'{_BUILD_DIR}/security.csv')
    copy_file(f'{project_partitions_cfg_dir}/ota.csv', f'{_BUILD_DIR}/ota.csv')
    copy_file(f'{project_partitions_cfg_dir}/pack.json', f'{_BUILD_DIR}/pack.json')

    if prebuild:
        run_cmd(f'{BK_UTILS_TOOL} gen all --debug')
        cwd = os.getcwd()
        copy_file(f'{cwd}/partitions_partition.h', f'{cwd}/partitions_gen.h')
        os.chdir(saved_cur_dir)
        return

    # The SMP auto-partition step generates partitions.csv into the shared
    # {build}/../partitions dir; the secure pack runs in _build and needs it here.
    partitions_gen_dir = os.path.realpath(f'{CMAKE_BIN_DIR}/../partitions')
    if os.path.exists(partitions_gen_dir):
        copy_files('.csv', partitions_gen_dir, _BUILD_DIR)
        copy_files('.json', partitions_gen_dir, _BUILD_DIR)
        copy_files('.h', partitions_gen_dir, _BUILD_DIR)
        copy_files('.txt', partitions_gen_dir, _BUILD_DIR)

    # primary_cp_app -> cp_app.bin, primary_ap_app -> ap_app.bin (beken_utils
    # strips the primary_/secondary_ prefix to derive the child bin name).
    if os.path.exists(f'{CMAKE_BIN_DIR}/app.bin'):
        copy_file(f'{CMAKE_BIN_DIR}/app.bin', f'{_BUILD_DIR}/cp_app.bin')
    else:
        logging.error(f'{CMAKE_BIN_DIR}/app.bin not found (CP firmware required)')
        exit(1)

    ap_app_bin = os.path.realpath(f'{CMAKE_BIN_DIR}/../{soc}_ap/app.bin')
    if os.path.exists(ap_app_bin):
        copy_file(ap_app_bin, f'{_BUILD_DIR}/ap_app.bin')
    else:
        logging.error(f'{ap_app_bin} not found (AP firmware required)')
        exit(1)

    # BL2 comes from the tfm/bl2 build install dir (no tfm_s in this design).
    TFM_BIN_DIR = f'{CMAKE_BIN_DIR}/tfm_install/outputs'
    if not os.path.exists(TFM_BIN_DIR):
        TFM_BIN_DIR = f'{CMAKE_BIN_DIR}/tfm_install/bin'
    if os.path.exists(f'{TFM_BIN_DIR}/bl2.bin'):
        copy_file(f'{TFM_BIN_DIR}/bl2.bin', f'{_BUILD_DIR}/bl2.bin')
    else:
        logging.error(f'bl2.bin not found under {TFM_BIN_DIR}')
        exit(1)

    run_cmd(f'{BK_UTILS_TOOL} pack all --debug')

    os.makedirs(CMAKE_INSTALL_DIR, exist_ok=True)
    copy_file(f'{_BUILD_DIR}/ota.bin', f'{CMAKE_INSTALL_DIR}/ota.bin')
    copy_file(f'{_BUILD_DIR}/all-app.bin', f'{CMAKE_INSTALL_DIR}/all-app.bin')
    copy_file(f'{_BUILD_DIR}/bootloader.bin', f'{CMAKE_INSTALL_DIR}/bootloader.bin')
    copy_file(f'{_BUILD_DIR}/provision_pack.bin', f'{CMAKE_INSTALL_DIR}/provision_pack.bin')
    copy_file(f'{CMAKE_BIN_DIR}/app.elf', f'{CMAKE_INSTALL_DIR}/app.elf')
    copy_file(f'{TFM_BIN_DIR}/bl2.elf', f'{CMAKE_INSTALL_DIR}/bl2.elf')
    copy_file(f'{_BUILD_DIR}/otp_efuse_config.json', f'{CMAKE_INSTALL_DIR}/otp_efuse_config.json')

    # Keep the intermediate signing artifacts for audit / manual re-pack.
    pack_dir = f'{CMAKE_INSTALL_DIR}/pack'
    os.makedirs(pack_dir, exist_ok=True)
    for name in ('cp_app.bin', 'ap_app.bin', 'bl2.bin', 'partitions.csv',
                 'ota.csv', 'security.csv', 'pack.json', 'primary_all.bin',
                 'pack_cmd_list.txt'):
        copy_file(f'{_BUILD_DIR}/{name}', f'{pack_dir}/{name}')
    copy_files('.pem', _BUILD_DIR, pack_dir)

    move_file('all-app.bin', _BUILD_DIR, CMAKE_BIN_DIR)
    os.chdir(saved_cur_dir)


@click.group()
@click.version_option(version='1.0.0.0')
def wrapper():
    """Post-build scripts to sign and encrypt the secure firmware."""


@wrapper.command("pack")
@click.option("--prebuild/--no-prebuild", default=False, help="Whether it's post-build or pre-build")
def pack_bin(prebuild):
    """Pack (sign + encrypt) armino secure binaries."""
    pack(prebuild)


if __name__ == '__main__':
    logging.basicConfig()
    logging.getLogger().setLevel(logging.INFO)
    wrapper()
