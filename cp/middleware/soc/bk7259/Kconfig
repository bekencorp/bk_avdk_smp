	config SRAM_DIRECT_ADDR
		bool "Use SRAM direct address"
		default n
		help
			Use the direct SRAM address mapping for memory access. This is a
			low-level memory layout option and should match the linker script
			and boot configuration.

	config ANA_REG_WRITE_POLL_REG_B
		bool "Write analog register polls sys reg0xb"
		default y
		help
			Use system register 0xb as the polling register when writing analog
			registers. This is a SoC-level hardware workaround and normally
			should keep the default value.

	config PM_HAL_DEBUG
		bool "Enable PM hal debug"
		default n
		help
			Enable extra debug output in the power-management HAL. This is
			intended for low-power debugging and should normally be disabled in
			product builds.

	config PM_HAL_CTRL
		bool "Enable PM HAL control"
		default n
		help
			Enable additional power-management HAL control paths for BK7259 CP.
			Use this only when the project explicitly needs PM HAL control
			debug or validation.

	config TZ
		bool "Supported TrustZone"
		default y
		help
			Enable TrustZone support for the BK7259 CP target. This should
			match the secure/non-secure memory layout and boot configuration.

	config SPE
		int "Enable SPE"
		default 0
		help
			Secure Processing Environment mode selector. This is a low-level
			boot/security setting and should match the target security layout.

	config RX_OPTIMIZE
		bool "Optimize rx current"
		default n
		help
			Enable receive-path current optimization for BK7259 CP. Use this
			only after validating RF/current behavior on the target board.

