menu "SOC_CONFIG"

	choice SOC
		prompt "ARMINO SoC"
		default SOC_BK7259 if "$ARMINO_SOC" = "bk7259"
		default SOC_BK7258 if "$ARMINO_SOC" = "bk7258"
		default SOC_BK7257 if "$ARMINO_SOC" = "bk7257"

		config SOC_BK7259
			bool "BK7259"
		config SOC_BK7258
			select SOC_BK7236XX
			bool "BK7258"

		config SOC_BK7257
			select SOC_BK7236XX
			bool "BK7257"



	endchoice

	config CPU_CNT
			int "System CPU count: 1: single core, 2: dual core, etc."
			default 1

	config PLL_ENABLE
		bool "Enable pll in soc"
		default y
		help
			Enable pll in soc

	config SOC_STR
		string "SoC string"
		default "bk7259_cp"  if SOC_BK7259
		default "bk7258_cp"  if SOC_BK7258
		default "bk7257_cp"  if SOC_BK7257
		default "$ARMINO_SOC"

	config SOC_ARCH
		string "Soc arch"
		default "unknown"

	config SOC_BK7236XX
		bool "For bk7236 series chipset"
		default n

	config SOC_CORTEX_M_UART_DEBUG
		bool "For Cortex-M uart debug based on DWT"
		default n

	config SOC_SMP
		bool "For soc smp feature"
		default n

	config CPU_ID_OFFSET
		int "CPU ID offset"
		default 2
		depends on SOC_SMP

	config SMP_CORE_CNT
		int "SMP core count"
		default 2
		depends on SOC_SMP

	config ALL_CODE_IN_PSRAM
		bool "For all code in psram"
		default n
		depends on PSRAM
		help
			For all code in psram

	choice STACK_CHECK_MODE
	prompt "Compile stack check mode"
	default COMPILER_STACK_CHECK_MODE_NORM

	config COMPILER_STACK_CHECK_MODE_NORM
		bool "Add compile option: -fstack-protector"

	config COMPILER_STACK_CHECK_MODE_STRONG
		bool "Add compile option: -fstack-protector-strong"

	config COMPILER_STACK_CHECK_MODE_ALL
		bool "Add compile option: -fstack-protector-all"

	endchoice
endmenu
