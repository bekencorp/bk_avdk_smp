# KCONFIG_GROUP: Security & Cloud::PSA Mbed TLS
menu "PSA Mbedtls"
	config PSA_MBEDTLS
		bool "Enable psa mbedtls v3.6.6"
		default n
		help
			enable psa mbedtls v3.6.6

	menu "PSA Mbedtls Options"
		depends on PSA_MBEDTLS

		config MBEDTLS_USE_PSA_CRYPTO
			bool "TLS/X509 use PSA via TF-M"
			default n
			depends on TFM && TFM_CRYPTO
			help
				NS PSA Crypto APIs are provided by the TF-M Crypto partition.
				TLS/X509 call psa_* through the TF-M NS client (IPC/veneer).
				Does not enable a local PSA Crypto server in NS.

		config PSA_MBEDTLS_TEST
			bool "Enable psa interface test"
			default n
			depends on MBEDTLS_USE_PSA_CRYPTO
			help
				PSA CLI tests; requires TF-M PSA client path

		config MBEDTLS_SSL_IN_CONTENT_LEN
			int "Config MBEDTLS_SSL_IN_CONTENT_LEN"
			default 4096

		config MBEDTLS_SSL_OUT_CONTENT_LEN
			int "Config MBEDTLS_SSL_OUT_CONTENT_LEN"
			default 4096

		config TRUSTENGINE
			bool "Enable TrustEngine hardware crypto"
			help
				Classic mbedtls crypto backend via TE200 hardware.
				Mutually exclusive with SW_CRYPTO. Does not provide PSA server.

		config SW_CRYPTO
			bool "Enable software crypto"
			default y
			depends on !TRUSTENGINE
			help
				Classic mbedtls crypto backend via pure software.
				Mutually exclusive with TRUSTENGINE. Does not provide PSA server.

		config TE200_ENTROPY
			bool "Enable TE200 entropy"
			depends on TRUSTENGINE
			default n

		config TRUSTENGINE_TEST
			bool "Enable classic mbedtls cli test"
			depends on PSA_MBEDTLS
			default n
			help
				Classic mbedtls CLI testing code

		config FULL_MBEDTLS
			bool "Enable Full Mbedtls"
			default n
			help
				mbedtls support more algorithms(enabled in xxx_config.h)

		config MBEDTLS_LOG_LEVEL
			string "Set Mbedtls Log Level"
			default "INFO"
			help
				Set mbedtls log level: OFF/ERROR/WARNING/INFO/DEBUG
	endmenu

endmenu
