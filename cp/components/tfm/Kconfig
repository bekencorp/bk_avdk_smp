menu "TFM (Trusted Firmware-M)"

config TFM
    bool "Enable TF-M secure firmware (TrustZone-M SPE)"
    default n
    help
        Build Trusted Firmware-M (TF-M 2.1.0 baseline) as the secure world
        (SPE) on the CP (M52). Enables BL2 (MCUboot) secure boot and the
        secure partition manager. Requires CONFIG_PSA_MBEDTLS.

config SECURITY_FIRMWARE
    bool "Build security firmware (signed image + secure pack)"
    default n
    help
        Master switch that makes the build produce a signed/secure-packed
        firmware via beken_utils (BL2 + tfm_s + primary_all). Read by the
        board wrapper (bk7259.wrapper) to select the secure pack path.

menu "TF-M Options"
    depends on TFM

config TFM_PROFILE
    string "TF-M profile"
    default "profile_medium"

config TFM_BUILD_TYPE
    string "TF-M cmake build type"
    default "minsizerel"

config TFM_BL2
    string "Build BL2 (MCUboot)"
    default "ON"

config TFM_BL2_DOWNLOAD
	bool "Enable BL2 download"
	default y
	help
		Enable BL2 Download

config TFM_ISOLATION_LEVEL
    int "TF-M isolation level (1/2/3)"
    default 2

config TFM_TEST_S
    string "Build TF-M secure tests"
    default "OFF"

config TFM_TEST_NS
    string "Build TF-M non-secure tests"
    default "OFF"

config TFM_FPGA
    string "TF-M FPGA target"
    default "OFF"

config TFM_LOG_LEVEL
    string "TF-M secure log level"
    default "INFO"

config TFM_BL2_LOG_LEVEL
    string "BL2/MCUboot log level"
    default "INFO"

config TFM_HEAP_SIZE
    hex "TF-M heap size"
    default 0x6000

config BL2_UPGRADE_STRATEGY
    string "MCUboot upgrade strategy"
    default "DIRECT_XIP"

config DEBUG_OTA_INSTALL
    bool "DEBUG: overwrite install erase/write read-back checks"
    default n
    help
        Debug-only OVERWRITE_ONLY checks (default off):
        erase 0xFF read-back + CBUS write round-trip compare.
        Production relies on whole-image hash. Enable with:
        CONFIG_DEBUG_OTA_INSTALL=y

config XIP_NO_VERSION
    bool "XIP image without version header"
    default y

config TFM_CRYPTO
    bool "Enable TF-M Crypto partition (PSA Crypto)"
    default y

config TFM_PS
    bool "Enable TF-M Protected Storage partition"
    default n

config TFM_FWU
    bool "Enable TF-M Firmware Update partition"
    default n

config INITIAL_ATTESTATION
    bool "Enable TF-M Initial Attestation"
    default n

config TFM_REG_ACCESS_NSC
    bool "Enable NSC register access gateway (psa_reg_read/write)"
    default n
    help
        Beken ARMv8-M CMSE non-secure-callable (NSC) register access. When set,
        the secure world builds reg_nsc.c and exports psa_reg_read/psa_reg_write/
        psa_reg_dump into libtfm_s_veneers.a so the non-secure cpu0_app can reach
        registers through the secure world. Forwarded to the TF-M build as
        CONFIG_REG_ACCESS_NSC.

config TFM_AP_BOOT_NSC
    bool "Enable NSC AP secure-prepare gateway (psa_ap_secure_prepare)"
    default n
    help
        Let the CP Non-Secure power manager own the AP start sequence while TF-M
        performs only the Secure-privilege steps through a narrow NSC. When set,
        the secure world exports psa_ap_secure_prepare / psa_ap_secure_cancel /
        psa_ap_secure_boot_addr into libtfm_s_veneers.a. CP NS drives AON PMU,
        analog high-voltage domain, AP power-on and the AP SYS/AHBP registers
        (via the NS alias) and releases the AP core reset; the NSC only applies
        the AP MPC/PPHS, installs the verified boot shim and opens the Secure
        PPRO master gate. Forwarded to the TF-M build as CONFIG_AP_BOOT_NSC.

config TFM_AP_CACHE_NSC
    bool "Enable resident AP Secure L2 cache gateway"
    depends on TFM_AP_BOOT_NSC
    default n
    help
        Add a fixed Non-Secure Callable entry to the resident AP Secure boot
        shim. AP Non-Secure software can request PL310 clean-all,
        invalidate-all or clean-and-invalidate-all operations without
        receiving direct access to the PL310 register window. Forwarded to the
        TF-M build as CONFIG_AP_CACHE_NSC.

config TFM_SLEEP_RETENTION_NSC
    bool "Enable TF-M sleep secure context retention"
    depends on SOC_BK7259
    default n
    help
        Build a fixed TF-M security-boundary retention snapshot at cold boot
        and restore it from tfm_s Reset_Handler on sleep fast-boot wake.
        Sleep entry performs no register scan. Forwarded to the TF-M build as
        CONFIG_SLEEP_RETENTION_NSC.

config TFM_ENCP_NSC
    bool "Enable TE200 quiesce/resume NSC gateways"
    depends on SOC_BK7259 && TFM_CRYPTO && TFM_SLEEP_RETENTION_NSC
    default y if TFM_CRYPTO
    help
        Expose psa_encp_quiesce()/psa_encp_resume() to the NS cpu0_app so it can
        hand the TrustEngine over before a Low-Voltage sleep and ask the Secure
        world to rebuild it after wake. Required because the WRLP_ENCP domain
        (TE200 + OTP + WiFi/BT) is powered off in both LV and deep sleep.
        Forwarded to the TF-M build as CONFIG_ENCP_NSC.

config TFM_AP_SHIM_L2_CACHE_DISABLE
    bool "Disable AP L2 (PL310) init in the AP boot shim"
    depends on SOC_BK7259
    default n
    help
        When set, the secure AP boot shim skips the shared L2 (PL310) cache
        initialization entirely and boots the AP with L2 left disabled. For
        bring-up/debug of SRAM windows or PM paths where the L2 config is
        suspected. Forwarded to the TF-M build as CONFIG_TFM_AP_SHIM_L2_CACHE_DISABLE.

config TFM_OTP_NSC
    bool "Enable NSC OTP access gateway (read/write secure OTP1/OTP2)"
    default n
    help
        Beken ARMv8-M CMSE non-secure-callable (NSC) OTP access. When set, the
        secure world builds the secure OTP driver (otp_s.c) and the gateways
        (otp_nsc.c) and exports bk_otp_read_nsc / bk_otp_update_nsc /
        bk_otp_read_permission_nsc / bk_otp_write_permission_nsc /
        bk_otp_write_mask_nsc into libtfm_s_veneers.a, so the non-secure
        cpu0_app can read/write OTP banks owned by the secure world. Forwarded
        to the TF-M build as CONFIG_OTP_NSC.

config TFM_BOOTLOADER_VERSION_NSC
    bool "Enable NSC bootloader-version gateway (bk_bootloader_version_nsc)"
    default y
    help
        Beken ARMv8-M CMSE non-secure-callable (NSC) access to the BL2 version
        stamp stored at the tail of the BL2 manifest slot. The manifest lives in
        the flash region TF-M marks Secure on the DBUS, so the non-secure
        cpu0_app cannot read it directly. When set, the secure world builds
        bootloader_nsc.c and exports bk_bootloader_version_nsc into
        libtfm_s_veneers.a. Forwarded to the TF-M build as
        CONFIG_BOOTLOADER_VERSION_NSC.

endmenu # TF-M Options

endmenu # TFM
