# KCONFIG_GROUP: Debug::Crash Dump
menu "Coredump"
	config CM_BACKTRACE
		bool "Enable Cm Backtrace"
		default n

	config DUMP_ENABLE
			bool "Enable Dump Feature"
			default n
			help
				Dump all memory when exception happen

	config MEMDUMP_ALL
			bool "Enable Memdump All"
			default DEBUG_VERSION
			help
				Dump all memory when exception happen.
				Build-version driven: a Debug build dumps the full memory set,
				a Release build dumps only the minimal set. The full-vs-minimal
				selection also honors CONFIG_DEBUG_VERSION at compile time (see
				memdump_strategies/), so the developer environment gets full
				dumps even under BUILD_DEFAULT_VERSION while the released SDK
				(CONFIG_RELEASE_VERSION) stays minimal.

	config CP_HANG_DUMP_BY_AP
			bool "Enable AP-side CP hang dump feature"
			depends on IPI
			default y
			help
				Production reliability feature. Intentionally independent of
				DUMP_ENABLE so it stays ON in a Release build (DUMP_ENABLE=n):
				the cross-core hang watchdog only uses the always-compiled
				coredump writer primitives (bk_coredump_uart/manifest), not the
				DUMP_ENABLE-gated self-exception dump path.
				CP sends a private IPI heartbeat to AP. If AP observes CP
				heartbeat timeout, AP dumps CP-visible context and reboots the
				board without relying on the CP - covering the "CP wedged and
				not answering mailbox" case.

	config CP_HANG_DUMP_BY_AP_PERIOD_MS
			int "CP to AP debug heartbeat period(ms)"
			depends on CP_HANG_DUMP_BY_AP
			default 1000

	choice DUMP_UART_MEM_ENCODING
		prompt "Config DumpUart Memory Encoding"
		default DUMP_UART_MEM_ENCODING_ASCII
		help
			Default ASCII format

		config DUMP_UART_MEM_ENCODING_ASCII
			bool "ASCII"
			help
				Dump memory in ASCII format
		config DUMP_UART_MEM_ENCODING_BASE64
			bool "Base64"
			help
				Dump memory in Base64 format
	endchoice

	choice DUMP_BY_UART
		prompt "Dump output method"
		default DUMP_BY_LOG_UART
		help
			Dump output method
		config DUMP_BY_LOG_UART
			bool "Log UART"
			help
				Dump to log UART
		config DUMP_BY_FLASH
			bool "Flash"
			help
				Dump to flash
	endchoice

	config TRAP_TEST
			bool "Enable trap test"
			default n
			help
				trap test
endmenu
