# KCONFIG_GROUP: Power Management
menu "PM"
	config PM_ENABLE
		bool "pm enable"
		default n

	config PM_CLIENT
		bool "indicate the current cpu running as pm client core, otherwise running as pm server core"
		default n

	config PM_SUPER_DEEP_SLEEP
		bool "Enable super deep sleep"
		default n

	config PM_EXTEND_CPU_FREQ
		bool "Extend cpu freq"
		default n

	config PM_LV_TIME_COST_DEBUG
		bool "Enable low voltage sleep time cost debug"

	config PM_ENTER_LV_TIME_OUT_PERIOD_MS
		int "Enter LV time out"
		default 30000
		help
			enter LV time out time(unit:ms)

	config PM_LV_WDT_PROTECTION
		bool "add protection for hardware enter low voltage fail when application abnormal operate, using wdt to reboot"
		default n

	config PM_CPU_FRQ_HIGHEST
		int "config highest cpu frequency"
		default 4
		help
		   config highest cpu frequency(0:xtal;1:60M;2:80M;3:120M;4:160M;5:240M;)

	config PM_CPU_FRQ_DEFAULT
		int "config default cpu frequency"
		default 3
		help
		   config default cpu frequency(0:xtal;1:60M;2:80M;3:120M;4:160M;5:240M;)

	config PM_PROTECT_TIME_CHECK
		bool "Primarily protect time check"
		default n
		help
			Primarily protect the BT sleep time until re-entering the sleep scenario

	config PM_POWER_VOTE_RECORD
		bool "Enable PM power vote record"
		default n
		help
			Record PM power votes for debugging.

	config PM_CLOCK_VOTE_RECORD
		bool "Enable PM clock vote record"
		default n
		help
			Record PM clock votes for debugging.

	config PM_LOWEST_POWER_MODE
		int "config lowest power mode"
		default 0
		help
		   config lowest power mode(0:normal sleep;1:low voltage sleep;2:deep sleep;3:super deep sleep;)

	config PM_ONLY_CP_ENABLE
		bool "only cp enable ,ap disable"
		default n
		help
			only cp enable ,ap disable

	config PM_CP_PERI_CLK_DEFAULT_OFF
		bool "Default disable CP peripheral clocks"
		default n
		help
			Keep CP peripheral clocks disabled by default during early init.

	config PM_CP_CPU1_BAKP_AUDP_DOMAIN_DEFAULT_OFF
		bool "Default disable CP CPU1_BAKP_AUDP domain"
		depends on PM_ONLY_CP_ENABLE
		default n
		help
			Power down the CP CPU1_BAKP_AUDP domain during early init.

	config PM_XTAL_RX_TX_ANABUF_DEFAULT_OFF
		bool "Default disable XTAL RX/TX analog buffers"
		default n
		help
			Keep XTAL RX/TX analog buffers disabled by default.

	config PM_CURRENT_OPTIMIZE_XTAL_RX_TX_ANABUF
		bool "Optimize PM current through XTAL RX/TX analog buffers"
		default n
		help
			Optimize power-management current through XTAL RX/TX analog buffers.

	config DEEP_LV
		bool "Enable deep low voltage"
		default n

	config DEEP_LV_DEBUG_GPIO
		bool "Enable deep low voltage debug (GPIO toggle markers)"
		default n

	config DEEP_LV_DEBUG_LOG
		bool "Enable deep low voltage AON snapshot debug log"
		default n
		help
			Enable the AON register snapshot/diff log around deep LV
			sleep entry/exit. Independent from DEEP_LV_DEBUG_GPIO so the
			GPIO toggle markers can be disabled while the snapshot
			log stays enabled.

	config PM_CP_DEEP_LV_SRAM_CHECK
		bool "Enable CP SRAM CRC check in deep low voltage"
		depends on DEEP_LV
		default n
		help
			Check CP SRAM code/data retention around deep low voltage sleep.

	config PM_AP_SRAM_POWER_CTRL
		bool "Enable AP SRAM power control in deep low voltage"
		depends on DEEP_LV
		default y
		help
			Enable AP SRAM power control before entering deep low
			voltage sleep.

	menu "AP SRAM power control in deep low voltage"
		depends on PM_AP_SRAM_POWER_CTRL

		config PM_AP_MEM3_POWER_DOWN
			bool "Power down AP MEM3 in deep low voltage"
			default y
			help
				Power down AP MEM3 before entering deep low voltage sleep.
				Disable this option to keep MEM3 powered for SRAM data retention.

		config PM_AP_MEM4_POWER_DOWN
			bool "Power down AP MEM4 in deep low voltage"
			default y
			help
				Power down AP MEM4 before entering deep low voltage sleep.
				Disable this option to keep MEM4 powered for SRAM data retention.

		config PM_AP_MEM5_POWER_DOWN
			bool "Power down AP MEM5 in deep low voltage"
			default y
			help
				Power down AP MEM5 before entering deep low voltage sleep.
				Disable this option to keep MEM5 powered for SRAM data retention.

		config PM_AP_MEM6_POWER_DOWN
			bool "Power down AP MEM6 in deep low voltage"
			default y
			help
				Power down AP MEM6 before entering deep low voltage sleep.
				Disable this option to keep MEM6 powered for SRAM data retention.

		config PM_AP_CPU2_CACHE_POWER_DOWN
			bool "Power down AP CPU2 cache SRAM in deep low voltage"
			default y
			help
				Power down AP CPU2 cache SRAM before entering deep low
				voltage sleep. Disable this option to keep it powered for
				data retention.

		config PM_AP_CPU3_CACHE_POWER_DOWN
			bool "Power down AP CPU3 cache SRAM in deep low voltage"
			default y
			help
				Power down AP CPU3 cache SRAM before entering deep low
				voltage sleep. Disable this option to keep it powered for
				data retention.
	endmenu

	config AON_LDO_SEL
		int "Config AON LDO voltage select"
		range 0 7
		default 4
		help
			Config AON LDO voltage select.
			0:0.6V; 1:0.65V; 2:0.7V; 3:0.75V; 4:0.8V; 5:0.85V; 6:0.9V; 7:0.95V.

	config OPTIMIZE_AON_CURRENT
		bool "Optimize AON current"
		default y
		help
			Optimize AON current by lowering AON LDO voltage during low voltage sleep.

	config PM_AP_POWERDOWN_WHEN_LV
		bool "Power down ap when sleep"
		default n
endmenu

