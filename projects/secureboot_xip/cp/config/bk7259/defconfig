#
# secureboot_xip CP defconfig (diff vs board defconfig)
# CP secure boot with TF-M 2.1.0 + MCUboot 2.1.0.
#

# --- SMP base (CP = 2 cores) ---
CONFIG_SOC_SMP=n
CONFIG_CPU_ID_OFFSET=0
CONFIG_SMP_CORE_CNT=2
# CONFIG_FREERTOS_V10 is not set
CONFIG_FREERTOS_SMP=n
CONFIG_SLAVE_HEART_BEAT=n
CONFIG_PM_ONLY_CP_ENABLE=y
CONFIG_FREERTOS_ALLOW_OS_API_IN_IRQ_DISABLED=y
CONFIG_SPINLOCK=y
CONFIG_SUPPORT_WWDT=n
CONFIG_SECURITY_FIRMWARE=y
# flash controller MMIO (0x54030000) is secure-only; NS easyflash direct
# access faults. Disable easyflash until NS flash goes through a secure gateway.
CONFIG_EASY_FLASH=n

CONFIG_SPE=0
CONFIG_SRAM_DIRECT_ADDR=y

# --- TF-M (built as ExternalProject under components/tfm) ---
CONFIG_TFM=y
CONFIG_TFM_PROFILE="profile_medium"
CONFIG_TFM_BUILD_TYPE="minsizerel"
CONFIG_TFM_BL2="ON"
CONFIG_TFM_ISOLATION_LEVEL=2
CONFIG_TFM_TEST_S="OFF"
CONFIG_TFM_TEST_NS="OFF"
CONFIG_TFM_FPGA="OFF"
# Enable secure-world + BL2 logs so the secure boot flow is observable on UART1
# (TFM_DRIVER_STDIO). Lower to OFF/ERROR for production.
CONFIG_TFM_LOG_LEVEL="INFO"
CONFIG_TFM_BL2_LOG_LEVEL="INFO"

# --- MCUboot upgrade strategy (DIRECT_XIP) ---
CONFIG_BL2_UPGRADE_STRATEGY="DIRECT_XIP"
CONFIG_XIP_NO_VERSION=y

# --- SPE heap ---
CONFIG_TFM_HEAP_SIZE=0x6000

# --- TF-M secure services (Crypto only) ---
CONFIG_TFM_CRYPTO=y
# CONFIG_TFM_PS is not set
# CONFIG_TFM_FWU is not set
CONFIG_INITIAL_ATTESTATION=n

# --- NSC AP boot release (defer AP release to NS after bk_init) ---
CONFIG_TFM_AP_BOOT_NSC=y

# --- NSC (CMSE non-secure-callable) register access gateway ---
# NS cpu0_app reaches registers through the secure world via SG veneers
# (reg_nsc.c -> libtfm_s_veneers.a). Enables the NS `regshow_s` CLI too.
CONFIG_TFM_REG_ACCESS_NSC=y

# --- Crypto backend ---
# NS classic mbedtls: TRUSTENGINE (Normal window). NS PSA/TLS-via-PSA: TF-M Crypto.
CONFIG_PSA_MBEDTLS=y
CONFIG_MBEDTLS_USE_PSA_CRYPTO=y
CONFIG_PSA_MBEDTLS_TEST=y
CONFIG_CLASSIC_MBEDTLS_TEST=y
CONFIG_TRUSTENGINE=y
# CONFIG_SW_CRYPTO is not set

# --- PSRAM: CP does not use PSRAM, keep it disabled on CP ---
CONFIG_PSRAM=y
# CONFIG_PSRAM_AS_SYS_MEMORY is not set
# CONFIG_PSRAM_WRITE_THROUGH is not set
# CONFIG_PSRAM_CALIBRATE is not set
# CONFIG_PSRAM_TEST is not set
# CONFIG_USE_PSRAM_HEAP_AT_SRAM_OOM is not set

# --- Heap debug: disabled ---
# CONFIG_MEM_DEBUG is not set

CONFIG_AT_CMD=y
CONFIG_BTDM_CONTROLLER_ONLY=y