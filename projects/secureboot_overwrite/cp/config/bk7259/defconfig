#
# secureboot_overwrite CP defconfig (diff vs board defconfig)
# CP secure boot with TF-M 2.1.0 + MCUboot 2.1.0, OVERWRITE upgrade strategy.
#

# --- SMP base (CP = 2 cores) ---
CONFIG_SOC_SMP=n
CONFIG_CPU_ID_OFFSET=0
CONFIG_SMP_CORE_CNT=2
# CONFIG_FREERTOS_V10 is not set
CONFIG_FREERTOS_SMP=n
CONFIG_SLAVE_HEART_BEAT=y
CONFIG_FREERTOS_ALLOW_OS_API_IN_IRQ_DISABLED=y
CONFIG_SPINLOCK=y
CONFIG_SUPPORT_WWDT=y
CONFIG_WWDT_TEST=y
CONFIG_SECURITY_FIRMWARE=y
# flash controller MMIO (0x54030000) is secure-only; NS easyflash direct
# access faults. Disable easyflash until NS flash goes through a secure gateway.
CONFIG_EASY_FLASH=n

CONFIG_SPE=0
CONFIG_SRAM_DIRECT_ADDR=y

# --- TF-M (built as ExternalProject under components/tfm) ---
CONFIG_TFM=y
CONFIG_TFM_PROFILE="profile_medium"
CONFIG_TFM_BUILD_TYPE="minsizerel"
CONFIG_TFM_BL2="ON"
CONFIG_TFM_ISOLATION_LEVEL=2
CONFIG_TFM_TEST_S="OFF"
CONFIG_TFM_TEST_NS="OFF"
CONFIG_TFM_FPGA="OFF"
# Enable secure-world + BL2 logs so the secure boot flow is observable on UART1
# (TFM_DRIVER_STDIO). Lower to OFF/ERROR for production.
CONFIG_TFM_LOG_LEVEL="INFO"
CONFIG_TFM_BL2_LOG_LEVEL="INFO"

# --- MCUboot upgrade strategy (OVERWRITE_ONLY) ---
# Drives -DMCUBOOT_UPGRADE_STRATEGY (cp/components/tfm/CMakeLists.txt) so BL2 is
# built with MCUBOOT_OVERWRITE_ONLY: one execution slot (primary_all) is
# overwritten in place from the `ota` staging area after LZMA decompression.
# The strategy macros CONFIG_OTA_OVERWRITE / CONFIG_DIRECT_XIP / CONFIG_OTA_ENCRYPTED
# are NOT set here; gen_ota.py derives them from partitions/bk7259/ota.csv.
CONFIG_BL2_UPGRADE_STRATEGY="OVERWRITE_ONLY"
CONFIG_XIP_NO_VERSION=y
# Optional DEBUG: overwrite install erase/write read-back (default off for mass production).
CONFIG_DEBUG_OTA_INSTALL=y

# --- SPE heap ---
CONFIG_TFM_HEAP_SIZE=0x6000

# --- TF-M secure services (Crypto only) ---
CONFIG_TFM_CRYPTO=y
# CONFIG_TFM_PS is not set
# CONFIG_TFM_FWU is not set
CONFIG_INITIAL_ATTESTATION=n

# --- AP start: CP NS PM vote + multicore, secure-prepare via NSC ---
# CP NS owns the AP start sequence (AON PMU / analog / AP power-on / AP SYS via
# NS alias / reset release); TF-M only performs AP MPC/PPHS, shim install and the
# Secure PPRO master gate through the narrow psa_ap_secure_prepare NSC.
CONFIG_SUPPORT_MULTICORE=y
CONFIG_TFM_AP_BOOT_NSC=y
CONFIG_TFM_SLEEP_RETENTION_NSC=y

# --- NSC (CMSE non-secure-callable) register access gateway ---
# NS cpu0_app reaches registers through the secure world via SG veneers
# (reg_nsc.c -> libtfm_s_veneers.a). Enables the NS `regshow_s` CLI too.
CONFIG_TFM_REG_ACCESS_NSC=y

# --- Crypto backend ---
# NS classic mbedtls: TRUSTENGINE (Normal window). NS PSA/TLS-via-PSA: TF-M Crypto.
CONFIG_PSA_MBEDTLS=y
CONFIG_MBEDTLS_USE_PSA_CRYPTO=y
CONFIG_PSA_MBEDTLS_TEST=y
CONFIG_CLASSIC_MBEDTLS_TEST=y
CONFIG_TRUSTENGINE=y
# CONFIG_SW_CRYPTO is not set

# --- PSRAM: CP does not use PSRAM, keep it disabled on CP ---
CONFIG_PSRAM=y
# CONFIG_PSRAM_AS_SYS_MEMORY is not set
# CONFIG_PSRAM_WRITE_THROUGH is not set
# CONFIG_PSRAM_CALIBRATE is not set
# CONFIG_PSRAM_TEST is not set
# CONFIG_USE_PSRAM_HEAP_AT_SRAM_OOM is not set

# --- Heap debug: disabled ---
# CONFIG_MEM_DEBUG is not set

#Platform
CONFIG_AT_CMD=y
CONFIG_PSRAM=y
#PSRAM CONTROLLER at AP,when sleep alive not enable AP, so CP can not use PSRAM when sleep alive
CONFIG_PSRAM_AS_SYS_MEMORY=n

#PM
CONFIG_FREERTOS_USE_TICKLESS_IDLE=2
CONFIG_PM_AP_POWERDOWN_WHEN_LV=y
CONFIG_PM_ONLY_CP_ENABLE=y

CONFIG_DEEP_LV=y
CONFIG_DEEP_LV_DEBUG_GPIO=n
CONFIG_DEEP_LV_DEBUG_LOG=n
CONFIG_AON_RTC=y
CONFIG_GPIO_WAKEUP_SUPPORT=y
CONFIG_GPIO_DYNAMIC_WAKEUP_SUPPORT=y
CONFIG_TOUCH=y
CONFIG_TOUCH_TEST=y
CONFIG_PM_POWER_VOTE_RECORD=y
CONFIG_PM_CLOCK_VOTE_RECORD=y
CONFIG_CKMN_TEST=y
CONFIG_OPTIMIZE_AON_CURRENT=y
CONFIG_AON_LDO_SEL=2
CONFIG_DEBUG_VERSION=n
CONFIG_PM_CURRENT_OPTIMIZE_XTAL_RX_TX_ANABUF=n
CONFIG_CPU_DEFAULT_FREQ_60M=n
CONFIG_PM_CP_PERI_CLK_DEFAULT_OFF=n
CONFIG_PM_XTAL_RX_TX_ANABUF_DEFAULT_OFF=n

#WIFI
CONFIG_STA_PS=y

#BLE
CONFIG_BLUETOOTH=y
CONFIG_BLUETOOTH_BLE_SLAVE_ONLY=y
CONFIG_BLUETOOTH_SUPPORT_LPO_ROSC=y
CONFIG_BLE_LV_SUPPORT=y
#CONFIG_BTDM_CONTROLLER_ONLY=y
CONFIG_BTDM_CONTROLLER_ONLY=n
CONFIG_BLUETOOTH_SUPPORT_AP_PWD_ALL=y