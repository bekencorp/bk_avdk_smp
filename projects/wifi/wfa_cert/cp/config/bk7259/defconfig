#
# Automatically generated project default config. You can update it with menuconfig [D] option.
# This file contains only differences compared to board defconfig.
#
# WFA cert settings aligned with bk_idk projects/wifi/wfa_cert/config/bk7239/config
#

CONFIG_SOC_SMP=y
CONFIG_CPU_ID_OFFSET=0
CONFIG_SMP_CORE_CNT=2
# CONFIG_FREERTOS_V10 is not set
CONFIG_FREERTOS_SMP=y
CONFIG_FREERTOS_ALLOW_OS_API_IN_IRQ_DISABLED=y
CONFIG_SPINLOCK=y
CONFIG_MAC802154_ENABLE=n
CONFIG_MAC802154=n
CONFIG_MAC802154_TEST=y
CONFIG_AT_CMD=y
# CONFIG_BLUETOOTH is not set
# CONFIG_BTDM_CONTROLLER_ONLY is not set

CONFIG_TIMER_SUPPORT_ID_BITS=4095
CONFIG_TIMER_PM_CB_SUPPORT=y

# dbg_probe: pre-landed but disabled by default (sources compile to no-op).
CONFIG_DBG_PROBE=n
# CONFIG_WIFI_FAST_CONNECT is not set
# CONFIG_MINIMUM_SCAN_RESULTS is not set
# CONFIG_WIFI_FAST_DHCP is not set
CONFIG_SOFTAP_WPA3=n
CONFIG_WIFI_REGDOMAIN=y
# CONFIG_IPV6 is not set

# CONFIG_FREERTOS_TRACE is not set
CONFIG_INT_WDT=y
# CONFIG_TASK_WDT is not set
CONFIG_NMI_WDT_EN=y

CONFIG_PM_CPU_FRQ_DEFAULT=5
CONFIG_PM_CPU_FRQ_HIGHEST=5

CONFIG_SHELL_ASYNCLOG=y
CONFIG_WIFI_CLI_ENABLE=y
CONFIG_CLI=y
CONFIG_IPERF_TEST=y

## LWIP Configuration (bk7239 wfa_cert)
# CONFIG_LWIP_TCP_SND_BUF=43800
# CONFIG_LWIP_TCP_WND=43800
# CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
# CONFIG_LWIP_MEM_SIZE=92160
# CONFIG_LWIP_MEM_MAX_RX_SIZE=76800
# CONFIG_LWIP_MEM_MAX_TX_SIZE=81920
# CONFIG_LWIP_MEMP_NUM_NETBUF=128
# CONFIG_LWIP_PBUF_POOL_SIZE=10
# CONFIG_LWIP_TCP_SND_QUEUELEN=60
# CONFIG_LWIP_MEMP_NUM_TCP_SEG=80
# CONFIG_LWIP_TCP_MSS=1460

# WFA Certification
CONFIG_WFA_CA=n
CONFIG_QUICK_TRACK=y
CONFIG_QUICK_MBO=y
# CONFIG_WPA_PSK_CACHE is not set
CONFIG_WPA_LOG=y
CONFIG_WFA_CERT=y
CONFIG_WIFI_WNM=y
CONFIG_MBO=y
CONFIG_PRINTF_BUF_SIZE=280
CONFIG_QUICK_TRACK_UART_PORT=2

# WFA creates multiple 4KB-stack threads; CP SRAM heap is ~80KB after WiFi init.
CONFIG_TASK_STACK_IN_PSRAM=y

# UART: bk7239 relies on SOC pin macros; bk7259 AMP needs explicit GPIO map in
# usr_gpio_cfg.h plus UART instance enable here.
CONFIG_UART1=y
CONFIG_UART2=y
CONFIG_UART_PM_CB_SUPPORT=y
CONFIG_WIFI_PS_DISABLE=y
