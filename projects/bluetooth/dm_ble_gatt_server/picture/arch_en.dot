digraph arch {
    rankdir=LR;
    bgcolor="white";
    fontname="Arial";
    node [fontname="Arial", shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#9bb8e0", penwidth=1.2];
    edge [fontname="Arial", color="#555555", fontsize=11];

    Peer [label="Peer Device\nGATT Client / Phone BLE Tool", fillcolor="#fde9d9", color="#e0a96b"];

    subgraph cluster_board {
        label="BK7259 Dual-mode Bluetooth Project";
        fontname="Arial";
        style="rounded";
        color="#9bb8e0";

        subgraph cluster_ap {
            label="AP Core";
            fontname="Arial";
            style="rounded";
            color="#8ec98e";
            Host [label="Dual-mode Bluetooth HOST\nBLE GATTS app only"];
            Component [label="dm_gatt / dm_gatts component\nGAP/GATTS callbacks\nshared ble_gatt_demo CLI"];
            DB [label="GATT Database\nService 0xFA00\nEA01 Notify\nEA02 Write\nEA05/EA06/EA07 Read-Write"];
            App [label="dm_ble_gatt_server_demo\nregister DB / start advertising / notify"];
        }

        CP [label="CP Core\nDual-mode Bluetooth Controller\nradio / link / ATT bearer", fillcolor="#e7f5e7", color="#8ec98e"];
    }

    Peer -> CP [label="BLE air interface\nadvertising / connection / ATT"];
    CP -> Host [label="IPC"];
    Host -> Component;
    Component -> App;
    App -> DB;
    Component -> CP [label="GAP/GATT operations"];
    CP -> Peer [label="read/write response / notification"];
}
