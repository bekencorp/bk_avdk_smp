digraph flow {
    rankdir=TB;
    bgcolor="white";
    fontname="Noto Sans CJK SC";
    node [fontname="Noto Sans CJK SC", shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#9bb8e0", penwidth=1.2];
    edge [fontname="Noto Sans CJK SC", color="#555555", fontsize=11];

    A [label="编译并烧录 dm_ble_gatt_server"];
    B [label="打开串口，上电\nAP 启动双模 HOST\nCP 启动双模 Controller"];
    C [label="bk_dm_prf_gap_main / bk_dm_prf_gatts_main\n初始化组件与公共 callback"];
    D [label="注册 demo GATT DB\nService 0xFA00\nEA01/EA02/EA05/EA06/EA07"];
    E [label="demo 串行配置广播\n广播名 BKDMBLE-xxxxxx\n广播 UUID 0xFA00"];
    SEC [label="两端执行 security_method 3 1 3\n（连接前配置）", fillcolor="#e8f5e9", color="#81c784"];
    F [label="对端扫描并连接", shape=diamond, fillcolor="#fff6cc", color="#d9c14e"];
    G [label="对端发现服务与 handle\nhandle 以运行时日志为准"];
    H [label="对端写 EA02 或 EA05~EA07\nserver 打印 text 与 hex"];
    I [label="对端读 EA05~EA07\n返回最近一次写入值"];
    J [label="对端写 CCCD 使能 EA01 通知"];
    K [label="ap_cmd dm_ble_gatt_server gatts notify hello\n发送 notification"];
    BOND [label="接受对端 create_bond\npairing success / show_bond", fillcolor="#e8f5e9", color="#81c784"];
    PARAM [label="对端 update_param\n连接参数更新", fillcolor="#e8f5e9", color="#81c784"];
    L [label="断开连接"];
    M [label="ap_cmd ble_gatt_demo gatts enable_adv 1\n重新开始广播"];

    A -> B -> C -> D -> E -> SEC -> F;
    F -> G [label="已连接"];
    G -> H -> I -> J -> K -> BOND -> PARAM -> L -> M;
    M -> F [label="等待下一次连接"];
}
