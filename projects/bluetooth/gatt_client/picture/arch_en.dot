digraph arch {
    rankdir=LR;
    bgcolor="white";
    fontname="Noto Sans CJK SC";
    node [fontname="Noto Sans CJK SC", shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#9bb8e0", penwidth=1.2];
    edge [fontname="Noto Sans CJK SC", color="#555555", fontsize=11];

    subgraph cluster_board {
        label="BK7259 development board (GATT Client)";
        fontname="Noto Sans CJK SC";
        style="rounded";
        color="#9bb8e0";

        subgraph cluster_ap {
            label="AP (application core)";
            fontname="Noto Sans CJK SC";
            style="rounded";
            color="#8ec98e";
            Host [label="BLE Host\nGATT Client"];
            Ops  [label="scan / connect / discovery\nread / write / enable notify"];
        }

        CP [label="CP (companion core)\nBLE Controller\nscan / connection / radio", fillcolor="#e7f5e7", color="#8ec98e"];
    }

    Peer [label="Peer GATT Server\n(gatt_server project)\nService 0xFA00", fillcolor="#fde9d9", color="#e0a96b"];

    Ops  -> Host;
    Host -> CP   [label="IPC"];
    CP   -> Peer [label="BLE air interface\nscan / connect / ATT"];
    Peer -> CP   [label="adv / read-write rsp / notify"];
    CP   -> Host [label="IPC"];
}
