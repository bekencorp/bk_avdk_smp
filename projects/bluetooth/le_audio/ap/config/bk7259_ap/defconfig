#
# LE Audio robot broadcast demo AP default config.
#

# CONFIG_SOC_SMP is not set
# CONFIG_ALL_CODE_IN_PSRAM is not set
CONFIG_BLUETOOTH_AP=y
CONFIG_BT=n
CONFIG_BLE=y
CONFIG_BLE_LE_AUDIO=y
CONFIG_FREERTOS_V10=y
# CONFIG_FREERTOS_SMP is not set
CONFIG_FREERTOS_USE_QUEUE_SETS=y
CONFIG_MEDIA_SERVICE=y

# CONFIG_SPI is not set
# CONFIG_SPI_DMA is not set
CONFIG_AUDIO=y
CONFIG_AUD_DRIVER_V2=y
CONFIG_AUDIO_ADC=y
CONFIG_AUDIO_DAC=y

CONFIG_ADK=y
CONFIG_ADK_USE_PSRAM=y
CONFIG_ADK_MIX_ALGORITHM=y
CONFIG_ADK_RAW_STREAM=y
CONFIG_ADK_VFS_UTIL=n
CONFIG_ADK_ONBOARD_SPEAKER_STREAM=y
CONFIG_ADK_ONBOARD_SPEAKER_STREAM_V2=y

CONFIG_AUDIO_PLAY=y
CONFIG_SUPPORT_WWDT=n

CONFIG_GENERAL_DMA=y
CONFIG_GENERAL_DMA_V2P6=y
CONFIG_DMA_LOGIC_CHAN_CNT=4
CONFIG_DMA_LOGIC_CHAN_ID_MIN=4
CONFIG_XTAL_FREQ=12000000

CONFIG_ADK_SBC_DECODER=y
CONFIG_ADK_AAC_DECODER=n

CONFIG_BLUETOOTH_BTDM_COMPONENT_ENABLE=y
CONFIG_LE_AUDIO_ROLE_SINK=y
CONFIG_LE_AUDIO_PROTOCOL_DEMO=y
