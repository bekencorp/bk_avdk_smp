menu "LE Audio Robot Broadcast Demo Configuration"

    choice LE_AUDIO_DEFAULT_ROLE
        prompt "default LE Audio role"
        default LE_AUDIO_ROLE_SINK

        config LE_AUDIO_ROLE_SOURCE
            bool "Broadcast source (master robot)"

        config LE_AUDIO_ROLE_SINK
            bool "Broadcast sink (slave robot)"
    endchoice

    config LE_AUDIO_BROADCAST_NAME
        string "LE Audio broadcast name"
        default "BK7259_LE_AUDIO_ROBOT"

    config LE_AUDIO_SAMPLE_RATE
        int "LC3 sample rate"
        default 48000

    config LE_AUDIO_FRAME_US
        int "LC3 frame duration in us"
        default 10000

    config LE_AUDIO_FRAME_BYTES
        int "LC3 frame bytes"
        default 120

    config LE_AUDIO_PROTOCOL_DEMO
        bool "Enable LE Audio protocol demo"
        default n

endmenu
