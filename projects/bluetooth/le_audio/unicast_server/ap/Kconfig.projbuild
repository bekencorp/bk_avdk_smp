menu "LE Audio Unicast Server Configuration"

    config LE_AUDIO_BROADCAST_NAME
        string "LE Audio device name"
        default "BK Unicast Server"

    config LE_AUDIO_SAMPLE_RATE
        int "LC3 sample rate"
        default 48000

    config LE_AUDIO_FRAME_US
        int "LC3 frame duration in us"
        default 10000

    config LE_AUDIO_FRAME_BYTES
        int "LC3 frame bytes"
        default 120

    config LE_AUDIO_STREAM_COUNT
        int "Audio streams (1 mono, 2 stereo: one LC3 stream per channel)"
        default 2
        range 1 2

    config LE_AUDIO_VCP
        bool "Volume Control Profile (renderer)"
        default y
        help
            Lets the peer read and change the speaker volume through VCS.

    config LE_AUDIO_MCP
        bool "Media Control Profile (client)"
        default y
        help
            Drives play / pause / next / previous on the peer's media player
            through its GMCS. This is the LE Audio counterpart of AVRCP.

endmenu
