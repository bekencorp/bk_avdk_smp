#
# Automatically generated project default config. You can update it with menuconfig [D] option.
# This file contains only differences compared to board defconfig.
#
# CONFIG_LWIP is not set
CONFIG_DPU_DRIVER=y
CONFIG_CLI_TASK_STACK_SIZE=1536
CONFIG_BK_DISPLAY=y
CONFIG_DPU_FLUSH_TIMER_DEBUG=y
CONFIG_FRAME_BUFFER=y
CONFIG_VG_LITE_GPU=y
CONFIG_VG_LITE_GPU_BASE_ADDRESS=0x4c280000
CONFIG_VG_LITE_GPU_COMMAND_BUFFER_SIZE=0x2000
# CONFIG_BK_NETIF is not set
CONFIG_BK_PERIPHERAL=y
CONFIG_LCD_RGB=y
CONFIG_LCD_ST7701S=y
CONFIG_LCD_ST7701SN=y
CONFIG_TP=y
CONFIG_TP_RST_PIN=5
CONFIG_TP_INT_PIN=6
CONFIG_TP_I2C_SDA_PIN=1
CONFIG_TP_I2C_SCL_PIN=0
CONFIG_TP_GT911=y
CONFIG_TP_GT1151=y
CONFIG_TP_FT6336=y
CONFIG_TP_HY4633=y
CONFIG_TP_CST816D=y
# CONFIG_WIFI_CLI_DEBUG is not set
# CONFIG_WIFI_VNET_CONTROLLER is not set
CONFIG_DUMP_UART_MEM_ENCODING_ASCII=y
CONFIG_DUMP_BY_LOG_UART=y
CONFIG_EASY_FLASH_V4=y
CONFIG_LVGL=y
CONFIG_LVGL_V9=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LVGL_TASK_PRIORITY=4
CONFIG_LVGL_TASK_STACK_SIZE=8192
CONFIG_LVGL_FRAME_BUFFER_NUM=2
CONFIG_LVGL_USE_GPU_ROTATE=y
CONFIG_MEDIA_SERVICE=y
# CONFIG_SPI is not set
# CONFIG_SPI_DMA is not set
# CONFIG_GENERAL_DMA is not set
CONFIG_DMA_LOGIC_CHAN_CNT=16
CONFIG_DMA_LOGIC_CHAN_ID_MIN=0
# PSRAM backs the JavaScript heap through psram_malloc() (AP_PSRAM_HEAP).
# Keep the system heap in SRAM: CONFIG_PSRAM_AS_SYS_MEMORY stays off.
CONFIG_PSRAM=y
# CONFIG_PSRAM_AS_SYS_MEMORY is not set
CONFIG_XTAL_FREQ=12000000
CONFIG_TIMER_SUPPORT_ID_BITS=63
CONFIG_BK_JERRYSCRIPT=y
CONFIG_BK_JERRYSCRIPT_HEAP_IN_SRAM=y
CONFIG_BK_JERRYSCRIPT_HEAP_SIZE_KB=248
CONFIG_BK_JERRYSCRIPT_DEFAULT_TIMEOUT_MS=20000
CONFIG_BK_JERRYSCRIPT_TASK_STACK_SIZE=32768
CONFIG_BK_JERRYSCRIPT_UI=y
CONFIG_BK_JERRYSCRIPT_CLI=y
# CONFIG_BK_JERRYSCRIPT_AUTO_START is not set
# Scripts and applications live in a littlefs image on the usr_config partition,
# mounted automatically by the JS runtime.
CONFIG_LITTLEFS=y
CONFIG_LITTLEFS_USE_USR_CONFIG_PARTITION=y
CONFIG_VFS=y
CONFIG_BK_JERRYSCRIPT_FS=y
CONFIG_BK_JERRYSCRIPT_FS_AUTO_MOUNT=y
# Fail loudly instead of running the built-in demo when no app is found.
# CONFIG_BK_JERRYSCRIPT_BUILTIN_DEMO is not set
# Default: run the JS bundle converted to C (ap/js_bundle.c).  Enable this
# option to load the application from the littlefs image instead.
# CONFIG_LAUNCHER_JS_FROM_FS is not set
