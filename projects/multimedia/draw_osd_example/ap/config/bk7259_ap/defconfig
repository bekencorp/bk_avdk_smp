# ---- 本地 MIPI 摄像头通路（case5/6/7）：GC2053 CSI -> ISP MP NV12 -> GPU -> MIPI LCD ----
# 与 doorbell_lp `joint_test open mipi 1080p 30` / face_recognition 一致
# 摄像头 EVB 板使用 12MHz 晶振：GC2053 的 XCLK(24M) 由 AUXS_CIS 240M PLL /10 得到，
# 该 PLL 相对 XTAL 编程。板级默认 26M 会导致 MCLK 偏，sensor I2C 不应答（detect NULL）。
# 所有带 CSI 摄像头的示例工程(isp/dvp/usb/fisheye/video_player/kvs/pm_doorbell)均声明 12M。
CONFIG_XTAL_FREQ=12000000
CONFIG_ISP=y
CONFIG_MIPI_CSI=y
CONFIG_BK_CAMERA=y
CONFIG_CSI_CAMERA=y
CONFIG_CSI_GC2053=y

# ---- UVC 通路（case2/case4）：USB UVC 主机 + MJPEG 解码 ----
# 与 doorbell_lp 板保持一致：USB VBAT 由 GPIO32 软件控制（0x20），GPIO_32 需配成输出
CONFIG_USB=y
CONFIG_USB_VBAT_CONTROL_GPIO_ID=0x20
CONFIG_TASK_USB_PRIO=2
CONFIG_USB_HUB_MULTIPLE_DEVICES=y
CONFIG_USBHOST_HUB_MAX_EHPORTS=4
CONFIG_USBHOST_HUB_PORT_SUPPORT_MAX_DEVICE=5
CONFIG_USBHOST_HUB_PORT_1_VBAT_CONTROL_GPIO_ID=0xFF
CONFIG_USBH_UVC=y
CONFIG_USB_CAMERA=y
CONFIG_UVC_URB_NUM=8
CONFIG_UVC_NUM_PACKET_PER_URB=8
CONFIG_UVC_PROCESS_TASK_STACK_SIZE=1024
CONFIG_UVC_STREAM_TASK_STACK_SIZE=1536
CONFIG_UVC_FRAME_SIZE=409600
CONFIG_UVC_USE_PSRAM_ALLOC=y
CONFIG_BK_VCDEC=y
CONFIG_BK_DECODER=y
CONFIG_TASK_STACK_IN_PSRAM=y
CONFIG_QUEUE_IN_PSRAM=y
CONFIG_BK_USB_CHERRYUSB_V1_6=y