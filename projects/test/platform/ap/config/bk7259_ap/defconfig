#
# Automatically generated project default config. You can update it with menuconfig [D] option.
# This file contains only differences compared to board defconfig.
#
# Keep board AP defaults for boot-critical options (SOC_SMP / FREERTOS_SMP /
# PSRAM / L2_CACHE / DMA channel range). Do NOT steal CP DMA ch0-3
# (board uses DMA_LOGIC_CHAN_ID_MIN=4). Avoid AP-side TRUSTENGINE/PSA_MBEDTLS
# at boot — those are CP/security-test concerns and can block AP bring-up.
#

# CONFIG_LWIP is not set
# CONFIG_BK_NETIF is not set
# CONFIG_WIFI_CLI_DEBUG is not set
# CONFIG_WIFI_VNET_CONTROLLER is not set

CONFIG_SPI=y
CONFIG_SOC_SPI_UNIT_NUM=4
CONFIG_SPI_TEST=y
CONFIG_SPI_API_TEST=y
CONFIG_SPI_DMA=y
CONFIG_GENERAL_DMA=y
CONFIG_XTAL_FREQ=26000000

# --- driver test/api-test CLI switches (align with test/platform .it.csv, AP side) ---
CONFIG_PWM=y
CONFIG_PWM_TEST=y
CONFIG_PWM_API_TEST=y
CONFIG_UART2=y
CONFIG_UART_TEST=y
CONFIG_UART_API_TEST=y
CONFIG_I2C_API_TEST=y
CONFIG_FLASH_API_TEST=y
CONFIG_GPIO_API_TEST=y
CONFIG_GPIO_WAKEUP_SUPPORT=y
CONFIG_GPIO_DYNAMIC_WAKEUP_SUPPORT=y
CONFIG_ADC_API_TEST=y
