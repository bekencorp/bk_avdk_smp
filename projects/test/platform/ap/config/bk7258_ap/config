# Overwrite ARMINO Configuration here
CONFIG_OVERRIDE_FLASH_PARTITION=y

#
# SRAM
#
CONFIG_CP_SPE_RAM_SIZE=0x3C000
CONFIG_AP_APP_RAM_SIZE=0x64000
# end of SRAM

#
# PSRAM
#
CONFIG_PSRAM_HEAP_BASE=0x60720000
CONFIG_PSRAM_HEAP_SIZE=0xA0000
# end of PSRAM

#
# Mbedtls
#
CONFIG_PSA_MBEDTLS=y
CONFIG_FULL_MBEDTLS=y
CONFIG_MBEDTLS_USE_PSA_CRYPTO=n
CONFIG_TRUSTENGINE=y
CONFIG_SW_CRYPTO=n
CONFIG_TE200_ENTROPY=y
CONFIG_MBEDTLS_LOG_LEVEL="INFO"
CONFIG_AON_ENCP=y
CONFIG_PSA_MBEDTLS_TEST=n
CONFIG_TRUSTENGINE_TEST=y
# end of Mbedtls

CONFIG_GPIO_DEFAULT_SET_SUPPORT=y
CONFIG_USR_GPIO_CFG_EN=y