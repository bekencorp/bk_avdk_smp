# KCONFIG_GROUP: Multimedia::Video Codec::Encode
menu "BEKEN CODEC ENCODER"

	config BK_ENCODER
		bool "BEKEN CODEC ENCODER"
		default n
		help
			"BEKEN CODEC ENCODER for BK7259"

	config BK_ENCODER_H264_TASK_SIZE
		int "BK_ENCODER_H264_TASK_SIZE"
		default 10240
		
	config BK_ENCODER_MJPEG_TASK_SIZE
		int "BK_ENCODER_MJPEG_TASK_SIZE"
		default 10240

	config BK_ENCODER_H264_MAX_OUTPUT_BUFFER
		int "BK_ENCODER_H264_MAX_OUTPUT_BUFFER"
		default 512000
		depends on BK_ENCODER
		help
			"Maximum H.264 encoder output buffer size in bytes"

	config BK_ENCODER_MJPEG_MAX_OUTPUT_BUFFER
		int "BK_ENCODER_MJPEG_MAX_OUTPUT_BUFFER"
		default 262144
		depends on BK_ENCODER
		help
			"Maximum MJPEG/JPEG encoder output buffer size in bytes"

	config VIDEO_DTCM
		bool "Use DTCM video codec libraries"
		default n
		depends on BK_ENCODER
		help
			"Select DTCM prebuilt libraries for video codec helpers"

	config VIDEO_DTCM_ALL
		bool "Use full DTCM video codec libraries"
		default n
		depends on VIDEO_DTCM
		help
			"Select full DTCM prebuilt libraries instead of the partial DTCM variant"

	config H264_ENCODER_USE_OS_MALLOC
		bool "H264 Encoder Use OS Malloc"
		default n
		depends on BK_ENCODER
		help
			"Use OS malloc for encoder memory allocation instead of frame buffer"

	config H264E_STREAM_SESSION
		bool "H264E stream session (h264EScream RPC)"
		default n
		depends on BK_ENCODER
		depends on BK_NTWK_TRANSFER
		help
			"Enable H264E stream module. JSON-RPC control uses h264EScream.* methods; VIDEO channel sends H264 elementary stream."

	config ENCODER_H264_CLK_240M
		bool "H264 encoder clock 240MHz"
		default n
		depends on BK_ENCODER
		help
			"Select CKSEL_H264_240M (highest supported encoder frequency).
			When disabled, CKSEL_H264_80M is used."

	config BK_ENCODER_HW_TASK_PRIORITY
		int "Hardware encoder worker task priority (smaller = higher)"
		default 2
		range 0 9
		help
			"Priority of the shared hardware encoder worker task (hw_encoder),
			which runs vcenc_h264_encode_frame and the per-frame done callback.
			BEKEN convention: a SMALLER number means HIGHER scheduling priority.
			Default 2 matches the historical library value. Raising it (i.e.
			decreasing the number) above the network/WiFi tasks reduces the
			encode-start scheduling latency that can starve the ISP flexa FIFO."

	config BK_ENCODER_H264_FRAME_TASK_PRIORITY
		int "H.264 frame encode task priority (smaller = higher)"
		default 6
		range 0 9
		depends on BK_ENCODER
		help
			"Priority of the H.264 whole-frame control task (h264e_encoder,
			created in bk_h264_encode_frame_ctlr.c). BEKEN convention: a
			SMALLER number means HIGHER scheduling priority. Default 6 preserves
			the historical BEKEN_DEFAULT_WORKER_PRIORITY behavior."

	config BK_ENCODER_H264_HW_FLEXA_TASK_PRIORITY
		int "H.264 hardware-flexa encode task priority (smaller = higher)"
		default 2
		range 0 9
		depends on BK_ENCODER
		help
			"Priority of the H.264 HARDWARE-flexa control task (h264e_encoder,
			created in bk_h264_encode_hw_flexa_ctlr.c). This is distinct from the
			software-flexa path. BEKEN convention: a SMALLER number means HIGHER
			scheduling priority. Default 2 matches the historical library value."

	config BK_H264E_DEBUG_SEI
		bool "Insert debug SEI NAL into each H264 frame (transport diagnostics)"
		default n
		depends on BK_ENCODER
		help
			"Append a fixed user_data_unregistered SEI (payloadType=5) to every
			encoded H.264 frame carrying per-frame sequence/length/CRC32/timestamp
			so a receiver can detect frame loss, reorder, truncation and corruption
			without decoding. Disabled by default; enable only for debugging."

	config BK_H264E_DEBUG_SEI_CRC
		bool "Compute per-frame CRC32 in debug SEI (costly: scans whole frame)"
		default n
		depends on BK_H264E_DEBUG_SEI
		help
			"When enabled, the debug SEI carries a CRC32 over the whole encoded
			frame so a receiver can detect corruption. Computing it reads the
			entire frame from PSRAM byte by byte and is time-consuming (it eats
			into the encoder inter-frame slack). Disable to skip the scan and put
			payload_crc = 0 when only sequence/length diagnostics are needed."

endmenu
