# KCONFIG_GROUP: Wireless Connectivity::Bluetooth
menu "Bk_ble"
	config BLUETOOTH_AP
		bool "bluetooth ap"
		default y

    config BLUETOOTH_HOST_ONLY
		bool "bluetooth host only"
		depends on BLUETOOTH_AP
		default y

	config BT
		bool "Enable Bt"
		depends on BLUETOOTH_HOST_ONLY
		default n

	config BLE
		bool "Enable Ble"
		depends on (BLUETOOTH_HOST_ONLY || BLUETOOTH_SUPPORT_AP_PWD_ALL)
		default y

	config BLE_LE_AUDIO
		bool "Enable LE Audio"
		depends on BLE && BLUETOOTH_BTDM_COMPONENT_ENABLE
		default n
		help
			Enable LE Audio BAP/Broadcast APIs on top of the dual-mode
			Ethermind host. This is required by projects/bluetooth/le_audio.
			When enabled, the AP side links the Ethermind host_dm library even
			if classic BT application APIs are disabled with CONFIG_BT=n.

	config BLUETOOTH_AUTO_ENABLE
		bool "bluetooth auto enable"
		depends on BLUETOOTH_AP
		default y


	config BLUETOOTH_MULTI_CONTROLLER
		bool "multi bluetooth controller"
		depends on (BLE || BT)
		default n

	choice BLUETOOTH_MULTI_CONTROLLER_MODE
		prompt "multi bluetooth controller mode"
		depends on BLUETOOTH_MULTI_CONTROLLER
		default BLUETOOTH_MULTI_CONTROLLER_MODE_PRI_ALL_SEC_NONE

		config BLUETOOTH_MULTI_CONTROLLER_MODE_PRI_ALL_SEC_NONE
			bool "primary all, secondary none"
		config BLUETOOTH_MULTI_CONTROLLER_MODE_PRI_NONE_SEC_ALL
			bool "primary none, secondary all"
		config BLUETOOTH_MULTI_CONTROLLER_MODE_PRI_BLE_SEC_BT
			bool "primary ble, secondary bt"
		config BLUETOOTH_MULTI_CONTROLLER_MODE_PRI_BT_SEC_BLE
			bool "primary bt, secondary ble"
	endchoice

	config BLUETOOTH_HOST_ENABLE_H5
		bool "host enable h5"
		depends on (BLUETOOTH_MULTI_CONTROLLER_MODE_PRI_NONE_SEC_ALL || BLUETOOTH_MULTI_CONTROLLER_MODE_PRI_BLE_SEC_BT || BLUETOOTH_MULTI_CONTROLLER_MODE_PRI_BT_SEC_BLE)
		default n

	config BLUETOOTH_RELEASE_CODESIZE
		bool "reduce ble stack size"
		depends on BLE
		default n
		help
			This option is used to reduce ble stack size for IoT scenarios that
			only use ble provisioning network.It supports two ble advertise,
			one ble link, and ble scan at the same time.it does not support SMP and central role.
			when config this option,BLUETOOTH_BLE_SLAVE_ONLY will be invalid.

	config BLUETOOTH_BLE_SLAVE_ONLY
		bool "only supports ble slave"
		depends on !BLUETOOTH_RELEASE_CODESIZE
		default n

	config BLUETOOTH_BLE_SLAVE_OBSERVER
		bool "only supports ble slave and observer"
		depends on !BLUETOOTH_RELEASE_CODESIZE
		default n

    config BLUETOOTH_BLE_DISCOVER_AUTO
        bool "auto ble discover. Only used when single ble host"
        default y

    config BLUETOOTH_SUPPORT_IPC
        bool "bt support ipc"
		depends on BLUETOOTH_AP
        default y

    config BLUETOOTH_SUPPORT_AP_PWD_ALL
        bool "bluetooth support ap power down all"
		depends on BLUETOOTH_SUPPORT_IPC
        default n

	config BLUETOOTH_BTDM_COMPONENT_ENABLE
		bool "bluetooth dual component enable"
		default n

	menu "bluetooth dm BLE Modules"
		depends on BLE && BT

		config BLUETOOTH_BTDM_COMPONENT_BLE_GATT
			bool "Enable bt_dm/ble/gatt public framework"
			default y
			help
				Public GATT framework (dm_gatt / dm_gatts / dm_gattc / dm_gatt_connection
				/ dm_gap_utils) used by AT Server and by downstream demos such as
				dashboard wifi_boarding and bt_dm/ble/hogpd. Its include directory
				(bt_dm/ble/gatt) is exposed to other components that PRIV_REQUIRES
				bk_bluetooth.

		config BLUETOOTH_BTDM_COMPONENT_BLE_USE_STORAGE
			bool "GATT uses bluetooth_storage to persist bond information"
			depends on BLUETOOTH_BTDM_COMPONENT_BLE_GATT
			default n

		config BLUETOOTH_BTDM_COMPONENT_BLE_GATTS_TEST_ATTR
			bool "Enable GATTS test attribute table"
			depends on BLUETOOTH_BTDM_COMPONENT_BLE_GATT
            default n

		config BLUETOOTH_BTDM_COMPONENT_BLE_GATT_LOG_LEVEL
			int "GATT module log level (0=ERR..4=VERBOSE)"
			depends on BLUETOOTH_BTDM_COMPONENT_BLE_GATT
			range 0 4
			default 2

		config BLUETOOTH_BTDM_COMPONENT_BLE_HOGPD
			bool "Enable bt_dm/ble/hogpd demo (HID-over-GATT keyboard)"
			depends on BLUETOOTH_BTDM_COMPONENT_BLE_GATT
			default n

		config BLUETOOTH_BTDM_COMPONENT_BLE_HOGPD_LOG_LEVEL
			int "HOGPD demo log level (0=ERR..4=VERBOSE)"
			depends on BLUETOOTH_BTDM_COMPONENT_BLE_HOGPD
			range 0 4
			default 2
	endmenu
endmenu
