# KCONFIG_GROUP: System Services::Firmware Update
menu "Ota"
	config OTA_FUNCTION
		bool "Enable do ota function"
		default n
		help
			enable do ota function

	config HTTP_AB_PARTITION
		bool "Enable Http AB Partition"
		default n
		help
			enable http update ab partition
	config OTA_HTTP
		depends on HTTP
		bool "Enable Ota Http"
		default y if NO_HOSTED
		default n if !NO_HOSTED
		help
			Enable HTTP OTA. Requires CONFIG_HTTP (which itself requires LWIP_V2_1),
			because the implementation calls httpclient_common() from utils_httpc.c.
	config OTA_HTTPS
		depends on LWIP
		bool "Enable Https ota"
		default n
		help
			enable https ota
	config OTA_HASH_FUNCTION
		bool "Enable ota hash function"
		default n
		help
			enable ota hash function
	config OTA_DEBUG_LOG_OPEN
		bool "Enable ota debug log open"
		default n
		help
			enable ota debug log open
	config OTA_POSITION_INDEPENDENT_AB
		depends on HTTP_AB_PARTITION
		bool "Enable ota position independent update"
		default n
		help
			enable ota position independent update
	config BLE_OTA_WAIT_TIMEOUT
		int "ble ota wait time(ms)"
		default 3000

	config OTA_DISPLAY_PICTURE_DEMO
		bool "Enable display picture when do ota position independent update"
		default n
		help
			enable display picture when do ota position independent update
	config SECURE_OTA_XIP
		bool "Enable secure XIP A/B OTA on the non-secure OTA framework"
		default n
		help
			Secure OTA that stages the ciphertext image into the inactive
			DIRECT_XIP slot (secondary_all/primary_all) via non-secure flash
			writes and arms a boot_param TRIAL record; BL2 does EC-P256
			verification and rollback. Built on top of ota.c/ota_common.c/
			ota_base_drv.c, and does NOT use CONFIG_SECURITY_OTA / TFM FWU.
	config SECURE_OTA_OVERWRITE
		bool "Enable compressed-overwrite OTA on the non-secure OTA framework"
		default n
		help
			Secure OTA for the OVERWRITE_ONLY strategy (secureboot_overwrite):
			stages the compressed + BL2-signed image into the `ota` staging
			partition via non-secure flash writes and arms the OVERWRITE_CONFIRM
			magic in `ota_control`; on the next reset BL2 decompresses `ota`
			into `primary_all` and does EC-P256 verification. Built on top of
			ota.c/ota_common.c/ota_base_drv.c, and does NOT use
			CONFIG_SECURITY_OTA / TFM FWU. Mutually exclusive with
			CONFIG_SECURE_OTA_XIP.
endmenu
