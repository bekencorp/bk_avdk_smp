# KCONFIG_GROUP: Multimedia::Display & UI::LCD
menu "DSI LCD"
	config LCD_DSI
		depends on BK_PERIPHERAL
		bool "Enable LCD_DSI intf"
		default n

	config LCD_FRD700B30023_MIPI_1024x600
		depends on LCD_DSI
		bool "Enable LCD_FRD700B30023_MIPI_1024x600 API"
		default n

	config LCD_GH8555BL_MIPI_800x1280
		depends on LCD_DSI
		bool "Enable LCD_GH8555BL_MIPI_800x1280 API"
		default n

	config LCD_HX8394F_MIPI_720x1280
		depends on LCD_DSI
		bool "Enable LCD_HX8394F_MIPI_720x1280 API"
		default n

	config LCD_HX8399C_MIPI_1080x1920
		depends on LCD_DSI
		bool "Enable LCD_HX8399C_MIPI_1080x1920 API"
		default n

	config LCD_EK79007AD_MIPI_1024x600
		depends on LCD_DSI
		bool "Enable LCD_EK79007AD_MIPI_1024x600 API"
		default n

	config LCD_FL7703NP_MIPI_720x1280
		depends on LCD_DSI
		bool "Enable LCD_FL7703NP_MIPI_720x1280 API"
		default n

	config LCD_FL7703_MIPI_720x1280
		depends on LCD_DSI
		bool "Enable LCD_FL7703_MIPI_720x1280 API"
		default n

	config LCD_ER68576B_MIPI_720x1280
		depends on LCD_DSI
		bool "Enable LCD_ER68576B_MIPI_720x1280 API"
		default n

	config LCD_GC9702_MIPI_720x1280
		depends on LCD_DSI
		bool "Enable LCD_GC9702_MIPI_720x1280 API"
		default n

	config LCD_JD9522Z_MIPI_1080x1920
		depends on LCD_DSI
		bool "Enable LCD_JD9522Z_MIPI_1080x1920 API"
		default n

	config LCD_JD9855_MIPI_320x385
		depends on LCD_DSI
		bool "Enable LCD_JD9855_MIPI_320x385 API"
		default n

	config LCD_CO5300_MIPI_320x360
		depends on LCD_DSI
		bool "Enable LCD_CO5300_MIPI_320x360 API"
		default n

	config LCD_ST7701SN_MIPI_360x640
		depends on LCD_DSI
		bool "Enable LCD_ST7701SN_MIPI_360x640 API"
		default n

	config LCD_ST7701S_MIPI_412x960
		depends on LCD_DSI
		bool "Enable LCD_ST7701S_MIPI_412x960 API"
		default n

	config LCD_ST7701SN_MIPI_480x640
		depends on LCD_DSI
		bool "Enable LCD_ST7701SN_MIPI_480x640 API"
		default n

	config LCD_ST7701SN_MIPI_480x854
		depends on LCD_DSI
		bool "Enable LCD_ST7701SN_MIPI_480x854 API"
		default n
	config LCD_LT8912B_MIPI_BRIDGE
		depends on LCD_DSI
		bool "Enable LCD_LT8912B_MIPI_BRIDGE"
		default n

	if LCD_LT8912B_MIPI_BRIDGE
	choice
		prompt "LT8912B HDMI resolution"
		default LCD_LT8912B_RES_1280x720
		config LCD_LT8912B_RES_800x600
			bool "800x600@60Hz"
		config LCD_LT8912B_RES_1024x768
			bool "1024x768@60Hz"
		config LCD_LT8912B_RES_1280x720
			bool "1280x720@60Hz"
		config LCD_LT8912B_RES_1280x800
			bool "1280x800@60Hz"
		config LCD_LT8912B_RES_1920x1080
			bool "1920x1080@30Hz"
	endchoice

	# LT8912B I2C pins are intentionally configured in this driver's own
	# Kconfig (and not in the generic display board config) so that the
	# bridge stays self-contained: the bk_display / panel common code
	# never sees, allocates, or forwards a "side-channel I2C" object -
	# that whole bus belongs to the bridge IC alone.
	# Defaults match the BK7259 EVB wiring; override per-board via
	# defconfig if your board routes LT8912B SCL/SDA differently.
	config LCD_LT8912B_PIN_SCL
		depends on LCD_LT8912B_MIPI_BRIDGE
		int "LT8912B I2C SCL GPIO"
		default 69
		help
		  GPIO index used for the LT8912B-private software I2C SCL
		  line. Consumed by sw_i2c_init() inside lcd_mipi_lt8912b_bridge.c.

	config LCD_LT8912B_PIN_SDA
		depends on LCD_LT8912B_MIPI_BRIDGE
		int "LT8912B I2C SDA GPIO"
		default 70
		help
		  GPIO index used for the LT8912B-private software I2C SDA
		  line. Consumed by sw_i2c_init() inside lcd_mipi_lt8912b_bridge.c.

	config LCD_LT8912B_AVI_ENABLE
		depends on LCD_LT8912B_MIPI_BRIDGE
		bool "Enable LT8912B AVI infoframe and audio IIS config"
		default n

	config LCD_LT8912B_LVDS_ENABLE
		depends on LCD_LT8912B_MIPI_BRIDGE
		bool "Enable LT8912B LVDS scaler config and disable LVDS output"
		default n
	endif
endmenu