menu "App"

	config DEMO_TEST
		bool "Enable Demo Test"
		default n

	#TODO does UPGRADE here means OTA?
	config FTPD_UPGRADE
		bool "Enable Ftpd Upgrade"
		default n

	config OTA_HTTP
		depends on HTTP
		bool "Enable Ota Http"
		default y if NO_HOSTED
		default n if !NO_HOSTED
		help
			Enable HTTP OTA. Requires CONFIG_HTTP (which itself requires LWIP_V2_1),
			because the implementation calls httpclient_common() from utils_httpc.c.

	#TODO what's the relationship between HTTP and TFTP OTA, exculsive?
	config OTA_TFTP
		bool "Enable Ota Tftp"
		default n

	config NTP_SYNC_RTC
		depends on AON_RTC
		bool "Enable Ntp Sync Rtc"
		default n

	config SECURITY_OTA
		bool "Enable Seucirty Ota API"
		default n

	config AP_EMUBOOT
		bool "Enable AP EMUBOOT project"
		default n

	config NTP_SYNC_RTC_TASK_STACK_SIZE
		int "Set NTP Sync Task Stack Size"
		default 3072
		help
			Stack size of NTP Sync task

	config RTC_NTP_TIMEZONE
		int "NTP local timezone offset from UTC (hours)"
		default 8
		range -12 14
		depends on NTP_SYNC_RTC
		help
			Applied after NTP returns UTC: local_time = utc + (RTC_NTP_TIMEZONE * 3600).
			Example: 8 for China Standard Time (UTC+8), -5 for US Eastern standard time.

	config FTP_SERVER
		bool "Enable FTP server"
		default n

	config FTP_USE_PSARM_MEM
		bool "FTP use psram memory"
		depends on PSRAM
		default y
endmenu
