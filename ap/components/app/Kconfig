# KCONFIG_GROUP: System Services::Application Services
menu "App"

	config DEMO_TEST
		bool "Enable Demo Test"
		default n

	#TODO does UPGRADE here means OTA?
	config FTPD_UPGRADE
		bool "Enable Ftpd Upgrade"
		default n

	#TODO what's the relationship between HTTP and TFTP OTA, exculsive?
	config OTA_TFTP
		bool "Enable Ota Tftp"
		default n

	config NTP_SYNC_RTC
		depends on AON_RTC
		bool "Enable Ntp Sync Rtc"
		default n

	config AP_EMUBOOT
		bool "Enable AP EMUBOOT project"
		default n

	config NTP_SYNC_RTC_TASK_STACK_SIZE
		int "Set NTP Sync Task Stack Size"
		default 3072
		help
			Stack size of NTP Sync task

	config RTC_NTP_TIMEZONE
		int "NTP local timezone offset from UTC (hours)"
		default 8
		range -12 14
		depends on NTP_SYNC_RTC
		help
			Applied after NTP returns UTC: local_time = utc + (RTC_NTP_TIMEZONE * 3600).
			Example: 8 for China Standard Time (UTC+8), -5 for US Eastern standard time.

	config FTP_SERVER
		bool "Enable FTP server"
		default n

	config FTP_USE_PSARM_MEM
		bool "FTP use psram memory"
		depends on PSRAM
		default y

	config ALI_MQTT
		depends on LWIP
		bool "Enable Ali Mqtt"
		default n

	config COREMQTT
		depends on LWIP
		bool "Enable coreMQTT Client (MQTT 5.0)"
		default n
		help
			Enable Amazon coreMQTT v5 library with lightweight FreeRTOS port.
			Do not enable together with Paho MQTT.

	config COREMQTT_THREAD_STACK_SIZE
		depends on COREMQTT
		int "coreMQTT worker thread stack size (bytes)"
		default 6144 if COREMQTT_TLS
		default 4096
		range 2048 8192

	config COREMQTT_NETWORK_BUFFER_SIZE
		depends on COREMQTT
		int "coreMQTT network buffer size (bytes)"
		default 1024
		range 512 4096

	config COREMQTT_MAX_INFLIGHT
		depends on COREMQTT
		int "Max in-flight QoS1/2 messages"
		default 5
		range 1 10

	config COREMQTT_TLS
		depends on COREMQTT && PSA_MBEDTLS
		bool "Enable coreMQTT MQTTS (TLS)"
		default y
		help
			Enable TLS transport for coreMQTT (mqtts:// or port 8883).

	config COREMQTT_TLS_VERIFY_SERVER
		depends on COREMQTT_TLS
		bool "Verify MQTTS server certificate"
		default n
		help
			When disabled, broker certificate is not verified (dev only).

	config PAHO_MQTT
		depends on LWIP
		bool "Enable Paho MQTT Client"
		default n
		help
			Enable Eclipse Paho MQTT client library for IoT communication

	config PAHO_MQTT_TLS
		depends on PAHO_MQTT && PSA_MBEDTLS
		bool "Enable Paho MQTT TLS Support"
		default n
		help
			Enable TLS/SSL encryption support for Paho MQTT client
endmenu
