# KCONFIG_GROUP: Multimedia::Display & UI::LVGL
menu "LVGL"
    config LVGL
        bool "Enable Lvgl"
        default n

    choice LVGL_VERSION
        depends on LVGL
        prompt "Select LVGL Version"
        default LVGL_V8

        config LVGL_V8
            bool "LVGL V8"
        config LVGL_V9
            bool "LVGL V9"
    endchoice

    config LV_USE_PERF_MONITOR
        bool "Enable Lv Use Perf Monitor"
        default n
        help
            Show CPU usage and FPS count

    config LV_COLOR_16_SWAP
        depends on LVGL
        bool "Enable Swap the 2 bytes of RGB565 color"
        default n

    config LVGL_MEM_USE_PSRAM
        depends on LVGL
        bool "Use PSRAM for LVGL internal memory allocation"
        default n
        help
            Use PSRAM for LVGL's lv_malloc/lv_realloc/lv_free backend.
            The default is HSRAM for better latency.

    config LVGL_USE_KEYPAD
        depends on LVGL
        bool "Enable LVGL keypad input device"
        default n
        help
            Enable the generic LVGL keypad input device. Board-specific keypad
            drivers should translate hardware key events to LV_KEY_* values and
            submit them through lv_vendor_keypad_send_key*().

    config LV_IMG_UTILITY_CUSTOMIZE
        depends on LVGL && VFS
        bool "Enable custom image load utility for JPEG/PNG"
        default n

    config LVGL_TASK_PRIORITY
        depends on LVGL
        int "Set lvgl task priority"
        default 4

    config LVGL_TASK_STACK_SIZE
        depends on LVGL
        int "Set lvgl task stack size"
        default 8192
        help
            If LV_USE_DRAW_VG_LITE is enabled, the stack size require a larger size.

    config LVGL_TASK_SLEEP_TIME_CUSTOMIZE
        depends on LVGL
        bool "Enable lvgl task sleep time custimize"
        default n

    config LVGL_TASK_SLEEP_TIME
        depends on LVGL_TASK_SLEEP_TIME_CUSTOMIZE
        int "Set lvgl task sleep time"
        default 10

    config LVGL_FRAME_BUFFER_NUM
        depends on LVGL
        int "Set the display frame buffer number"
        default 2

    config LVGL_USE_GPU_ROTATE
        depends on LVGL
        bool "Enable LVGL Use GPU Rotate"
        default n
endmenu
