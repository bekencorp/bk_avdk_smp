# KCONFIG_GROUP: Storage::File System
menu "FATFS"
	config FATFS
		bool "Support FATFS"
		depends on FATFS_SDCARD || FATFS_SPI_0_FLASH || FATFS_SPI_1_FLASH || FATFS_QSPI_0_FLASH || FATFS_QSPI_1_FLASH
		default n

	config FATFS_SDCARD
		bool "Support FATFS with SDCARD"
		depends on SDCARD
		default n
		help
			BEKEN Chip sets SDIO as a master device, the slave device is a SDCARD/SD-NAND.
			The SDCARD/SD-NAND memory device is mounted with FATFS.
			The application can read/writes data to SDCARD/SD-NAND by FATFS file system API, or the upper layer of VFS posix API.

	config FATFS_INTERNAL_FLASH
		bool "Support FATFS with INTERNAL FLASH"
		default n
		help
			BEKEN Chip internal flash set the user's partition, which is mounted with FATFS.
			The application can read/writes data to user partition by FATFS file system API, or the upper layer of VFS posix API.
			Because the internal flash stores CPU instructions and data, it is not recommended to write data to it frequently.

	config FATFS_SPI_0_FLASH
		bool "Support FATFS with SPI-0 FLASH"
		depends on SPI_MST_FLASH
		default n
		help
			BEKEN Chip sets SPI-0 as master device, the slave device is a flash.
			The flash device is mounted with FATFS.
			The application can read/writes data to flash by FATFS file system API, or the upper layer of VFS posix API.

	config FATFS_SPI_1_FLASH
		bool "Support FATFS with SPI-1 FLASH"
		depends on SPI_MST_FLASH
		default n
		help
			BEKEN Chip sets SPI-1 as master device, the slave device is a flash.
			The flash memory device is mounted with FATFS.
			The application can read/writes data to flash by FATFS file system API, or the upper layer of VFS posix API.

	config FATFS_QSPI_0_FLASH
		bool "Support FATFS with QSPI-0 FLASH/NAND"
		depends on QSPI_NOR_FLASH || QSPI_NAND_FLASH
		default n
		help
			BEKEN Chip sets QSPI-0 as master device, the slave device is a flash.
			The flash device is mounted with FATFS.
			When the QSPI device is SPI-NAND (QSPI_NAND_FLASH), this drive is
			served through the Dhara FTL (see CONFIG_DHARA_FTL): 512B logical
			sectors with wear levelling, power-fail-safe mapping and bad-block
			handling, so FAT can be used safely on NAND and exported to a PC over
			USB MSC. With NOR (QSPI_NOR_FLASH) it uses the linear NOR path.
			The application can read/writes data to flash by FATFS file system API, or the upper layer of VFS posix API.

	config FATFS_QSPI_1_FLASH
		bool "Support FATFS with QSPI-1 FLASH/NAND"
		depends on QSPI_NOR_FLASH || QSPI_NAND_FLASH
		default n
		help
			BEKEN Chip sets QSPI-1 as master device, the slave device is a flash.
			The flash device is mounted with FATFS.
			When the QSPI device is SPI-NAND (QSPI_NAND_FLASH), this drive is
			served through the Dhara FTL (see CONFIG_DHARA_FTL); with NOR it uses
			the linear NOR path.
			The application can read/writes data to flash by FATFS file system API, or the upper layer of VFS posix API.
endmenu

