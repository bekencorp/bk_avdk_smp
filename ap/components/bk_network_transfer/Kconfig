# KCONFIG_GROUP: Network Services::Transfer
menu "Bk Network Transfer"

	config BK_NTWK_TRANSFER
		bool "Enable BK Network Transfer"
		default y
		help
			Enable BK Network Transfer

	config MEDIA_DROP_STRATEGY_ENABLE
		bool "Enable Media Drop Strategy"
		default y
		help
			Enable media drop strategy

	config NTWK_VIDEO_FPS_CALC_ENABLE
		bool "Enable Network Video FPS Calculation"
		default y
		help
			Enable the common video transfer FPS calculation strategy.

	config NTWK_H264_DROP_POLICY
		bool "Enable Network H264 Backpressure Drop Policy"
		depends on BK_NTWK_TRANSFER
		default y
		help
			Enable H264 encoded frame dropping when the encoded-frame free queue is low.

	config NTWK_CS2_CONGESTION_DROP
		bool "Enable CS2 backlog-triggered per-session drop + force IDR"
		depends on BK_NTWK_TRANSFER
		depends on CS2_P2P_SERVER || CS2_P2P_CLIENT
		default n
		help
			CS2 backlog-triggered drop policy.
			The policy checks each subscribed session's CS2 TX buffer before
			fanout:
			  - sessions with room receive the current packet;
			  - congested sessions skip the whole frame, enter waiting_key,
			    and resume only on a keyframe after backlog drains;
			  - audio packets are skipped per session when the audio backlog
			    exceeds its threshold.
			If all subscribed sessions are congested, the encoder-output side
			can drop the whole H264 frame before it enters the ready queue.
			Recovery uses one shared force-IDR arbiter with gap/streak limits.

	config NTWK_CS2_DROP_START_THD
		int "CS2 congestion drop START watermark (bytes)"
		depends on NTWK_CS2_CONGESTION_DROP
		default 131072
		help
			Start dropping when the worst session video backlog reaches this
			high watermark. Suggested around CONFIG_CS2_TX_BUFFER_THD/2.

	config NTWK_CS2_DROP_STOP_THD
		int "CS2 congestion drop STOP watermark (bytes)"
		depends on NTWK_CS2_CONGESTION_DROP
		default 65536
		help
			Stop dropping and request a force IDR when the backlog drains to
			this low watermark. Must be lower than START to give hysteresis and
			leave room for one large I frame.

	config NTWK_CS2_HEALTHY_FRAMES
		int "CS2 congestion healthy frame count to reset force-IDR streak"
		depends on NTWK_CS2_CONGESTION_DROP
		default 25

	config NTWK_CS2_FORCE_IDR_MIN_GAP_MS
		int "CS2 congestion force IDR minimum interval (ms)"
		depends on NTWK_CS2_CONGESTION_DROP
		default 500

	config NTWK_CS2_FORCE_IDR_MAX_STREAK
		int "CS2 congestion force IDR max consecutive count"
		depends on NTWK_CS2_CONGESTION_DROP
		default 3
		help
			After this many consecutive forced IDRs without a healthy period,
			stop forcing IDR (persistently slow, T2) and fall back to natural
			keyframe recovery / business-layer degrade.

	config DATA_NODE_SIZE
		int "Video RX Node Size"
		default 1472
		help
			Video receive node size in bytes

	config DATA_POOL_LEN
		int "Video Pool Length"
		default 51520
		help
			Video pool length in bytes (default: 1472 * 35 = 51520)

	config NTWK_UNFRAGMENT_FRAME_SIZE
		int "Video RX unfragment frame buffer size"
		depends on BK_NTWK_TRANSFER
		default 102400
		help
			Buffer size in bytes allocated to reassemble one complete
			received video frame (default: 100 * 1024 = 102400).
			Independent of codec type (JPEG/H264/etc). Projects can
			override this via menuconfig or defconfig.

	config NTWK_USE_PSARM_MEM
		bool "Use PSRAM for Network Transfer Memory Allocation"
		depends on PSRAM
		default n
		help
			Use PSRAM for memory allocation in network transfer component

	config NTWK_CLIENT_SERVICE_ENABLE
		bool "Enable Network Client Service"
		default n
		help
			Enable network client service

	config NTWK_CTRL_CHAN_JSON
		bool "Enable control channel JSON framing"
		depends on BK_NTWK_TRANSFER
		default n
		help
			Frame control-channel JSON methods in the common network transfer layer.
			When enabled, one application JSON method can be split across multiple
			transport packets and is reassembled before the application callback.
			When disabled, the existing control-channel pack/unpack path is used.

	config NTWK_CTRL_JSON_RX_MAX_SIZE
		int "Control channel max JSON method size"
		depends on NTWK_CTRL_CHAN_JSON
		default 8192
		help
			Maximum complete JSON method size accepted by the common JSON
			reassembly layer.

	config NTWK_PKT_USE_PSARM_MEM
		bool "Use PSRAM for Network Transfer Packet Memory Allocation"
		depends on PSRAM
		default y
		help
			Use PSRAM for packet memory allocation in network transfer component

	config KVS_NTWK_BRIDGE
		bool "Bridge KVS WebRTC to bk_network_transfer (cmd=data channel, A/V=RTP)"
		depends on BK_NTWK_TRANSFER
		depends on KVS_AWS
		depends on KVS_AWS_DATA_CHANNEL
		default n
		help
			Maps SampleStreamingSession to ntwk_trans_* (passthrough payloads).
			Enables hooks in projects/kvs_aws_sample/ap/Common.c.

endmenu
