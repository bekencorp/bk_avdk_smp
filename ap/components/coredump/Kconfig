# KCONFIG_GROUP: Debug::Coredump
menu "Coredump"
	config CM_BACKTRACE
		bool "Enable Cm Backtrace"
		default n

	config DUMP_ENABLE
			bool "Enable Dump Feature"
			default n
			help
				Dump all memory when exception happen

	config MEMDUMP_ALL
			bool "Enable Memdump All"
			default n
			help
				Dump all memory when exception happen

	config AP_HANDOFF_CP_REBOOT_BUDGET_MS
			int "AP wait budget for CP reboot after dump handoff (ms)"
			depends on DEBUG_VERSION || DUMP_ENABLE
			range 500 7500
			default 6000
			help
				After the AP hands its trap dump to the CP, it waits this long
				for the CP to dump AP memory and reset the board. If the CP does
				not reset within the budget the AP self-dumps its own memory and
				resets (P0-1 fallback). Board-tuned (FI-2): must exceed the
				worst-case healthy CP dump time yet stay below the AON-WDT period
				(8000ms) so the fallback runs before the AON-WDT fires.

	config CP_HANG_DUMP_BY_AP
			bool "Enable AP-side CP hang dump feature"
			depends on IPI && (DEBUG_VERSION || DUMP_ENABLE)
			default y
			help
				Production reliability feature (requires dump to be enabled).
				CP sends a private IPI heartbeat to AP. If AP observes CP
				heartbeat timeout, AP dumps CP-visible context (from the
				unified manifest) and reboots the board without relying on the
				CP - covering the "CP wedged and not answering mailbox" case
				that the AP->CP handoff fallback (P0-1) cannot self-heal.

	config CP_HANG_DUMP_BY_AP_PERIOD_MS
			int "CP to AP debug heartbeat period(ms)"
			depends on CP_HANG_DUMP_BY_AP
			default 1000

	config CP_HANG_DUMP_BY_AP_MEMDUMP
			bool "Dump CP memory windows after CP heartbeat timeout"
			depends on CP_HANG_DUMP_BY_AP
			default y
			help
				Keep disabled until the CP memory ranges are verified on
				the target board. Register/peripheral dump remains enabled.

	config DUMP_UART_PRINT_PORT
		int "Config DumpUart Print Port"
		range 0 5
		default 0
		help
			Default 0 mean use UART0

	choice DUMP_UART_MEM_ENCODING
		prompt "Config DumpUart Memory Encoding"
		default DUMP_UART_MEM_ENCODING_ASCII
		help
			Default ASCII format

		config DUMP_UART_MEM_ENCODING_ASCII
			bool "ASCII"
			help
				Dump memory in ASCII format
		config DUMP_UART_MEM_ENCODING_BASE64
			bool "Base64"
			help
				Dump memory in Base64 format
	endchoice

	choice DUMP_BY_UART
		prompt "Dump output method"
		default DUMP_BY_LOG_UART
		help
			Dump output method
		config DUMP_BY_LOG_UART
			bool "Log UART"
			help
				Dump to log UART
		config DUMP_BY_FLASH
			bool "Flash"
			help
				Dump to flash
	endchoice

	config TRAP_TEST
			bool "Enable trap test"
			default n
			help
				trap test
endmenu
