CONFIG_SUPPORT_L1_CACHE=y
CONFIG_L2_CACHE_ENABLE=y
CONFIG_DUMP_ENABLE=y
CONFIG_MEMDUMP_ALL=y
# CONFIG_TRAP_TEST is not set
