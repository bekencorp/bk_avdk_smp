menu "SDIO_FUNC"
	config SDIO_FUNC
		bool "Enable SDIO function (peripheral) core"
		default n
		depends on SDIO_V3P0
		help
		  SDIO peripheral (I/O card) core built on top of the generic SDIO
		  host controller interface (<driver/sdio_host.h>). Provides Linux-like
		  CMD52/CMD53 access (sdio_readb/writeb, block transfers), function
		  enable, block size and async interrupt handling. Requires the SDIO
		  host controller (CONFIG_SDIO_V3P0).

	config SDIO_FUNC_HOST_ID
		int "Default SDIO host controller for the SDIO peripheral (0/1)"
		depends on SDIO_FUNC
		default 0
		help
		  Default controller used by bk_sdio_func_init() when called with an
		  out-of-range id.
endmenu
