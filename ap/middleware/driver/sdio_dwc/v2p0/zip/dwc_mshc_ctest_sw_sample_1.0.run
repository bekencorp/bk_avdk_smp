#!/usr/bin/perl -w
# @(#) $Id: //dwh/dwre/main/tools/dw_image_gen/src/ImageHeaderPerl.pm#33 $
# @(#) $DateTime: 2020/03/10 15:57:14 $

package Local::IO::Tee;

require 5.004;
use strict;
use Carp;
use Symbol;
use IO::Handle;
use IO::File;
use vars qw($VERSION @ISA);
$VERSION = '0.64';
@ISA = 'IO::Handle';

sub new {
    my $class = shift;
    my $self = gensym;
    @{*$self} = map {
        ! ref($_) ? IO::File->new($_)
        : ref($_) eq 'ARRAY' ? IO::File->new(@$_)
        : ref($_) eq 'GLOB' ? bless $_, 'IO::Handle'
        : $_ or return undef } @_;
    bless $self, $class;
    tie *$self, $class, $self;
    return $self;
}

# Return a list of all associated handles
sub handles {
    @{*{$_[0]}};
}

# Proxy routines for various IO::Handle and IO::File operations
sub _method_return_success {
    my $method = (caller(1))[3];
    $method =~ s/.*:://;
    my $self = shift;
    my $ret = 1;
    foreach my $fh (@{*$self}) { undef $ret unless $fh->$method(@_) }
    return $ret;
}

sub close        { _method_return_success(@_) }
sub truncate     { _method_return_success(@_) }
sub write        { _method_return_success(@_) }
sub syswrite     { _method_return_success(@_) }
sub format_write { _method_return_success(@_) }
sub fcntl        { _method_return_success(@_) }
sub ioctl        { _method_return_success(@_) }
sub flush        { _method_return_success(@_) }
sub clearerr     { _method_return_success(@_) }
sub seek         { _method_return_success(@_) }

sub formline {
    my $self = shift;
    my $picture = shift;
    local($^A) = $^A;
    local($\) = "";
    formline($picture, @_);
    my $ret = 1;
    foreach my $fh (@{*$self}) { undef $ret unless print $fh $^A }
    return $ret;
}

sub _state_modify {
    my $method = (caller(1))[3];
    $method =~ s/.*:://;
    croak "$method values cannot be retrieved collectively" if @_ <= 1;
    my $self = shift;
    if (ref $self)
    {
        foreach my $fh (@{*$self}) { $fh->$method(@_) }
    }
    else
    {
        IO::Handle->$method(@_);
    }
    # Note that we do not return any "previous value" here
}

sub autoflush                    { _state_modify(@_) }
sub output_field_separator       { _state_modify(@_) }
sub output_record_separator      { _state_modify(@_) }
sub format_page_number           { _state_modify(@_) }
sub format_lines_per_page        { _state_modify(@_) }
sub format_lines_left            { _state_modify(@_) }
sub format_name                  { _state_modify(@_) }
sub format_top_name              { _state_modify(@_) }
sub format_line_break_characters { _state_modify(@_) }
sub format_formfeed              { _state_modify(@_) }

sub input_record_separator {
    my $self = shift;
    my $ret = (ref $self ? ${*$self}[0] : 'IO::Handle')->input_record_separator(@_);
    $ret; # This works around an apparent bug in Perl 5.004_04
}

sub input_line_number {
    my $self = shift;
    my $ret = ${*$self}[0]->input_line_number(@_);
    $ret; # This works around an apparent bug in Perl 5.004_04
}
# File handle tying interface

sub TIEHANDLE {
    my ($class, $self) = @_;
    return bless *$self{ARRAY}, $class;
}

sub PRINT {
    my $self = shift;
    my $ret = 1;
    foreach my $fh (@$self) { undef $ret unless print $fh @_ }
    return $ret;
}

sub PRINTF {
    my $self = shift;
    my $fmt = shift;
    my $ret = 1;
    foreach my $fh (@$self) { undef $ret unless printf $fh $fmt, @_ }
    return $ret;
}

sub _multiplex_input {
    my ($self, $input) = @_;
    my $ret = 1;
    if (length $input) {
        for (my $i = 1; $i < @$self; ++$i) {
            undef $ret unless print {$self->[$i]} $input;
        }
    }
    $ret;
}

sub READ {
    my $self = shift;
    my $bytes = $self->[0]->read(@_);
    $bytes and $self->_multiplex_input(substr($_[0], $_[2], $bytes));
    $bytes;
}

sub READLINE {
    my $self = shift;
    my $infh = $self->[0];
    if (wantarray) {
        my @data;
        my $data;
        while (defined($data = <$infh>) and length($data)) {
            push @data, $data;
            $self->_multiplex_input($data);
        }
        @data;
    }
    else {
        my $data = <$infh>;
        defined $data and $self->_multiplex_input($data);
        $data;
    }
}

sub GETC {
    my $self = shift;
    my $data = getc($self->[0]);
    defined $data and $self->_multiplex_input($data);
    $data;
}

sub sysread {
    my $self = shift;
    my $bytes = ${*$self}[0]->sysread(@_);
    $bytes and (\@{*$self})->
        _multiplex_input(substr($_[0], $_[2] || 0, $bytes));
    $bytes;
}

sub EOF {
    my $self = shift;
    return $self->[0]->eof;
}

1;

package Local::File::Path;

use 5.005_04;
use strict;

use Cwd 'getcwd';
use File::Basename ();
use File::Spec     ();

BEGIN {
    if ($] < 5.006) {
        # can't say 'opendir my $dh, $dirname'
        # need to initialise $dh
        eval "use Symbol";
    }
}

use Exporter ();
use vars qw($VERSION @ISA @EXPORT @EXPORT_OK);
$VERSION   = '2.08';
@ISA       = qw(Exporter);
@EXPORT    = qw(mkpath rmtree);
@EXPORT_OK = qw(make_path remove_tree);

my $Is_VMS     = $^O eq 'VMS';
my $Is_MacOS   = $^O eq 'MacOS';

# These OSes complain if you want to remove a file that you have no
# write permission to:
my $Force_Writeable = grep {$^O eq $_} qw(amigaos dos epoc MSWin32 MacOS os2);

# Unix-like systems need to stat each directory in order to detect
# race condition. MS-Windows is immune to this particular attack.
my $Need_Stat_Check = !($^O eq 'MSWin32');

sub _carp {
    require Carp;
    goto &Carp::carp;
}

sub _croak {
    require Carp;
    goto &Carp::croak;
}

sub _error {
    my $arg     = shift;
    my $message = shift;
    my $object  = shift;

    if ($arg->{error}) {
        $object = '' unless defined $object;
        $message .= ": $!" if $!;
        push @{${$arg->{error}}}, {$object => $message};
    }
    else {
        _carp(defined($object) ? "$message for $object: $!" : "$message: $!");
    }
}

sub make_path {
    push @_, {} unless @_ and UNIVERSAL::isa($_[-1],'HASH');
    goto &mkpath;
}

sub mkpath {
    my $old_style = !(@_ and UNIVERSAL::isa($_[-1],'HASH'));

    my $arg;
    my $paths;

    if ($old_style) {
        my ($verbose, $mode);
        ($paths, $verbose, $mode) = @_;
        $paths = [$paths] unless UNIVERSAL::isa($paths,'ARRAY');
        $arg->{verbose} = $verbose;
        $arg->{mode}    = defined $mode ? $mode : 0777;
    }
    else {
        $arg = pop @_;
        $arg->{mode}      = delete $arg->{mask} if exists $arg->{mask};
        $arg->{mode}      = 0777 unless exists $arg->{mode};
        ${$arg->{error}}  = [] if exists $arg->{error};
        $arg->{owner}     = delete $arg->{user} if exists $arg->{user};
        $arg->{owner}     = delete $arg->{uid}  if exists $arg->{uid};
        if (exists $arg->{owner} and $arg->{owner} =~ /\D/) {
            my $uid = (getpwnam $arg->{owner})[2];
            if (defined $uid) {
                $arg->{owner} = $uid;
            }
            else {
                _error($arg, "unable to map $arg->{owner} to a uid, ownership not changed");
                delete $arg->{owner};
            }
        }
        if (exists $arg->{group} and $arg->{group} =~ /\D/) {
            my $gid = (getgrnam $arg->{group})[2];
            if (defined $gid) {
                $arg->{group} = $gid;
            }
            else {
                _error($arg, "unable to map $arg->{group} to a gid, group ownership not changed");
                delete $arg->{group};
            }
        }
        if (exists $arg->{owner} and not exists $arg->{group}) {
            $arg->{group} = -1; # chown will leave group unchanged
        }
        if (exists $arg->{group} and not exists $arg->{owner}) {
            $arg->{owner} = -1; # chown will leave owner unchanged
        }
        $paths = [@_];
    }
    return _mkpath($arg, $paths);
}

sub _mkpath {
    my $arg   = shift;
    my $paths = shift;

    my(@created,$path);
    foreach $path (@$paths) {
        next unless defined($path) and length($path);
        $path .= '/' if $^O eq 'os2' and $path =~ /^\w:\z/s; # feature of CRT
        # Logic wants Unix paths, so go with the flow.
        if ($Is_VMS) {
            next if $path eq '/';
            $path = VMS::Filespec::unixify($path);
        }
        next if -d $path;
        my $parent = File::Basename::dirname($path);
        unless (-d $parent or $path eq $parent) {
            push(@created,_mkpath($arg, [$parent]));
        }
        print "mkdir $path\n" if $arg->{verbose};
        if (mkdir($path,$arg->{mode})) {
            push(@created, $path);
            if (exists $arg->{owner}) {
				# NB: $arg->{group} guaranteed to be set during initialisation
                if (!chown $arg->{owner}, $arg->{group}, $path) {
                    _error($arg, "Cannot change ownership of $path to $arg->{owner}:$arg->{group}");
                }
            }
        }
        else {
            my $save_bang = $!;
            my ($e, $e1) = ($save_bang, $^E);
            $e .= "; $e1" if $e ne $e1;
            # allow for another process to have created it meanwhile
            if (!-d $path) {
                $! = $save_bang;
                if ($arg->{error}) {
                    push @{${$arg->{error}}}, {$path => $e};
                }
                else {
                    _croak("mkdir $path: $e");
                }
            }
        }
    }
    return @created;
}

sub remove_tree {
    push @_, {} unless @_ and UNIVERSAL::isa($_[-1],'HASH');
    goto &rmtree;
}

sub _is_subdir {
    my($dir, $test) = @_;

    my($dv, $dd) = File::Spec->splitpath($dir, 1);
    my($tv, $td) = File::Spec->splitpath($test, 1);

    # not on same volume
    return 0 if $dv ne $tv;

    my @d = File::Spec->splitdir($dd);
    my @t = File::Spec->splitdir($td);

    # @t can't be a subdir if it's shorter than @d
    return 0 if @t < @d;

    return join('/', @d) eq join('/', splice @t, 0, +@d);
}

sub rmtree {
    my $old_style = !(@_ and UNIVERSAL::isa($_[-1],'HASH'));

    my $arg;
    my $paths;

    if ($old_style) {
        my ($verbose, $safe);
        ($paths, $verbose, $safe) = @_;
        $arg->{verbose} = $verbose;
        $arg->{safe}    = defined $safe    ? $safe    : 0;

        if (defined($paths) and length($paths)) {
            $paths = [$paths] unless UNIVERSAL::isa($paths,'ARRAY');
        }
        else {
            _carp ("No root path(s) specified\n");
            return 0;
        }
    }
    else {
        $arg = pop @_;
        ${$arg->{error}}  = [] if exists $arg->{error};
        ${$arg->{result}} = [] if exists $arg->{result};
        $paths = [@_];
    }

    $arg->{prefix} = '';
    $arg->{depth}  = 0;

    my @clean_path;
    $arg->{cwd} = getcwd() or do {
        _error($arg, "cannot fetch initial working directory");
        return 0;
    };
    for ($arg->{cwd}) { /\A(.*)\Z/; $_ = $1 } # untaint

    for my $p (@$paths) {
        # need to fixup case and map \ to / on Windows
        my $ortho_root = $^O eq 'MSWin32' ? _slash_lc($p)          : $p;
        my $ortho_cwd  = $^O eq 'MSWin32' ? _slash_lc($arg->{cwd}) : $arg->{cwd};
        my $ortho_root_length = length($ortho_root);
        $ortho_root_length-- if $^O eq 'VMS'; # don't compare '.' with ']'
        if ($ortho_root_length && _is_subdir($ortho_root, $ortho_cwd)) {
            local $! = 0;
            _error($arg, "cannot remove path when cwd is $arg->{cwd}", $p);
            next;
        }

        if ($Is_MacOS) {
            $p  = ":$p" unless $p =~ /:/;
            $p .= ":"   unless $p =~ /:\z/;
        }
        elsif ($^O eq 'MSWin32') {
            $p =~ s{[/\\]\z}{};
        }
        else {
            $p =~ s{/\z}{};
        }
        push @clean_path, $p;
    }

    @{$arg}{qw(device inode perm)} = (lstat $arg->{cwd})[0,1] or do {
        _error($arg, "cannot stat initial working directory", $arg->{cwd});
        return 0;
    };

    return _rmtree($arg, \@clean_path);
}

sub _rmtree {
    my $arg   = shift;
    my $paths = shift;

    my $count  = 0;
    my $curdir = File::Spec->curdir();
    my $updir  = File::Spec->updir();

    my (@files, $root);
    ROOT_DIR:
    foreach $root (@$paths) {
        # since we chdir into each directory, it may not be obvious
        # to figure out where we are if we generate a message about
        # a file name. We therefore construct a semi-canonical
        # filename, anchored from the directory being unlinked (as
        # opposed to being truly canonical, anchored from the root (/).

        my $canon = $arg->{prefix}
            ? File::Spec->catfile($arg->{prefix}, $root)
            : $root
        ;

        my ($ldev, $lino, $perm) = (lstat $root)[0,1,2] or next ROOT_DIR;

        if ( -d _ ) {
            $root = VMS::Filespec::pathify($root) if $Is_VMS;

            if (!chdir($root)) {
                # see if we can escalate privileges to get in
                # (e.g. funny protection mask such as -w- instead of rwx)
                $perm &= 07777;
                my $nperm = $perm | 0700;
                if (!($arg->{safe} or $nperm == $perm or chmod($nperm, $root))) {
                    _error($arg, "cannot make child directory read-write-exec", $canon);
                    next ROOT_DIR;
                }
                elsif (!chdir($root)) {
                    _error($arg, "cannot chdir to child", $canon);
                    next ROOT_DIR;
                }
            }

            my ($cur_dev, $cur_inode, $perm) = (stat $curdir)[0,1,2] or do {
                _error($arg, "cannot stat current working directory", $canon);
                next ROOT_DIR;
            };

            if ($Need_Stat_Check) {
                ($ldev eq $cur_dev and $lino eq $cur_inode)
                    or _croak("directory $canon changed before chdir, expected dev=$ldev ino=$lino, actual dev=$cur_dev ino=$cur_inode, aborting.");
            }

            $perm &= 07777; # don't forget setuid, setgid, sticky bits
            my $nperm = $perm | 0700;

            # notabene: 0700 is for making readable in the first place,
            # it's also intended to change it to writable in case we have
            # to recurse in which case we are better than rm -rf for
            # subtrees with strange permissions

            if (!($arg->{safe} or $nperm == $perm or chmod($nperm, $curdir))) {
                _error($arg, "cannot make directory read+writeable", $canon);
                $nperm = $perm;
            }

            my $d;
            $d = gensym() if $] < 5.006;
            if (!opendir $d, $curdir) {
                _error($arg, "cannot opendir", $canon);
                @files = ();
            }
            else {
                no strict 'refs';
                if (!defined ${"\cTAINT"} or ${"\cTAINT"}) {
                    # Blindly untaint dir names if taint mode is
                    # active, or any perl < 5.006
                    @files = map { /\A(.*)\z/s; $1 } readdir $d;
                }
                else {
                    @files = readdir $d;
                }
                closedir $d;
            }

            if ($Is_VMS) {
                # Deleting large numbers of files from VMS Files-11
                # filesystems is faster if done in reverse ASCIIbetical order.
                # include '.' to '.;' from blead patch #31775
                @files = map {$_ eq '.' ? '.;' : $_} reverse @files;
                ($root = VMS::Filespec::unixify($root)) =~ s/\.dir\z//;
            }

            @files = grep {$_ ne $updir and $_ ne $curdir} @files;

            if (@files) {
                # remove the contained files before the directory itself
                my $narg = {%$arg};
                @{$narg}{qw(device inode cwd prefix depth)}
                    = ($cur_dev, $cur_inode, $updir, $canon, $arg->{depth}+1);
                $count += _rmtree($narg, \@files);
            }

            # restore directory permissions of required now (in case the rmdir
            # below fails), while we are still in the directory and may do so
            # without a race via '.'
            if ($nperm != $perm and not chmod($perm, $curdir)) {
                _error($arg, "cannot reset chmod", $canon);
            }

            # don't leave the client code in an unexpected directory
            chdir($arg->{cwd})
                or _croak("cannot chdir to $arg->{cwd} from $canon: $!, aborting.");

            # ensure that a chdir upwards didn't take us somewhere other
            # than we expected (see CVE-2002-0435)
            ($cur_dev, $cur_inode) = (stat $curdir)[0,1]
                or _croak("cannot stat prior working directory $arg->{cwd}: $!, aborting.");

            if ($Need_Stat_Check) {
                ($arg->{device} eq $cur_dev and $arg->{inode} eq $cur_inode)
                    or _croak("previous directory $arg->{cwd} changed before entering $canon, expected dev=$ldev ino=$lino, actual dev=$cur_dev ino=$cur_inode, aborting.");
            }

            if ($arg->{depth} or !$arg->{keep_root}) {
                if ($arg->{safe} &&
                    ($Is_VMS ? !&VMS::Filespec::candelete($root) : !-w $root)) {
                    print "skipped $root\n" if $arg->{verbose};
                    next ROOT_DIR;
                }
                if ($Force_Writeable and !chmod $perm | 0700, $root) {
                    _error($arg, "cannot make directory writeable", $canon);
                }
                print "rmdir $root\n" if $arg->{verbose};
                if (rmdir $root) {
                    push @{${$arg->{result}}}, $root if $arg->{result};
                    ++$count;
                }
                else {
                    _error($arg, "cannot remove directory", $canon);
                    if ($Force_Writeable && !chmod($perm, ($Is_VMS ? VMS::Filespec::fileify($root) : $root))
                    ) {
                        _error($arg, sprintf("cannot restore permissions to 0%o",$perm), $canon);
                    }
                }
            }
        }
        else {
            # not a directory
            $root = VMS::Filespec::vmsify("./$root")
                if $Is_VMS
                   && !File::Spec->file_name_is_absolute($root)
                   && ($root !~ m/(?<!\^)[\]>]+/);  # not already in VMS syntax

            if ($arg->{safe} &&
                ($Is_VMS ? !&VMS::Filespec::candelete($root)
                         : !(-l $root || -w $root)))
            {
                print "skipped $root\n" if $arg->{verbose};
                next ROOT_DIR;
            }

            my $nperm = $perm & 07777 | 0600;
            if ($Force_Writeable and $nperm != $perm and not chmod $nperm, $root) {
                _error($arg, "cannot make file writeable", $canon);
            }
            print "unlink $canon\n" if $arg->{verbose};
            # delete all versions under VMS
            for (;;) {
                if (unlink $root) {
                    push @{${$arg->{result}}}, $root if $arg->{result};
                }
                else {
                    _error($arg, "cannot unlink file", $canon);
                    $Force_Writeable and chmod($perm, $root) or
                        _error($arg, sprintf("cannot restore permissions to 0%o",$perm), $canon);
                    last;
                }
                ++$count;
                last unless $Is_VMS && lstat $root;
            }
        }
    }
    return $count;
}

sub _slash_lc {
    # fix up slashes and case on MSWin32 so that we can determine that
    # c:\path\to\dir is underneath C:/Path/To
    my $path = shift;
    $path =~ tr{\\}{/};
    return lc($path);
}

1;

package main;

use Cwd ();
use strict;
use POSIX;
use Getopt::Long;
use IPC::Open2;
use File::Basename;
use FileHandle;
use IO::File;
use English;
use MIME::Base64;
use Digest::MD5;

select STDERR; $|=1;
select STDOUT; $|=1;

my $_ORIGINAL_PATH = $ENV{PATH};
$ENV{PATH}=q(/bin:/usr/bin);

my $_initArgs = [@ARGV];
my $_DataStart = tell DATA; # the start of DATA.

my $_startDir = Cwd::cwd();
$_startDir = Cwd::abs_path($_startDir);

my $_downloadDir = Cwd::abs_path(File::Basename::dirname($0));

my $_mpClassInstanceHash = requireMultiPartClasses($_downloadDir);

my $_unbundleFile = q();
my $_index = 0;
my $_checkIntegrity = 0;
my $_checkLicense = 0;
my $_checkLicenseXmlOut = q();
my $_readme = 0;
my $_help = 0;
my $_helpXmlSchema = 0;
my $_installDir = q();
my $_quiet = 0;
my $_keepLog = 0;
my $_doIsDwh = 0;
my $_doIsExportControlled = 0;
my $_doVeToc = 0;
my $_doDepends = 0;
my $_ecount = 0;
my $_doReport = 0;
my $_doPrintPidFeatureCount = 0;
my $_verbose = ( $ENV{FLEXLM_DIAGNOSTICS}) ? 1 : 0;

sub getOptionErrors {
    my $msg = shift;
    die sprintf( qq(%s\nTry %s --help for assistance.\n), $msg, $0 );
}

$SIG{__WARN__} = \&getOptionErrors;

GetOptions ( qq(-u|unbundle=s), \$_unbundleFile,
             qq(-i|index), \$_index,
             qq(-c|check|check-integrity), \$_checkIntegrity,
             qq(-check-license:s), sub { $_checkLicense=1; $_checkLicenseXmlOut = $_[1] || (basename($0, q(.run)).q(_check_license.xml)); },
             qq(-d|directory=s), \$_installDir,
             qq(-r|readme), \$_readme,
             qq(-h|help), \$_help,
             qq(-hxml|help-xml-schema), \$_helpXmlSchema,
             qq(-q|quiet), \$_quiet,
             qq(-keep-log), \$_keepLog,
             qq(-is_dwh), \$_doIsDwh,
             qq(-is_export_controlled), \$_doIsExportControlled,
             qq(-ve_toc), \$_doVeToc,
             qq(-depends), \$_doDepends,
             qq(-report), \$_doReport,
             qq(-print-pid-feature-count), \$_doPrintPidFeatureCount,
             qq(-verbose), \$_verbose,
             );

$SIG{__WARN__} = q(DEFAULT);

my ($_LOG, $_TEE, $_logFileName);
my $_deleteOnEnd = [];

END {
    unless ( $_keepLog || $? ) {
        # keep the log if asked or if non-zero exit occurs.
        unlink $_logFileName if ( $_logFileName && -f $_logFileName );
    }

    foreach my $path ( @$_deleteOnEnd ) {
        if ( -d $path ) {
            ;
            Local::File::Path::remove_tree( $path );
        }
        else {
            unlink( $path );
        }
    }
}

if ( $_verbose ) {
    $ENV{FLEXLM_DIAGNOSTICS} = 3;
}

# SYSTEM TOOLS

my $missing = q();

my $_CKSUM = locateExec(q(cksum));
$missing .= q( cksum) unless ($_CKSUM);

my $_CAT = locateExec(q(cat));
$missing .= q( cat) unless ($_CAT);

local $SIG{__DIE__} = sub {};

if ( $_help ) {
    help() ? die("\n") : exit();
}

if ( $_helpXmlSchema ) {
    helpXmlSchema() ? die("\n") : exit();
}

if ( $_doIsDwh ) {
    printf( "USE_DWH=%d\n", useDwh());
    useDwh() ? exit() : die("\n");
}

if ( $_doIsExportControlled ) {
    printf( "EXPORT_CONTROLLED=%d\n", isExportControlled());
    isExportControlled() ? die("\n") : exit();
}

if ( $_readme ) {
    dwHeader();
    hasReadme() ? do {dwReadme(); exit() } : do{ die "No embedded readme file.\n" };
}

if ( $_index ) {
    printFileIndexStr() ? die("\n") : exit();
}

if ( $_doReport ) {
    printReportStr() ? die("\n") : exit();
}

if ( $_doVeToc ) {
    printVeTocStr() ? die("\n") : exit();
}

if ( $_doDepends ) {
    printDepends() ? die("\n") : exit();
}

if ( $_doPrintPidFeatureCount ) {
    printPidFeatureCount() ? die(""): exit();
}

if ( $_checkIntegrity ) {
    cksumAll(1) ? die("\n") : exit();
}

my $_typeDisplayMap = {
    q(PID) => q(pid-licensed),
    q(LIC) => q(licensed),
    q(OPN) => q(open),
};

# Must have an install directory to unbundle or extract.

if ( $_checkLicense ) {
    $_installDir = $_installDir || $_startDir;
    $_quiet = 1;
}

unless ( $_installDir = validateInstallDir($_installDir, ($_unbundleFile || $_checkLicense) ) ) {
    die("\n");
}

if ( $_unbundleFile ) {
    unbundleMatchingFiles($_unbundleFile, $_installDir) ? die("\n") : exit();
}

# everything after here is an extract/install operation.

dwHeader();

my $createdInstallDirs = [];
unless ( -d $_installDir ) {
    $createdInstallDirs = mkDirectory($_installDir);
}

$_installDir =~ s/\/$//; # Strip trailing slash; it confuses stat()/lstat() calls.
$_installDir = Cwd::abs_path($_installDir) if $_installDir; # must have absolute path.

$ENV{DESIGWARE_HOME} = $_installDir if useDwh();

unless ( $_quiet ) {
    print( qq(Install to '$_installDir'.  Continue [y/n]? ));
    my $response = readResponse(1);
    unless ($response =~ /^y/i) {
        map { rmdir $_ } @$createdInstallDirs;
        die("\n");
    }
    print "\n";
}

if ( scalar @$createdInstallDirs ) {
    # Although actually created earlier, defer reporting until now.
    print(  "\n", "Creating directory $_installDir\n" );
}

($_LOG, $_TEE, $_logFileName) = initInstallLog($_installDir);
select $_LOG; $|=1;
select $_TEE; $|=1;

logExtractDetails($_initArgs, $_installDir);

my $_GTAR = dwCheckGtar() || die("\n");

if ( $_checkLicense ) {
    checkLicenseAll() ? die("\n") : exit();
}

dwCheckDiskSpace($_installDir) || die("\n");

my $_pid = q();
my $_desiredFeatureMap = {};

if ( 2 == dwInstallType() ) {
    ($_pid, $_desiredFeatureMap) = sourceOnlyInstallQuery($_installDir);
}
elsif ( 3 == dwInstallType() ) {
    ($_pid, $_desiredFeatureMap) = mixedInstallQuery($_installDir);
}
else {
    # no install query for encrypted only images.
    $_pid = q();
    $_desiredFeatureMap = {};
}

my $_extractorDir = dwGetExtractorDir( $_installDir );
push ( @$_deleteOnEnd, $_extractorDir );
my $_extractCmd = dwUnpackExtractor( $_extractorDir );
cksumAll();
dwCheckHardware($_extractorDir);

my $_errorCount = dwExtractSelectedContent($_startDir, $_installDir, $_extractCmd, $_extractorDir, $_pid, $_desiredFeatureMap);

# run post install script
my $_postInstallErrorState = execPostInstall($_downloadDir, $_installDir);

my $_readmeFile = q();
if ( hasReadme() ) {
    my $readmeDir = sprintf( qq(%s/doc/README_POST_INSTALL), $_installDir );
    mkDirectory($readmeDir);
    $_readmeFile = sprintf( qq(%s/%s.readme), $readmeDir, File::Basename::basename($0, q(.run)) );
}

dwReadme($_readmeFile);

if ( $_errorCount ) {

    print( qq(!\n),
           qq(! Error(s) occurred during extraction. Error Count: $_errorCount\n),
           qq(! This installation may be incomplete.\n),
           qq(!\n),
           );
    $_keepLog = 1;
}
if ( $_postInstallErrorState ) {
    my $postInstallName = getPostInstallName();
    print( qq(!\n),
           qq(! Error(s) occurred during $postInstallName execution.\n),
           qq(! This installation may not be functional.\n),
           qq(!\n),
           );
    $_keepLog = 1;
}

$_LOG->close();
$_TEE->close();

if ($_errorCount||$_postInstallErrorState) {
   die("\n");
}
exit;

# ----------------------------------------------------------
# subroutines
# ----------------------------------------------------------

sub getDataStart {
    return $_DataStart;
}

sub getDataFileHandle {
    return *DATA;
}

sub mkDirectory {
    my $directory = shift;
    my $errList;
    my $created = [ Local::File::Path::make_path( $directory, {error => \$errList} ) ];
    if ( scalar @$errList ) {
        for my $diag ( @$errList ) {
            my ($directory, $message) = %$diag;
            printf( qq(ERROR: Cannot create directory %s\n), $directory);
        }
        die("\n");
    }
    return $created;
}

sub dwCheckHardware {
    my $dwxLocation = shift;
    my $msg = sprintf( qx($dwxLocation/dw_extract -check 2>&1) );
    my $error = $? >> 8;
    if ( $error ) {
        printf qq($msg\n);
        die("\n");
    }
}

sub dwUnpackExtractor {
    my $dwxLocation = shift;
    foreach my $dwxRecord ( grep( /^DWX\|/, @{getFileIndex()} )) {
        untarFile( $dwxRecord, $dwxLocation );
    }

    my $extractor = sprintf( qq(%s/dw_extract), $dwxLocation);
    my $extractorCmd;
    if ( -r $extractor ) {
        chmod(0755, $extractor);
        $extractorCmd = sprintf( qq(%s), $extractor);
    }
    else {
        printf( qq(The extractor '%s' is missing from this image.\n), $extractor );
        die("\n");
    }
    return $extractorCmd;
}

sub dwGetExtractorDir {
    my $location = shift;
    my $where = sprintf( qq(%s/dw_extract_%d), $location, $$ );
    mkDirectory($where);
    return $where;
}

sub readResponse {
    my $log = shift;
    my $str = q();
    while ( <> ) {
        $str .= $_;
        last if (/\n/);
    }
    $str =~ s/^\s+|\s+$//g; # trim leading/trailing white space.
    printf $_LOG ( qq(\nUSER ENTERED: %s\n), $log ? $str : q(********) ) if ($_LOG);
    return $str;
}

sub sourceOnlyInstallQuery {
    # source only (no ENC bits).
    my $location = shift;

    print( qq(\n),
           qq(This is a source installation.  You are contractually required \n),
           qq(to install this product in a project-specific location. \n),
           qq(\n),
           qq(Is $location a project-specific location [y/n]? )
           );
    my $response = readResponse(1);
    die("\n") unless ( $response =~ /y/i );

    my $pid = simpleReadPid(q(source extraction));

    my $featureList = getPidFeatureListByIndexOrder();
    my $desiredFeatureMap = {};
    foreach my $feature ( @$featureList ) {
        $desiredFeatureMap->{$feature}=1;
    }
    print qq(\n);
    return $pid, $desiredFeatureMap;
}

sub mixedInstallQuery {
    # mixed installation PID, LIC and OPN bits.
    my $location = shift;

    my ($pid, $desiredFeatureMap) = (q(), {});

    my $featureList = getPidFeatureListByIndexOrder();
    my $featureCount = scalar @$featureList;
    my $selectedFeatureCount = 0;

    if ( 1 == $featureCount ) {
        print( qq(\n),
               qq(If you purchased a source license for this product, please enter your\n),
               qq(project ID to get RTL source code; otherwise just press enter here: )
               );
        $pid = readResponse();
        print qq(\n);
        foreach my $feature ( @$featureList ) {
            $desiredFeatureMap->{$feature}=1;
        }
        $selectedFeatureCount = $featureCount;
    }
    else {
        # Multiple-FEATURE mixed-install
        if ( isMixedProduct() ) {
            print( qq(\n),
                   qq(In addition to the encrypted product, this image contains the following\n),
                   qq($featureCount optional source features:\n)
                   );
        }
        else {
            print( qq(\n),
                   qq(This image contains the following $featureCount optional source features:\n),
                   );
        }
        print qq(\n);
        for (my $index=0; $index<$featureCount; $index++) {
            printf( qq(    %d\) %s\n), $index+1, $featureList->[$index] );
        }
        print( qq(\n),
               qq(Please enter a comma-separated list of numbers for each of the source\n),
               qq(features that you purchased. If you purchased all of them, you may\n),
               qq(enter 'all'. If you purchased none of them, simply press the Enter key.\n),
               qq(Enter numbers here: ),
               );
        my $selectedFeatures = readResponse(1);
        my $selectedFeatureNames = [];
        if ( $selectedFeatures =~ /all/i) {
            foreach my $feature ( @$featureList ) {
                $desiredFeatureMap->{$feature}=1;
            }
            $selectedFeatureNames = [ @$featureList ];
            $selectedFeatureCount = $featureCount;
        }
        else {
            # remove all characters except digits and commas from given string.
            foreach my $index ( sort { $a <=> $b } grep(/^[0-9]+$/, split(/[\s,]+/, $selectedFeatures)) ) {
                if ( $featureList->[$index-1] ) {
                    push(@$selectedFeatureNames, $featureList->[$index-1]);
                }
            }
            foreach my $feature ( @$selectedFeatureNames ) {
                $desiredFeatureMap->{$feature}=1;
            }
            $selectedFeatureCount = scalar @$selectedFeatureNames;
        }
        if ( @$selectedFeatureNames ) {

            print( qq(\n),
                   qq(You selected the following source features to install:\n),
                   qq(\n),
                   );
            for ( my $index=0; $index<scalar( @$featureList ); $index++) {
                if ( $desiredFeatureMap->{$featureList->[$index]} ) {
                    printf( qq(    %d\) %s\n), $index+1, $featureList->[$index] );
                }
            }
            print( qq(\n),
                   qq(Please enter your project ID for the source you purchased: )
                   );
            $pid = readResponse();
        }
        else {
            if ( isMixedProduct() ) {
                print( qq(\n),
                       qq(INFO: No features were selected. Skipping the parts of this project that require a project ID.\n),
                       );
            }
            else {
                print( qq(\n),
                       qq(ERROR: No features selected. All parts of this product require a project ID.\n),
                       );
                die("\n");
            }
        }
    }
    if ( ! $pid && $selectedFeatureCount ) {
        if ( isMixedProduct() ) {
            print( qq(\n),
                   qq(INFO: No project ID entered. Skipping the parts of this project that require a project ID.\n),
                   );
            $desiredFeatureMap = {};
        }
        else {
            print( qq(\n),
                   qq(ERROR: No project ID entered. All parts of this product requires a project ID.\n),
                   );
            die("\n");
        }
    }

    if ( $pid && scalar( keys %$desiredFeatureMap ) ) {
        print( qq(\n),
               qq(This installation includes source. You are contractually required \n),
               qq(to install this product in a project-specific location. \n),
               qq(\n),
               qq(Is $location a project-specific location [y/n]? ),
               );
        my $response = readResponse(1);
        unless ( $response =~ /^y/i) {
           die("\n");
        };
        print( qq(\n\n),
               qq(INFO: Extracting selected source and encrypted product.\n),
               );
    }
    print qq(\n);
    return ($pid, $desiredFeatureMap);
}

sub locateExec {
    my $arg = shift;
    my $tryPath = shift;
    my $testMethod = shift || sub { return 1 };

    my $nameList = eval{ [@$arg ] } || [$arg];
    my $exec = q();
    my $dirList = [split(/:/, $ENV{PATH}), $tryPath ? (split(/:/, $_ORIGINAL_PATH)) : () ];
  NAME:
    foreach my $name ( @$nameList ) {
        foreach my $directory ( @$dirList ) {
            my $candidate = qq($directory/$name);
            $exec = q();
            if ( (! -d $candidate) && -x $candidate) {
                if ( &{$testMethod}($candidate) ) {
                    $exec = $candidate;
                    last NAME;
                }
            }
        }
    }
    return $exec;
}

sub statReadable {
    my $installDir = shift;
    my $statrec = [lstat($installDir)];

    my $mode = $statrec->[2];
    my $permsRec = [qw(--- --x -w- -wx r-- r-x rw- rwx)];
    my $ftypeRec = [q(), qw(p c ? d ? b ? - ? l ? s ? ? ?)];
    my $setids = ($mode & 07000)>>9;
    my $permstrs = [@{$permsRec}[($mode&0700)>>6, ($mode&0070)>>3, ($mode&0007)]];
    my $ftype = @{$ftypeRec}[($mode & 0170000)>>12];

    ($setids & 01) && $permstrs->[2] =~ s/([-x])$/$1 eq 'x' ? 't' : 'T'/e; # Sticky bit
    ($setids & 04) && $permstrs->[0] =~ s/([-x])$/$1 eq 'x' ? 's' : 'S'/e; # Setuid bit
    ($setids & 02) && $permstrs->[1] =~ s/([-x])$/$1 eq 'x' ? 's' : 'S'/e; # Setgid bit

    my $linkTarget = q();
    if ( -l $installDir ) {
        $linkTarget = sprintf( qq( -> %s), readlink($installDir));
    }

    return sprintf( qq(%s),
                    join( q( ),
                          join( q(), $ftype, @$permstrs),
                          scalar(getpwuid($statrec->[4])),
                          scalar(getgrgid($statrec->[5])),
                          $statrec->[7],
                          scalar(localtime($statrec->[9])),
                          $installDir.$linkTarget ));
}

sub logExtractDetails {
    my $args = shift;
    my $installDir = shift;

    my $lmLicenseFile = $ENV{LM_LICENSE_FILE}||q();
    my $snpslmdLicenseFile = $ENV{SNPSLMD_LICENSE_FILE}||q();
    my $installDate=scalar(localtime()); #`$DATE`
    my $userData=sprintf(qq(uid=%d(%s)), $<, scalar(getpwuid($<)));
    my $osData=sprintf( qq(%s), join( qq( ), POSIX::uname()));
    my $installDirDetails=statReadable($installDir);
    my $installTargetDetails = qq();

    my $target = $installDir;
    while ( -l $target ) {
        my $dirname = File::Basename::dirname($target);
        $target = readlink($target);
        $target = ($target =~ /^\./) ? qq($dirname/$target) : $target;
        $target =~ s/\/\.//g;
        $installTargetDetails .= sprintf( qq(           %s\n), statReadable($target) );
    }

    print $_LOG ( qq(FILE: $0\n\n),
                  qq(ARGUMENTS: @$args\n\n),
                  qq(PROCESS ID: $$\n\n),
                  qq(DATE: $installDate\n\n),
                  qq(USER: $userData\n\n),
                  qq(HOST/OS: $osData\n\n),
                  qq(DIRECTORY: $installDirDetails\n),
                  qq($installTargetDetails\n),
                  qq(LM_LICENSE_FILE: $lmLicenseFile\n\n),
                  qq(SNPSLMD_LICENSE_FILE: $snpslmdLicenseFile\n\n)
                  );
}

sub dwCheckDiskSpace {
    my $mount = shift;
    my $dwxOnly = shift || 0;
    my $df = locateExec(q(df));
    my $requiredMB = getInstallSize($dwxOnly);
    my $installSize = sprintf( qq(%d), $requiredMB);
    unless ( $df ) {
        # warn user in absence of df, ask to continue and return true or exit.
        print( qq(\n),
               qq(Warning: Cannot see /bin/df or /usr/bin/df.  Unable to\n),
               qq(check for available disk space.  This image requires up\n),
               qq(to $installSize MB of free disk space.  The installer\n),
               qq(terminates immediately if it runs out of room.\n),
               qq(\n),
               qq(Continue [y/n]? )
               );
        my $continue = readResponse(1);
        ($continue =~ /^y/i) ? return 1 : die("\n");
    }

    printf $_LOG ( qq(DISK SPACE REQUIRED (MB): %.3f\n\n), $requiredMB );
    my $data = pop(@{[ qx($df -k $mount) ]}); # get last line.
    my $err = $? >> 8;

    if ($err || !$data) {
        # something weird happened; warn user, ask to continue and return true or exit.
        print( qq(\n),
               qq(Warning: Unexpected error while calculating available disk space.\n),
               qq(This image requires up to $installSize MB of free disk space.\n),
               qq(The installer terminates immediately if it runs out of room.\n),
               qq(\n),
               qq(Continue [y/n]? )
               );
        my $continue = readResponse(1);
        ($continue =~ /^y/i) ? return 1 : die("\n");
    }

    my $freeMB = ((split(/\s+/,$data))[-3])/1024;
    print $_LOG qq(DISK SPACE AVAILABLE (MB): $freeMB\n\n);
    if ( $freeMB < $requiredMB ) {
        # too little space; warn user, ask to continue and return true or exit.
        print( qq(\n),
               qq(Warning:  There may not be sufficient disk space for installation.\n),
               qq(This image requires up to $installSize MB of free disk space.\n),
               qq(The installer terminates immediately if it runs out of room.\n),
               qq(\n),
               qq(Continue [y/n]? )
               );
        my $continue = readResponse(1);
        ($continue =~ /^y/i) ? return 1 : die("\n");
    }
    return 1; # should never get here.
}

sub touch {
    my $target = shift;
    open (TFILE, qq(>$target)) || printError ("Could not touch file: $target; $!");
    print TFILE q();
    close TFILE;
}

sub isGoodGtar {
    my $gtarCandidate = shift;
    qx($gtarCandidate --version > /dev/null 2>&1) if ($gtarCandidate);
    my $gtarError = ($gtarCandidate) ? $? >> 8 : 1;

    unless ($gtarError) {
        my $message = qx($gtarCandidate -czf /dev/null /dev/null 2>&1);
        $gtarError = $? >> 8;
        printf $_LOG ( qq(GTAR TEST FAILURE: %s\n), $message || qq(No message)) if ($gtarError);
    }

    return $gtarError ? 0 : 1;
}

sub dwCheckGtar {

    my $gtarCandidate;

    # try "gtar" first, the "tar"
    $gtarCandidate= locateExec([q(gtar),q(tar)], 1, \&isGoodGtar);

    unless( $gtarCandidate ) {
            printf(
                   qq(ERROR: Unable to find a GNU tar in search path.\n)
                   . qq(\n)
                   . qq(  Tried both "gtar" and "tar", neither behaved like GNU\n)
                   . qq(  tar. The GNU tar archive utility must be installed on\n)
                   . qq(  your system and visible in your search path.  GNU tar\n)
                   . qq(  is available from the GNU web site: http://www.gnu.org\n)
                   . qq(\n)
                   );
            return q();
        }
#    }

    print $_LOG qq(GTAR PATH: $gtarCandidate\n\n);
    my $gtarVersion = qx($gtarCandidate --version 2>&1);
    print $_LOG qq(GTAR VERSION: $gtarVersion\n\n);

    return $gtarCandidate;
}


sub validateInstallDir {
    my $installDirCandidate = shift;
    my $isUnbundle = shift;

    if ( ! $installDirCandidate ) {
        if ( useDwh() && ! $isUnbundle ) {
            $installDirCandidate = $ENV{DESIGNWARE_HOME};
        }
    }

    unless ( $installDirCandidate ) {
        dwHeader();
        if ( $isUnbundle ) {
            # print unbundle missing directory error.
            print( qq(ERROR:  For unbundle operations, you must explicitly specify an install directory.\n)
                   . qq(        Use the --dir <install-dir> switch.\n));
        }
        elsif ( useDwh() ) {
            # print DWH missing directory error.
            print( qq(ERROR:  You must specify an install directory.\n)
                   . qq(        Use the --dir <install-dir> switch or set the DESIGNWARE_HOME environment variable.\n));
        }
        else {
            print( qq(ERROR:  You must specify an install directory.\n)
                   . qq(        Use the --dir <install-dir> switch.\n));
        }
        print qq(\n);
        return 0;
    }
    return $installDirCandidate;
}

sub getListOfLicensedArchives {
    my $licensedArchiveList = [];

    foreach my $indexRecord ( sort grep(/^(PID|LIC)\|/, @{getFileIndex()} )) {
        my @ignored;
        my $ignored;
        my $feature;
        ($ignored, $ignored, $ignored, $ignored, $ignored, $feature, @ignored) = split(/\|/, $indexRecord);
        if ( $feature ) {
            push( @$licensedArchiveList, $indexRecord );
        }
    }
    return $licensedArchiveList;
}

sub simpleReadPid {
    my $operation = shift;
    print( qq(\n),
           qq(Enter your project ID: )
           );
    my $pid = readResponse();
    unless ($pid) { # Project ID missing
        printf( qq(\nERROR: No project ID. A project ID is required for %s.\n), $operation );
        die("\n");
    }
    return $pid;
}

sub checkLicenseAll {

    # Get list of archives that require licensed extraction.

    my $licensedArchiveList = getListOfLicensedArchives();
    my $licenseCheckData = {};
    $licenseCheckData->{ARCHIVE_LIST} = [];
    $licenseCheckData->{RUN_FILE_NAME} = File::Basename::basename($0);
    $licenseCheckData->{CONTENT_MD5} = getContentMD5();
    $licenseCheckData->{PRODUCT_MD5} = getProductMD5();
    if ( scalar @$licensedArchiveList ) {
        my $pid = q();
        if ( grep ( /^PID\|/, @$licensedArchiveList )) {
            $pid = simpleReadPid( q(source license checking) );
        }

        my $lastFourOfPid = substr($pid, -4);
        my $printablePid = qq(******$lastFourOfPid);

        # unpack dw_extract executable to namespace protected directory.
        my $extractorDir = dwGetExtractorDir( $_startDir );
        push ( @$_deleteOnEnd, $extractorDir );
        my $extractCmd = dwUnpackExtractor( $extractorDir );

        foreach my $record ( @$licensedArchiveList ) {
            my ( $errorCode, $errorMsg );
            my ($type, $name, $length, $offsetFromDS, $cksum, $feature, $versionEntity, $isProduct,
                $footprint, $sortcode, $class, $targetPath, $targetRank, $targetCksum) = split(/\|/, $record);

            printf( qq(Checking configuration for %s archive: %s\n), $_typeDisplayMap->{$type}, $name);

            ($errorCode, $errorMsg) = checkLicenseFile($extractCmd, $pid, $record);
            if ( $errorCode ) {
                $_ecount++;

                my $regexEscapedPid = $pid;
                $regexEscapedPid =~ s/(\W)/\\$1/g;
                $errorMsg =~ s/$regexEscapedPid/$printablePid/g;

                reportCheckLicenseError( $errorMsg, $name, $_typeDisplayMap->{$type}, $_ecount, $extractorDir );

                $errorMsg =~ s/</&lt;/g; # protect angle brackets from XML parsing.
                $errorMsg =~ s/>/&gt;/g;

                push( @{$licenseCheckData->{ARCHIVE_LIST}}, {
                    q(NAME) => $name,
                    q(TYPE) => $type,
                    q(FEATURE) => $feature,
                    q(PID) => (q(PID) eq $type) ? $printablePid : q(),
                    q(MESSAGE) => $errorMsg,
                });
            }
            else {
                print qq(   ok\n);
                push( @{$licenseCheckData->{ARCHIVE_LIST}}, {
                    q(NAME) => $name,
                    q(TYPE) => $type,
                    q(FEATURE) => $feature,
                    q(PID) => (q(PID) eq $type) ? $printablePid : q(),
                    q(MESSAGE) => q(ok),
                });
            }
        }
    }
    else {
        # nothing to do
        my $message = qq(INFO: None of the archives in this image require an installation license.);
        $licenseCheckData->{UNLICENSED} = $message;
        print qq($message\n);
    }
    unless( q(no-xml-report) eq $_checkLicenseXmlOut ) {
        $_ecount += printCheckLicenseXml($licenseCheckData);
    }
    return $_ecount++;
}

sub printCheckLicenseXml {
    my $data = shift;

    my $report = q();

    $report
        .= sprintf( qq(<check_license>\n) )
        .  sprintf( qq(  <run_file_name>%s</run_file_name>\n), $data->{RUN_FILE_NAME} )
        .  sprintf( qq(  <content_md5>%s</content_md5>\n), $data->{CONTENT_MD5} )
        .  sprintf( qq(  <product_md5>%s</product_md5>\n), $data->{PRODUCT_MD5} )
        .  ($data->{UNLICENSED} ? sprintf( qq(  <unlicensed>%s</unlicensed>\n), $data->{UNLICENSED} ) : q())
        ;

    foreach my $record ( @{$data->{ARCHIVE_LIST}} ) {
        $report
            .= sprintf( qq(  <archive>\n))
            .  sprintf( qq(    <name>%s</name>\n), $record->{q(NAME)})
            .  sprintf( qq(    <type>%s</type>\n), $record->{q(TYPE)})
            .  sprintf( qq(    <feature>\%s</feature>\n), $record->{q(FEATURE)})
            .  sprintf( qq(    <pid>%s</pid>\n), $record->{q(PID)})
            .  sprintf( qq(    <message>%s</message>\n), $record->{q(MESSAGE)})
            .  sprintf( qq(  </archive>\n))
            ;
    }

    $report .= sprintf( qq(</check_license>\n) );

    if ( q(-) eq $_checkLicenseXmlOut ) {
        print $report;
    }
    else {
        $_checkLicenseXmlOut =~ s/^/>/ unless ($_checkLicenseXmlOut =~ /^>/);
        if ( open(CHECK_LIC_XML, $_checkLicenseXmlOut) ) {
            print CHECK_LIC_XML $report;
            close CHECK_LIC_XML;
        }
        else {
            printf( qq(ERROR: Unable to open $_checkLicenseXmlOut %s\n), $! ? qq($!.) : q(.) );
            return 1;
        }
    }
    return 0;
}

sub unbundleMatchingFiles {
    my $pattern = shift;
    my $where = shift;
    my $doAll = (q(all) eq $pattern);
    my $file;

    unless ( -d $where ) {
        print(  qq(\n), qq(Creating directory $where\n) );
        mkDirectory($where);
    }

    print qq(\nUnbundling data matching: '$pattern'\n\n);
    my $headerRecord = sprintf( qq(HEADER|%s.pl|%d|%d||), File::Basename::basename($0, q(.run)), getDataStart(), getDataStart()*-1);
    if ( q(header) eq $pattern ) {
        unbundleFile( $headerRecord, $where );
    }
    else {
        $pattern = ($doAll) ? q(.*) : $pattern;
        my $list = [ grep (/$pattern/, @{getFileIndex()}) ];
        push(@$list, $headerRecord) if ($doAll);
        unless ( 0 == scalar @$list ) {
            foreach my $indexRecord ( @$list ) {
                unbundleFile($indexRecord, $where);
            }
        }
        else {
            printf qq(\nERROR:  Unable to unbundle "%s" from %s: %s.\n), $pattern, File::Basename::basename($0), q(no files match given pattern);
            return 1;
        }
        if ( $doAll ) {
            if ( hasReadme() ) {
                mkDirectory(qq($where/README));
                dwReadme( sprintf( qq($where/README/%s.readme), File::Basename::basename($0, q(.run))), 1 );
            }
        }
    }
    return 0;
}

sub initInstallLog {
    my $where = shift;
    my $logfileName;

    if ( q(/dev/null) eq $where ) {
        $logfileName = $where;
    }
    else {
        mkDirectory($where);
        my $installerName = File::Basename::basename($0, q(.run));
        my $tParts = [localtime()];
        $logfileName = sprintf( qq(%s/%s_%04d%02d%02d_%02d%02d%02d_%d.log),
                                $where, $installerName,
                                1900+$tParts->[5], 1+$tParts->[4], $tParts->[3],
                                $tParts->[2], $tParts->[1], $tParts->[0],
                                $PROCESS_ID );
    }

    my $log = IO::File->new(qq(>$logfileName));
    if (! $log ) {
        printf STDERR qq(ERROR: Unable to write to $logfileName: $!\n);
        die("\n");
    }
    open(STDERR, qq(>&STDOUT));
    my $tee = Local::IO::Tee->new(\*STDOUT, $log );
    return $log, $tee, (q(/dev/null) ne $logfileName) ? $logfileName : q();
}

sub cksumAll {
    my $printHeader = shift;
    dwHeader() if $printHeader;
    printf qq(\nVerifying archive integrity, this may take a few seconds  ...\n);
    my $errCount = 0;
    foreach my $indexRecord ( @{getFileIndex()} ) {
        my $result = cksumFile($indexRecord);
        unless ( $result ) {
            my ($type, $name, $length, $offsetFromDS, $cksum, $feature, $versionEntity, $isProduct, $footprint, $sort_code, $class, @ignored) = split(/\|/, $indexRecord);
            warn sprintf( qq(ERROR: Archive %s contained in %s failed checksum validation.\n), $name, ($class ? $class . q(.pm) : File::Basename::basename($0)));
            $errCount++;
        }
    }
    unless( $errCount ) {
        if ($printHeader) {
            printf qq(CONTENT-MD5=%s\nPRODUCT-MD5=%s\nChecksums OK.  \n), getContentMD5(), getProductMD5();
        }
        else {
            print qq(Checksums OK.  \n);
        }
    }
    return $errCount;
}

sub cksumFile {
    my $indexRecord = shift;

    my ($type, $name, $length, $offsetFromDS, $cksum, $feature, $versionEntity, $isProduct, $footprint, $sort_code, $class, @ignored) = split(/\|/, $indexRecord);

    my $dataStart = $class ? getMpClassInstanceHash()->{$class}->getDataStart() : getDataStart();
    my $offset = $dataStart+$offsetFromDS;
    my $maxbuffsize = 0xffffff;
    my $remainder = $length;
    my $readsize;
    my $handle = $class ? getMpClassInstanceHash()->{$class}->getDataFileHandle() : getDataFileHandle();

    local(*CKSUM_OUT, *CKSUM_IN);
    my $pid = IPC::Open2::open2( *CKSUM_OUT, *CKSUM_IN, $_CKSUM );

    # need to check open2 for success...
    binmode CKSUM_IN;

    seek($handle, $offset, 0); # find beginning of file relative to beginning of DATA handle.
    my $buf = q();
    while (0<($remainder-$maxbuffsize)) {
        $remainder-=$maxbuffsize;
        $readsize=$maxbuffsize;
        read($handle, $buf, $readsize, 0);
        print CKSUM_IN $buf;
    }
    $readsize=$remainder;
    if ($readsize) {
        read($handle, $buf, $readsize, 0);
        print CKSUM_IN $buf;
    }
    close CKSUM_IN;
    my $cksumValue;
    chomp( $cksumValue = <CKSUM_OUT> );
    close CKSUM_OUT;

    waitpid ($pid, 0);
    my $cksumErrorCode = $? >> 8;
    my $cksumErrorMsg = $! || q();
    if ( $cksumErrorCode ) {
        print qq(ERROR: $_CKSUM failed to execute correctly on $name: $cksumErrorMsg\n);
        return 0;
    }

    $cksumValue =~ s/\s+.*$//;
    return ( $cksumValue == $cksum );
}

sub untarFile {
    my $indexRecord = shift;
    my $where = shift;

    my ($type, $name, $length, $offsetFromDS, $cksum, $feature, $versionEntity, $isProduct, $footprint, $sortcode, $class, @ignored) = split(/\|/, $indexRecord);

    my $dataStart = $class ? getMpClassInstanceHash()->{$class}->getDataStart() : getDataStart();
    my $offset = $dataStart+$offsetFromDS;
    my $maxbuffsize = 0xffffff;
    my $remainder = $length;
    my $readsize;
    my $handle = $class ? getMpClassInstanceHash()->{$class}->getDataFileHandle() : getDataFileHandle();

    # assert where directory must exist.
    unless( -d $where ) {
        print "ERROR: $where does not exist\n"; # should never get here.
        die("\n");
    }

    if ( open( UNTAR, qq(|$_GTAR --directory $where -zxf - 2>&1) ) ) {
        binmode UNTAR;
        seek($handle, $offset, 0); # find beginning of file relative beginning to DATA handle.
        my $buf = q();
        while (0<($remainder-$maxbuffsize)) {
            $remainder-=$maxbuffsize;
            $readsize=$maxbuffsize;
            read($handle, $buf, $readsize, 0);
            print UNTAR $buf;
        }
        $readsize=$remainder;
        if ($readsize) {
            read($handle, $buf, $readsize, 0);
            print UNTAR $buf;
        }
        close UNTAR;
    }
    else {
        printf qq(\nTAR Extraction failed to execute.\n), File::Basename::basename($0), $!;
        die("\n");
    }
}

sub getSelectedContentRecords {
    my $pid = shift;
    my $desiredFeatureMap = shift;
    my $selected = [];

    my $rejectedFeatureMap = {};

    my $pidFeatureList = getPidFeatureListByIndexOrder();
    my $pidFeatureCount = scalar @$pidFeatureList;

    if ( (1 < $pidFeatureCount) && (3 == dwInstallType()) ) {
        foreach my $feature ( @$pidFeatureList ) {
            unless ( $desiredFeatureMap->{$feature} ) {
                $rejectedFeatureMap->{$feature}++;
            }
        }
    }

    foreach my $record ( @{getFileIndex()} ) {
        my $recordFields = [ split(/\|/, $record) ];
        my $type = $recordFields->[0];
        my $feature = $recordFields->[5];

        if ( q(LIC) eq $type ) {
            my $remainingFeatureCount = 0;
            foreach my $fpart ( split(/\s+/, $feature) ) {
                unless ( $rejectedFeatureMap->{$fpart} ) {
                    $remainingFeatureCount++;
                }
            }
            if ( $remainingFeatureCount ) {
                push(@$selected, $recordFields);
            }
        }
        elsif ( q(PID) eq $type ) {
            if ( $pid && $desiredFeatureMap->{$feature} ) {
                push(@$selected, $recordFields);
            }
        }
        elsif ( q(OPN) eq $type ) {
            push(@$selected, $recordFields);
        }
        else {
            ; # Ignore all other records. Should only be DWX.
        }
    }
    return $selected;
}

sub dwExtractSelectedContent {
    my $startDir = shift;
    my $location = shift;
    my $extractor = shift;
    my $extractorDir = shift;
    my $pid = shift;
    my $desiredFeatureMap = shift;

    my $lastFourOfPid = substr($pid, -4);
    my $printablePid = qq(******$lastFourOfPid);

    print( qq(\n),
           qq(Unbundling image:  \n));

    chdir($location);
    my $multipartTargetRecordMap = {};
    my $multipartTargetCksumMap = {};

    my $selected = getSelectedContentRecords($pid, $desiredFeatureMap);

    foreach my $record ( @$selected ) {
        my ( $errorCode, $errorMsg );

        my ($type, $name, $length, $offsetFromDS, $cksum, $feature, $versionEntity, $isProduct,
            $footprint, $sortcode, $class, $targetPath, $targetRank, $targetCksum) = @$record;

        if ( $targetPath ) {
            my $md5sum = Digest::MD5->new();
            $md5sum->add($targetPath);

            my $tempdir = sprintf( qq(%s/%s_%d), $location, $md5sum->hexdigest(), $$ );
            mkDirectory($tempdir);
            push( @$_deleteOnEnd, $tempdir );

            $multipartTargetRecordMap->{$targetPath} = $tempdir;
            $multipartTargetCksumMap->{$targetPath} = $targetCksum;

            chdir($tempdir);
            printf( qq(Extracting: %s\n), $name);
            ($errorCode, $errorMsg) = extractFile($extractor, $pid, $type, $name, $length, $offsetFromDS, $class, $versionEntity);
            chdir($location);
        }
        else {
            printf( qq(Extracting: %s\n), $name);
            ($errorCode, $errorMsg) = extractFile($extractor, $pid, $type, $name, $length, $offsetFromDS, $class, $versionEntity);
        }

        if ( $errorCode ) {
            $_ecount++;

            my $regexEscapedPid = $pid;
            $regexEscapedPid =~ s/(\W)/\\$1/g;
            $errorMsg =~ s/$regexEscapedPid/$printablePid/g if ($pid);
            reportExtractError( $errorMsg, $name, $_typeDisplayMap->{$type}, $_ecount, $extractorDir );
        }
    }

    foreach my $file ( keys %$multipartTargetRecordMap ) {
        printf qq(Reconstituting: $file\n);
        my $tempdir = $multipartTargetRecordMap->{$file};
        my $errorCode = catDirContent($tempdir, qq($location/$file));
        if ( $errorCode ) { # cat errors
            $_ecount++;
            print qq(ERROR: Failed to reconstitute $file.\n);
            print qq(Continue with installation [y/n]? );
            my $continueOnError = readResponse(1);
            unless ($continueOnError =~ /^y/i) {
                print( qq(!\n),
                       qq(! Error(s) occurred during extraction. Error Count: $_ecount\n),
                       qq(!\n) );
            }
            next;
        }

        my $installedCksum = qx( $_CKSUM $location/$file );
        chomp $installedCksum;
        $installedCksum =~ s/\s+.*$//;
        if ( $installedCksum != $multipartTargetCksumMap->{$file} ) {
            $_ecount++;
            print qq(ERROR: cksum failure on reconstituted large file: $file\n);
            print qq(Continue with installation [y/n]? );
            my $continueOnError = readResponse(1);
            unless ($continueOnError =~ /^y/i) {
                print( qq(!\n),
                       qq(! Error(s) occurred during extraction. Error Count: $_ecount\n),
                       qq(!\n) );
            }
            next;
        }
    }

    chdir($startDir);
    return $_ecount;
}

sub catDirContent {
    my $tempdir = shift;
    my $outputFile = shift;
    my $partsList = [];

    if ( opendir(TDIR, $tempdir) ) {
        map {
            push(@$partsList, qq($tempdir/$_)) unless ( $_ =~ /^\.{1,2}$/ );
        } readdir TDIR;
        closedir TDIR;
    }
    else {
        # some error
        printf qq(ERROR (at line %d): failed to read $tempdir: $!\n), __LINE__;
        return 1;
    }

    if ( 0 == scalar @$partsList ) {
        # no parts error;
        printf qq(ERROR (at line %d): no parts\n), __LINE__;
        return 1;
    }

    my $outdir = dirname($outputFile);
    mkDirectory($outdir);

    my $outfh = FileHandle->new(qq(>$outputFile));
    unless ( $outfh ) {
        # some error
        printf qq(ERROR (at line %d): failed to open $outputFile for writes: $!\n), __LINE__;
        return 1;
    }
    binmode $outfh;

    foreach my $part ( sort @$partsList ) {
        my $partfh = FileHandle->new($part);
        unless ( $partfh ) {
            # some error
            printf qq(ERROR (at line %d): failed to read $part: $!\n), __LINE__;
            $outfh->close();
            unlink($outputFile);
            return 1;
        }
        binmode $partfh;
        print $outfh ( <$partfh> );
        $partfh->close();
    }
    $outfh->close();
    return 0;
}

sub reportCheckLicenseError {
    my $errorMsg = shift;
    my $name = shift;
    my $display = shift;
    my $_ecount = shift;
    my $extractorDir = shift;
    printf( $errorMsg );
    printf( qq(\nERROR:  Unable to check license for %s %s archive from %s\n\n), $name, $display, $0);
    return 1;
}

sub reportExtractError {
    my $errorMsg = shift;
    my $name = shift;
    my $display = shift;
    my $_ecount = shift;
    my $extractorDir = shift;

    print qq($errorMsg\n);
    printf( qq(\nERROR:  Unable to extract %s %s file from %s\n), $name, $display, $0);
    print qq(Continue with installation [y/n]? );
    my $continueOnError = readResponse(1);
    unless ($continueOnError =~ /^y/i) {
        print( qq(!\n),
               qq(! Error(s) occurred during extraction. Error Count: $_ecount\n),
               qq(!\n) );
        die("\n");
    }
    return 1;
}

sub checkLicenseFile {
    my $extractor = shift;
    my $pid = shift;
    my $record = shift;

    my ($type, $name, $length, $offsetFromDS, $cksum, $feature, $versionEntity, $isProduct,
        $footprint, $sortcode, $class, $targetPath, $targetRank, $targetCksum) = split(/\|/, $record);

    my $dataStart = $class ? getMpClassInstanceHash()->{$class}->getDataStart() : getDataStart();
    my $offset = $dataStart+$offsetFromDS;
    my $maxbuffsize = 0xffffff;
    my $remainder = $length;
    my $readsize;
    my $handle = $class ? getMpClassInstanceHash()->{$class}->getDataFileHandle() : getDataFileHandle();

    my $pidSwitch = ( q(PID) eq $type ) ? qq(-project '$pid') : q();
    my $extractCmd = qq($extractor -toc -stdin $pidSwitch);

    my $procid;
    local(*EXTRACT_OUT, *EXTRACT_IN);
    eval {
        $SIG{PIPE} = q(IGNORE);
        $procid = IPC::Open2::open2( *EXTRACT_OUT, *EXTRACT_IN, $extractCmd );
        binmode EXTRACT_IN;
        seek($handle, $offset, 0); # find beginning of file in DATA.

        my $buf = q();
        while (0<($remainder-$maxbuffsize)) {
            $remainder-=$maxbuffsize;
            $readsize=$maxbuffsize;
            read($handle, $buf, $readsize, 0);
            print EXTRACT_IN $buf;
        }
        $readsize=$remainder;
        if ($readsize) {
            read($handle, $buf, $readsize, 0);
            print EXTRACT_IN $buf;
        }
        close EXTRACT_IN;
        $SIG{PIPE} = q(DEFAULT);
        1;
    }
    or do {
        my $e = $@;
        print $e;
    };

    my $extractOut = [<EXTRACT_OUT>]; close (EXTRACT_OUT);
    waitpid($procid, 0);
    my $extractErrCode = $? >> 8;

    print @$extractOut if( $_verbose );

    chomp @$extractOut;
    my $extractErrMsg = join( qq(\n), grep(/error/i, @$extractOut));

    return ( $extractErrCode, $extractErrMsg );
}


sub extractFile {
    my $extractor = shift;
    my $pid = shift;
    my $type = shift;
    my $name = shift;
    my $length = shift;
    my $offsetFromDS = shift;
    my $class = shift;
    my $ve = shift;

    my $dataStart = $class ? getMpClassInstanceHash()->{$class}->getDataStart() : getDataStart();
    my $offset = $dataStart+$offsetFromDS;
    my $maxbuffsize = 0xffffff;
    my $remainder = $length;
    my $readsize;
    my $handle = $class ? getMpClassInstanceHash()->{$class}->getDataFileHandle() : getDataFileHandle();

    my $pidSwitch = ( $pid ) ? qq(-project '$pid') : q();
    my $veSwitch = ( $ve ) ? qq(-ve '$ve') : q();

    my $procid;
    local(*EXTRACT_OUT, *EXTRACT_IN);
    eval {
        $SIG{PIPE} = q(IGNORE);
        $procid = IPC::Open2::open2( *EXTRACT_OUT, *EXTRACT_IN, qq($extractor -stdin $veSwitch $pidSwitch ));
        binmode EXTRACT_IN;
        seek($handle, $offset, 0); # find beginning of file in DATA.

        my $buf = q();
        while (0<($remainder-$maxbuffsize)) {
            $remainder-=$maxbuffsize;
            $readsize=$maxbuffsize;
            read($handle, $buf, $readsize, 0);
            print EXTRACT_IN $buf;
        }
        $readsize=$remainder;
        if ($readsize) {
            read($handle, $buf, $readsize, 0);
            print EXTRACT_IN $buf;
        }
        close EXTRACT_IN;
        $SIG{PIPE} = q(DEFAULT);
        1;
    }
    or do {
        my $e = $@;
        print $e;
    };

    my $extractOut = [<EXTRACT_OUT>]; close (EXTRACT_OUT);
    waitpid($procid, 0);
    my $extractErrCode = $? >> 8;

    print @$extractOut if( $_verbose );

    chomp @$extractOut;
    my $extractErrMsg = join( qq(\n), grep(/error/i, @$extractOut));

    return ( $extractErrCode, $extractErrMsg );
}

sub unbundleFile {
    my $indexRecord = shift;
    my $where = shift;

    my ($type, $name, $length, $offsetFromDS, $cksum, $feature, $versionEntity, $isProduct, $footprint, $sortcode, $class, @ignored) = split(/\|/, $indexRecord);

    my $dataStart = $class ? getMpClassInstanceHash()->{$class}->getDataStart() : getDataStart();
    my $offset = $dataStart+$offsetFromDS;
    my $maxbuffsize = 0xffffff;
    my $remainder = $length;
    my $readsize;
    my $handle = $class ? getMpClassInstanceHash()->{$class}->getDataFileHandle() : getDataFileHandle();

    mkDirectory(qq($where/$type));

    # Unbundle silently ignores and does not overwrite existing files.
    if ( ! -e qq($where/$type/$name) ) {
        print qq(Unbundling $where/$type/$name\n) if ( $_verbose );
        if ( open(OUTFILE, qq(>$where/$type/$name)) ) {
            binmode OUTFILE;
            seek($handle, $offset, 0); # find beginning of file relative to beginning of DATA handle.
            my $buf = q();
            while (0<($remainder-$maxbuffsize)) {
                $remainder-=$maxbuffsize;
                $readsize=$maxbuffsize;
                read($handle, $buf, $readsize, 0);
                print OUTFILE $buf;
            }
            $readsize=$remainder;
            if ($readsize) {
                read($handle, $buf, $readsize, 0);
                print OUTFILE $buf;
            }
            close OUTFILE;
        }
        else {
            printf qq(\nERROR:  Unable to unbundle "%s" from %s: %s), qq($where/$type/$name), File::Basename::basename($0), $!;
            die("\n");
        }
    }
    else {
        print qq(Skipping $where/$type/$name: file already exists.\n) if ( $_verbose );
    }
}

sub printHelpXmlSchema {
    print <<'EOH'
<?xml version="1.0" encoding="UTF-8"?>
  <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
    <xs:element name="check_license">
      <xs:complexType>
        <xs:sequence>
           <xs:element name="run_file_name" type="xs:string"></xs:element>
           <xs:element name="content_md5" type="xs:string"></xs:element>
           <xs:element name="product_md5" type="xs:string"></xs:element>
           <xs:choice>
             <xs:element name="unlicensed" type="xs:string"></xs:element>
             <xs:element name="archive" maxOccurs="unbounded">
               <xs:complexType>
                 <xs:sequence>
                   <xs:element name="name" type="xs:string"></xs:element>
                   <xs:element name="type" type="xs:string"></xs:element>
                   <xs:element name="feature" type="xs:string"></xs:element>
                   <xs:element name="pid" minOccurs="0" type="xs:string"></xs:element>
                   <xs:element name="message" type="xs:string"></xs:element>
                 </xs:sequence>
               </xs:complexType>
             </xs:element>
           </xs:choice>
         </xs:sequence>
       </xs:complexType>
     </xs:element>
   </xs:schema>
EOH
;
}

sub printHelp {
    my $run = File::Basename::basename($0);
    my $progDescription;
    my $dirDescription;
    if ( useDwh() ) {
        $progDescription
            = qq(The $run file is a self-extracting image that contains\n)
            . qq(a Synopsys DesignWare product.  Executing the $run\n)
            . qq(file without optional switches extracts (installs) the image to\n)
            . qq(a DESIGNWARE_HOME, if available, or to a specified directory.\n)
            ;

        $dirDescription
            = qq(Installs product into <path> instead of DESIGNWARE_HOME.\n);
    }
    else {
        $progDescription
            = qq(The $run file is a self-extracting image that contains\n)
            . qq(a Synopsys DesignWare product.\n)
            ;

        $dirDescription
            = qq(Installs product into <path>.\n);
    }

    print <<"EOH"
$progDescription

You can choose only one of the following optional switches:

--help

        Displays this message and exits.

--help-xml-schema

        Displays the XML Schema for the <check_license> element.

--readme

        Displays additional installation information, if available
        and exits.

--check-integrity

        Checks image integrity and exits.

--check-license <optional-output-path>

        Checks archive license(s) against SNPSLMD_LICENSE_FILE or
        LM_LICENSE_FILE and reports license configuration errors.
        Requests project-id if necessary. By default, an XML tagged
        report of the check is written to ./${run}_check_license.xml.
        An alternate output file specification may be selected by
        by specifying the <optional-output-path>. To write the XML
        to stdout set <optional-output-path> to a dash character
        ("-", ASCII value of 0x45). To suppress the XML, specify
        "no-xml-report" for the <optional-output-path>. Prepend
        the characters ">>" to <optional-output-path> to append
        the XML output to a file instead of overwriting the file.
        In all cases the <optional-output-path> file will be
        created if it does not exist. Use the --help-xml-schema
        switch to write the XML Schema to stdout.

--dir <path>

        $dirDescription

If you are doing an installation, you can optionally use either of the
following switches:

--keep-log

        Keeps the installer log file regardless of the error count.
        By default, the log is deleted when there are no errors.

--quiet

        Eliminates confirmation prompts.

EOH
;
}

sub help {
    dwHeader();
    printHelp();
    return 0;
}

sub helpXmlSchema {
    dwHeader();
    printHelpXmlSchema();
    return 0;
}

sub dwHeader {
    my $title = getTitle();
    $title =~ s/\n/\n#       /g;
    print <<"EndIntro"

#****************************************************************
#
#    Synopsys DesignWare Products Self-Extracting Download
#
#    This script extracts and installs into the given directory
#    files for the products included in:
#
#       $title
#
#    For help type:
#
#       $0 --help
#
#****************************************************************

EndIntro
;
}

sub dwReadme {
    my $fileToWrite = shift || q(/dev/null);
    my $suppressStdio = shift;

    my $readme = IO::File->new(qq(>$fileToWrite));
    if (! $readme ) {
        printf STDERR qq(ERROR: Unable to write README content to $fileToWrite: $!\n);
        $readme = undef;
    }

    my $readmeTee
        = ( $readme )
        ? Local::IO::Tee->new(\*STDOUT, $readme )
        : \*STDOUT;

    my $out =  $suppressStdio ? $readme : $readmeTee;
    print qq(\n);
    printf $out ( qq(%s), getReadmeText());

    $readme->close();
    return 1; # toggle to 0 if embedded readme content was supplied.
}

sub printReportStr {
    printWhatStrings();
    printf( qq(USE_DWH|%d\n), useDwh());
    printf( qq(EXPORT_CONTROLLED|%d\n), isExportControlled());
    printf( qq(TITLE|%s\n), getTitle());
    printf( qq(CONTENT_MD5|%s\n), getContentMD5());
    printf( qq(PRODUCT_MD5|%s\n), getProductMD5());
    printFileIndexFieldsStr();
    printFileIndexStr();
    return 0;
}

sub printWhatStrings {
    if ( open( THISFILE, $0 )) {
        my $count = 0;
        while ($count < 5) {
            my $line = <THISFILE>;
            if ( $line =~ /\@\(\#\)(.*?)$/ ) {
                my $record = $1;
                $record =~ s/^\s*//;
                chomp $record;
                print("WHAT|$record\n");
            }
            $count++;
        }
        close( THISFILE );
    }
    return 0;
}

sub getContentMD5 {
    my $fileIndex = getFileIndex();
    my $contentRecords = [ sort grep(/^(PID|LIC|OPN)\|/, @$fileIndex) ];
    my $ctx = Digest::MD5->new();
    foreach my $record ( @$contentRecords ) {
        my ($type, $file, $size, $offset, $cksum, $feature, $ve, $isProduct, $footprint,
            $sortcode, $class, $targetPath, $targetRank) = split(/\|/, $record);
        $ctx->add($cksum);
    }
    my $md5 = $ctx->hexdigest();
    return $md5;
}

sub getProductMD5 {
    my $fileIndex = getFileIndex();
    my $contentRecords = [ sort grep(/^(PID|LIC|OPN)\|/, @$fileIndex) ];
    my $ctx = Digest::MD5->new();
    foreach my $record ( @$contentRecords ) {
        my ($type, $file, $size, $offset, $cksum, $feature, $ve, $isProduct, $footprint,
            $sortcode, $class, $targetPath, $targetRank) = split(/\|/, $record);
        unless( $file =~ /^OPN_00_dwre/ && $ve =~ /^\.\/bin\// ) {
           $ctx->add($cksum);
        }
    }
    my $md5 = $ctx->hexdigest();
    return $md5;
}

sub printFileIndexStr {
    printf qq(%s\n), join( qq(\n), @{getFileIndex()} );
    return 0;
}

sub printPidFeatureCount {
    my $featureList = getPidFeatureListByIndexOrder();
    my $featureCount = scalar @$featureList;
    printf( qq(FEATURE_COUNT=%d\n), $featureCount );
    return 0;
}

sub printVeTocStr {
    if ( useDwh() ) {
        print qq(DEPRECATED SWITCH: No embedded TOC file.\n);
    }
    return 0;
}

sub printDepends {
    my $fileIndex = getFileIndex();
    my $depends = {};
    my $typeExtensionMap = {
        q(OPN) => q(.pm),
        q(LIC) => q(.pm),
        q(PID) => q(.pm),
    };

    $depends->{basename($0)}++;
    foreach my $record ( @$fileIndex ) {
        my ($type, $file, $size, $offset, $cksum, $feature, $ve, $isProduct, $footprint,
            $sortcode, $class, $targetPath, $targetRank) = split(/\|/, $record);
        my $dependency = sprintf(qq(%s%s), $class, $typeExtensionMap->{$type}||q());
        $depends->{$dependency}++ if ($class);
    }
    printf qq(%s\n), join qq(\n), sort keys %$depends;
    return 0;
}

sub getInstallSize {
    my $dwxOnly = shift;
    my $installSize;
    if ( $dwxOnly ) {
        map {$installSize+=(split(/\|/))[8]} grep(/^DWX\|/, @{getFileIndex()});
    }
    else {
        map {$installSize+=(split(/\|/))[8]} @{getFileIndex()};
    }
    return $installSize;
}

sub dwInstallType {
    my $pidCount = grep( /^PID\|/, @{getFileIndex()} );
    my $licCount = grep( /^LIC\|/, @{getFileIndex()} );
    my $opnCount = grep( /^OPN\|/, @{getFileIndex()} );
    my $type = (($opnCount+$licCount>0)?1:0) + (($pidCount>0)?2:0);
    return $type;
}

sub getPidFeatureListByIndexOrder {
    my $featureRank = {};
    my $rank = 0;
    foreach my $rec ( grep(/^PID\|/, @{getFileIndex()} )) {
        my ($nil, $pName, $feature);
        ($nil, $pName, $nil, $nil, $nil, $feature, $nil, $nil, $nil, $nil, $nil, $nil, $nil, $nil) = split(/\|/, $rec);
        $featureRank->{$feature} = $rank++ unless ( defined $featureRank->{$feature} );
    }
    $featureRank =  {reverse %$featureRank};
    my $featureList = [];
    foreach my $val ( sort keys %$featureRank ) {
        push( @$featureList, $featureRank->{$val});
    }
    return $featureList;
}

sub isMixedProduct {
    # A given product has a mix of PID, LIC and OPN parts.
    my $productTypeMap = dwProductTypeMap();
    my $scalarProduct = 1;
    map { $scalarProduct *= scalar(@{$_}); } values %$productTypeMap;
    return ( 1 < $scalarProduct );
}

sub dwProductTypeMap {
    my $productTypeMap = {};
    foreach my $rec ( grep( !/^DWX\|/, @{getFileIndex()} )) {
        my ($type, $pName, @ignored);
        ($type, $pName, @ignored) = split(/\|/, $rec);
        # strip extraction type, index and rank from pname.
        $pName =~ s/^(PID|LIC|OPN)(_[0-9]{2}){0,1}_//;
        $pName =~ s/^_[0-9]+//;
        push( @{$productTypeMap->{$pName}}, $type );
    }
    return $productTypeMap;
}

sub execPostInstall {
    my $downloadDir = shift;
    my $installDir = shift;

    my $cmd = getPostInstallInvocation();

    my $errorCode = 0;
    if ( $cmd ) {
        $cmd =~ s/__INSTALL_DIR__/$installDir/g;
        print qq(\n) . (qx($cmd)||q());
        $errorCode = $? >> 8;
    }
    return $errorCode;
}

sub requireMultiPartClasses {
    my $downloadDir = shift;
    my $hash = {};
    my $missingClassPmFiles = [];
    my $mpClassList = getMultiPartClassList();
    foreach my $class ( @$mpClassList ) {
        my $classPmFile = qq($downloadDir/$class.pm);
        if ( -e $classPmFile ) {
            require $classPmFile;
            $hash->{$class} = $class->new();
        }
        else {
            push( @$missingClassPmFiles, $classPmFile );
        }
    }
    if ( scalar @$missingClassPmFiles ) {
        printf( qq(ERROR: Missing ".pm" %s for this ".run" image:\n\n   %s\n\n)
                . qq(This image depends on the following ".pm" %s:\n\n   %s\n\n)
                . qq(The ".run" and ".pm" %s must reside in the same directory.\n),
                (1 == scalar(@$mpClassList)) ? q(file) : q(files),
                join( qq(\n   ), @$missingClassPmFiles),
                (1 == scalar(@$mpClassList)) ? q(file) : q(files),
                join( qq(\n   ), (map { qq($_.pm) } @$mpClassList) ),
                (1 == scalar(@$mpClassList)) ? q(file) : q(files)
                );
        die("\n");
    }
    return $hash
}

sub getMpClassInstanceHash {
    return $_mpClassInstanceHash;
}

sub getFileIndex {
    my $unsortedIndex;
    push( @$unsortedIndex, @{getLocalFileIndex()} );
    foreach my $instance ( values %{getMpClassInstanceHash()} ) {
        push( @$unsortedIndex, @{$instance->getLocalFileIndex()} );
    }
    my $sortedIndex = [];
    push(@$sortedIndex, sort(grep(/^DWX/, @$unsortedIndex)));
    push(@$sortedIndex, sort(grep(/^PID/, @$unsortedIndex)));
    push(@$sortedIndex, sort(grep(/^LIC/, @$unsortedIndex)));
    push(@$sortedIndex, sort(grep(/^OPN/, @$unsortedIndex)));
    return $sortedIndex;
}
#
# GENERATED CODE FOLLOWS
#

sub printFileIndexFieldsStr {
    print qq(IDX|file|size|offset|cksum|feature|ve|isproduct|footprint|sortcode|class|targetpath|targetrank|targetcksum\n);
    return 0;
}

sub hasReadme {
    return 1;
}

sub getReadmeText {
return <<'EOREADME'
****************************************************
* DWC Mobile Storage CTest Sample Software         *
* For Designware DWC MSHC IP                       *
*     Version 1.0 - 08/2020                        *
****************************************************


Refer to the README for more details                
EOREADME
;
}

sub isExportControlled {
    return 0;
}

sub useDwh {
    return 0;
}

sub getTitle {
    return q(Mobile Storage CTest Sample Software);
}

sub getMultiPartClassList {
    return [
        
        ];
}

sub getLocalFileIndex {
    return [
        q(DWX|dw_extract.tgz|3036689|0|3927110528|||0|7.464476||||0|),
        q(PID|dwc_mshc_ctest_sw_sample.zip|996215|3036689|2413492679|DWC-MSHC-LITE DWC-MSHC-SRC DWC-MSHC-CRYPTO||1|1.758454||||0|)
        ];
}

sub getPostInstallName {
    return q();
}

sub getPostInstallInvocation {
    return q();
}

