menu "Multicore"
	config SUPPORT_MULTICORE
		bool "Enable multicore"
		default n

	config MULTICORE_TEST
		depends on SUPPORT_MULTICORE && DRIVER_TEST
		bool "Enable multicore test"
		default n

	config CPU_HOTPLUG
		depends on SUPPORT_MULTICORE && SOC_SMP
		bool "Enable CPU Hotplug"
		default y

	config CPU_HOTPLUG_BOOT_OFFLINE
		depends on CPU_HOTPLUG
		bool "Keep secondary hotplug CPU offline at power-on (online via cpu online <id>)"
		default n

	config CPU_HP_VOTE
		depends on CPU_HOTPLUG
		bool "Enable CPU hotplug voting layer"
		default n

	if CPU_HP_VOTE

		config CPU_HP_VOTE_MAX_VOTERS
			int "Maximum number of concurrently registered voters"
			default 64

		config CPU_HP_VOTE_DUMP
			bool "Enable bk_cpu_hp_vote_dump() per-voter listing"
			default y

		config CPU_HP_VOTE_NAME
			bool "Record a name string for each voter (find-by-name and dump labels)"
			default n

		config CPU_HP_VOTE_NAME_LEN
			depends on CPU_HP_VOTE_NAME
			int "Maximum length of voter name string"
			default 16

		config CPU_HP_VOTE_FIND
			depends on CPU_HP_VOTE_NAME && CPU_HP_VOTE_DUMP
			bool "Enable bk_cpu_hp_vote_find() (look up a voter by name)"
			default n

		config CPU_HP_VOTE_STATIC
			bool "Allocate voter handles from a static pool (no malloc)"
			default n

	endif

	config CPU_HP_GOVERNOR
		depends on CPU_HOTPLUG
		bool "Enable dynamic CPU load governor (auto online/offline CP1)"
		default n

	if CPU_HP_GOVERNOR

		config CPU_HP_GOVERNOR_AUTOSTART
			bool "Start auto-adjust immediately at boot"
			default y

		config CPU_HP_GOVERNOR_UP_THRESHOLD
			int "CP0 load%% above which CP1 is brought online"
			default 80

		config CPU_HP_GOVERNOR_DOWN_THRESHOLD
			int "Combined CP0+CP1 load%% below which CP1 is taken offline"
			default 60

		config CPU_HP_GOVERNOR_LOAD_EMA_DIV
			int "Load EMA divisor (default: 100% weight)"
			default 1
			help
				if value is 2, the current load is 50%(1/2) weight
				if value is 4, the current load is 25%(1/4) weight

		config CPU_HP_GOVERNOR_PERIOD_MS
			int "Load sampling period (ms)"
			default 100

		config CPU_HP_GOVERNOR_UP_DEBOUNCE
			int "Consecutive overloaded samples required to online AP1"
			default 2

		config CPU_HP_GOVERNOR_DOWN_DEBOUNCE
			int "Consecutive underloaded samples required to offline AP1"
			default 5

		config CPU_HP_GOVERNOR_COOLDOWN_MS
			int "Minimum dwell time after a transition (ms)"
			default 1000
	
	endif

endmenu
