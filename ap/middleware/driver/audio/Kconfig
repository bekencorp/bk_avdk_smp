menu "AUDIO"

	config AUDIO
		bool "Enable Audio"
		default n

	choice AUD_DRIVER_VERSION
		prompt "AUD driver version"
		depends on AUDIO
		default AUD_DRIVER_V2
		help
			Select AUD (audio driver) implementation: V1 or V2.

		config AUD_DRIVER_V1
			bool "AUD driver V1"

		config AUD_DRIVER_V2
			bool "AUD driver V2"
	endchoice

	config AUDIO_ADC
		depends on AUDIO
		bool "Enable audio adc driver"
		default n

	config AUDIO_DAC
		depends on AUDIO
		bool "Enable audio dac driver"
		default n

	config AUD_DAC_DRC
		depends on AUDIO_DAC && AUD_DRIVER_V2
		bool "Enable DAC A2DP-path hardware DRC"
		default n
		help
			Compile DAC hardware DRC support (k/p/st register programming).
			HW DRC applies only to the A2DP source path
			(Resample → EQ → DRC); CALL/HINT bypass DRC and mix later.
			Init preset is selected by aud_dac_config_t.a2dp_drc_preset,
			not by Kconfig. Runtime switch: bk_aud_dac_drc_apply_preset().

	config AUDIO_DMIC
		depends on AUD_DRIVER_V1
		bool "Enable audio dmic driver"
		default n

	config AUDIO_DTMF
		depends on AUD_DRIVER_V1
		bool "Enable audio dtmf driver"
		default n

	config AUDIO_RING_BUFF
		bool "Enable Audio Ring Buff"
		default y
		help
			Enable Audio ring buffer

	choice AUD_PM_FAST_MODE
		prompt "Audio recovery mode after AP fast boot"
		depends on AUDIO && PM_AP_FAST_BOOT_ENABLE
		optional
		help
			Cold and hot recovery cannot share the same service
			callbacks. Leave unselected if audio does not participate
			in AP fast boot.

		config AUD_PM_FAST_COLD
			bool "Cold start (service init/deinit)"
			help
				On AP off, each audio service deinit. After fast
				boot, the same service init+start with retained
				config. AUD register backup/restore is not used.

		config AUD_PM_FAST_HOT
			bool "Hot start (register backup/restore + open/close)"
			help
				Keep service objects, backup/restore AUD
				registers, then open. Mutually exclusive with
				cold start.
	endchoice
endmenu
