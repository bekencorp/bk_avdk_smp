menu "MAILBOX"
	config MAILBOX
		bool "Enable mail_box"
		default n

	config MAILBOX_V2_0
		bool "Use mailbox v2.0 driver"
		default n

	config MAILBOX_IPC
		bool "Enable mailbox socket ipc driver"
		default y

	config IPC_STRESS_TEST
		depends on MAILBOX_IPC
		bool "Enable cross-core IPC stress test CLI (AP side)"
		default n
		help
			Build the AP-side IPC stress clients and auto-register the
			"ipc_stress" CLI command (via DRV_CLI_CMD_EXPORT). Pairs with the
			CP-side echo server to verify cross-core mailbox IPC under load.

	config MAILBOX_IPC_API_TASK_STACK_SIZE
		int "Set MAILBOX IPC API Task Stack Size"
		default 2048
		help
			Stack size of MAILBOX IPC API Task

	config MAILBOX_IPC_DATA_POOL_NUM
		depends on MAILBOX_IPC
		int "MAILBOX IPC data object pool size"
		default 8
		help
			Number of pre-allocated bk_ipc_data_t objects served from the IPC
			send object pool instead of the heap. Sends that exceed the pool
			temporarily fall back to os_malloc, so raising this only reduces
			heap traffic under concurrent/burst sends.

	config MAILBOX_IPC_SYNC_TIMEOUT_MS
		depends on MAILBOX_IPC
		int "MAILBOX synchronous IPC send timeout (ms)"
		default 2000
		help
			Bounded wait for a synchronous IPC send to receive its ACK from the
			peer core. On timeout the send returns an error instead of blocking
			forever; the request object is safely reclaimed if a late ACK
			arrives. Set smaller for faster caller recovery.

    config SLAVE_HEART_BEAT
		depends on MAILBOX
		bool "Enable heartbeat mechanism when dual core communication"
		default n

	config SLAVE_HEART_BEAT_USE_IPI
		depends on SLAVE_HEART_BEAT && IPI
		bool "Use IPI for heartbeat transport"
		default y
		help
			Send heartbeat notifications through IPI_DOMAIN_HEARTBEAT instead of mailbox.
endmenu
