menu "SDCARD"
	config SDCARD
		bool "Enable SDCARD"
		default y

	config SDCARD_HOST_ID
		int "SDIO host controller the SD card is wired to (0=SDIO0, 1=SDIO1)"
		depends on SDCARD
		default 0
		help
		  Single source of truth for which of the two BK7259 SDIO host
		  controllers the SD card is connected to. 0 = SDIO0
		  (GPIO2/3/4/5/10/11), 1 = SDIO1 (GPIO14~23). Applied at runtime via
		  the generic bk_sdio_host_*() API. Boards wiring the SD card to
		  SDIO1 (e.g. BK7259 Robot V1 AI kit) should set this to 1.

	config SDCARD_BUSWIDTH_4LINE
		bool "Use 4-bit SD data bus (default is 1-bit)"
		depends on SDCARD
		default n
		help
		  Master switch for the SD data bus width. Default (n) keeps the
		  proven 1-bit bus. Set y to switch the card and the SDIO controller
		  to 4-bit (DAT0~DAT3) after enumeration for ~4x data throughput.

		  Requirements when enabling:
		    - all four data lines (DATA0~DATA3), CLK and CMD must be muxed
		      for the chosen SDIO group in the board usr_gpio_cfg.h;
		    - DAT3 is temporarily forced high by the SD card driver during
		      the CMD0/CMD8 identification window, then restored to the SDIO
		      DATA3 function before the 4-bit switch.

	config SDCARD_HIGH_SPEED
		bool "Enable SD High Speed mode (CMD6, 3.3V)"
		depends on SDCARD
		default n
		help
		  Switch the card to SD High Speed after identification (CMD6
		  access mode 1) and set the host HIGH_SPEED_EN / SDR25
		  sampling path. This is classic 3.3V High Speed, not UHS-I;
		  it does not require 1.8V signaling or tuning.

		  Default (n) keeps Default Speed. When enabled, the transfer
		  clock range is raised to 50MHz and defaults to 40MHz (the
		  highest 80MHz-base integer divide that stays within the
		  50MHz High Speed limit). If the card rejects CMD6 the
		  driver falls back to Default Speed.

	config SDCARD_CLOCK_FREQ_HZ
		int "SD card transfer clock frequency in Hz"
		depends on SDCARD
		default 40000000 if SDCARD_HIGH_SPEED
		default 20000000
		range 400000 50000000 if SDCARD_HIGH_SPEED
		range 400000 25000000 if !SDCARD_HIGH_SPEED
		help
		  SD data-transfer clock after card identification, passed to
		  bk_sdio_host_set_clock(). Identification still runs at the
		  host's low init clock (~400kHz).

		  Without High Speed the range is 400kHz-25MHz (Default
		  Speed; default 20MHz). With CONFIG_SDCARD_HIGH_SPEED the
		  range is 400kHz-50MHz (default 40MHz). Lower values can be
		  used on boards with marginal SDIO signal integrity.

	config SDCARD_MAX_BLOCKS_PER_XFER
		int "Max blocks per CMD18 transfer (0=unlimited)"
		depends on SDCARD
		default 0
		range 0 256
		help
		  Split large FATFS disk_read requests into smaller CMD18
		  multi-block transfers. 0 keeps a single CMD18 with the full
		  block count from the caller.

		  On boards with marginal SDIO signal integrity, long
		  multi-block PIO reads are more prone to DATA_END_BIT_ERR.
		  Set a small value (e.g. 4) in the board defconfig as a
		  software workaround until the PCB/SI is improved.

	config SDCARD_CHECK_INSERTION_EN
		bool "Whether to use pin to determine whether the sdcard is connected"
		default n

	menu "Card Detect GPIO"
		depends on SDCARD_CHECK_INSERTION_EN

		config SDCARD_CHECK_INSERTION_GPIO_ID
			int "Detect whether to connect the GPIO ID of the sdcard"
			default 0
	endmenu

	config SDCARD_POWER_GPIO_CTRL
		depends on SDCARD
		bool "Enable SDcard power gpio ctrl"
		default n

    config SDCARD_POWER_GPIO_CTRL_AUTO_POWERDOWN_WHEN_IDLE
        depends on SDCARD_POWER_GPIO_CTRL
        bool "Enable SDcard auto powerdown when idle"
        default n

	config SDCARD_DEBUG_SUPPORT
		bool "Enable SDcard debug"
		default n
		help
			enable SDCARD debug, it will dump write and read data with SDCARD
endmenu
