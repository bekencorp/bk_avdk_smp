menu "IPI"
	config IPI
		bool "Enable IPI (Inter-Processor Interrupt)"
		default y
		help
			Enable IPI driver for inter-core communication.
			IPI allows different CPU cores to send interrupts to each other.

	config IPI_TEST
		depends on IPI && DRIVER_TEST
		bool "Enable IPI test"
		default n
		help
			Enable IPI driver test cases.

	config IPI_DUMP
		depends on IPI
		bool "Enable IPI dump (code size increases)"
		default n
		help
			Enable bk_ipi_dump_info() detailed dump output.
			Disable it for smaller code size.
endmenu

