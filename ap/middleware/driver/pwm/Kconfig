menu "PWM"
	config PWM
		bool "Enable pwm"
		default n

	config PWM_PM_CB_SUPPORT
		bool "PWM PM Support"
		default n

	config PWM_PHASE_SHIFT
		bool "PWM phase shift Support"
		default n

	config PWM_FADE
		bool "PWM fade mode support"
		default n

	config PWM_TEST
		depends on PWM && DRIVER_TEST
		bool "Enable pwm test"
		default y

	config PWM_AUTO
		depends on PWM && DRIVER_TEST
		bool "Enable pwm automatic loopback test"
		default n
		help
			Enable the PWM automatic loopback CLI test.
			The platform wiring is PWM2 (GPIO32) to PWM4 (GPIO34)
			and PWM3 (GPIO33) to PWM5 (GPIO35).

endmenu

