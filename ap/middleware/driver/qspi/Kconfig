menu "QSPI"
	config QSPI
		bool "Enable QSPI"
		default n

	config QSPI_STATIS
		bool "Enable QSPI Statis"
		default n

	config QSPI_MST_PSRAM
		bool "Enable QSPI PSRAM"
		depends on QSPI
		default n

	choice
		prompt "QSPI Flash type"
		optional
		depends on QSPI
		help
			Select NOR or NAND for the QSPI master flash. They are mutually
			exclusive; leave unselected if QSPI flash is not used.
			NOR and NAND share the same bk_qspi_flash_* API and only one driver
			is linked at a time. If both are force-enabled outside this choice,
			NAND takes precedence.

		config QSPI_NOR_FLASH
			bool "Enable QSPI NOR Flash"
			help
				BEKEN Chip sets QSPI interface as a master device, the slave device is a NOR flash,
				then BEKEN Chip can access the flash with QSPI interface.
				The application can read/writes data to flash directly by QSPI Flash API,
				or reads/writes by file system API if enable relates macro, I.E. CONFIG_FATFS, CONFIG_LITTLEFS, CONFIG_VFS...

		config QSPI_NAND_FLASH
			bool "Enable QSPI NAND Flash"
	endchoice

	config QSPI_NOR_FLASH_SIZE
		hex "NOR Flash Size (Bytes)"
		depends on QSPI_NOR_FLASH
		default 0x1000000
		help
			Fallback total size of the SPI NOR Flash in bytes, used only when
			Read ID (9Fh) returns a part not present in the descriptor registry.
			Identified parts report their real capacity via
			bk_qspi_flash_nor_total_size(). Default is 16MB (0x1000000).

	config QSPI_NOR_ALLOW_UNKNOWN
		bool "Allow unidentified SPI NOR to continue init"
		depends on QSPI_NOR_FLASH
		default y
		help
			When set, an unidentified SPI NOR (JEDEC ID not in the descriptor
			registry) still initialises using a generic default descriptor and
			the QSPI_NOR_FLASH_SIZE fallback capacity. Convenient while bringing
			up a new part. Production configs should set this to n so an unknown
			part fails init instead of running with possibly wrong command set,
			protection bits or capacity.

	config QSPI_NAND_FLASH_SIZE
		hex "NAND Flash Size (Bytes)"
		depends on QSPI_NAND_FLASH
		default 0x8000000
		help
			Fallback total size of the SPI NAND Flash in bytes, used only when
			Read ID (9Fh) returns a part not present in the descriptor registry.
			Identified parts report their real capacity via
			bk_qspi_flash_nand_total_size(). Default is 128MB (0x8000000).

	config QSPI_NAND_ALLOW_UNKNOWN
		bool "Allow unidentified SPI NAND to continue init"
		depends on QSPI_NAND_FLASH
		default y
		help
			When set, an unidentified SPI NAND (JEDEC ID not in the descriptor
			registry) still initialises using a generic default descriptor and
			the QSPI_NAND_FLASH_SIZE fallback capacity. Convenient while bringing
			up a new part. Production configs should set this to n so an unknown
			part fails init instead of running with a possibly wrong capacity,
			protection bit or ECC semantics.

	config QSPI_TEST
		depends on QSPI && DRIVER_TEST
		bool "Enable qspi test"
		default n

	config QSPI_LINE_MODE
		int "qspi line mode choose"
		range 1 8
		default 4
		help
		The value should be changed if need to change qspi line mode
endmenu

