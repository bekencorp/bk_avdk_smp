menu "QSPI"
	config QSPI
		bool "Enable QSPI"
		default n

	config QSPI_STATIS
		bool "Enable QSPI Statis"
		default y

	config QSPI_0_MST_FLASH
		bool "QSPI-0 MST Flash"
		default n
		help
			BEKEN Chip sets QSPI-0 interface as a master device, the slave device is a flash,
			then BEKEN Chip can access the flash with QSPI interface.
			The application can read/writes data to flash directly by QSPI Flash API,
			or reads/writes by file system API if enable relates macro, I.E. CONFIG_FATFS, CONFIG_LITTLEFS, CONFIG_VFS...

	config QSPI_1_MST_FLASH
		bool "QSPI-1 MST Flash"
		default n
		help
			BEKEN Chip sets QSPI-1 interface as a master device, the slave device is a flash,
			then BEKEN Chip can access the flash with QSPI interface.
			The application can read/writes data to flash directly by QSPI Flash API,
			or reads/writes by file system API if enable relates macro, I.E. CONFIG_FATFS, CONFIG_LITTLEFS, CONFIG_VFS...

	config QSPI_FLASH_GD
		bool "Enable GD Flash"
		default n
endmenu

