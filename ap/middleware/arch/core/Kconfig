menu "Arch::Core"
	choice CORE_TYPE
		prompt "Select Processor/Core"
		default ARM_CORE_STAR
		help
			Select the CPU core architecture used by this SoC target. The value
			is normally fixed by the target defconfig and should match SOC_ARCH.

		config ARM_CORE_STAR
			bool "armstar"

		config ARM_CORE_CM52
			bool "Cortex M52"

		config ARM_CORE_CM55
			bool "ARM_CORE_CM55"
	endchoice

	config ARM_INTERRUPT_CONTROLLER_CNT
		int "Interrupt controller count"
		default 1
		help
			Number of interrupt controller instances used by the architecture
			layer. This is a platform value and normally should not be changed
			by application projects.
endmenu
